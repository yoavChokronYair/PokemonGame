    fk.&quot;table&quot; AS parent_table,
    m.name AS child_table,
    fk.&quot;from&quot; AS child_column,
    fk.&quot;to&quot; AS parent_column
FROM sqlite_master m
JOIN pragma_foreign_key_list(m.name) fk
WHERE m.type = 'table'
ORDER BY parent_table, child_table;
</sql><sql name="check row data with foregin key">SELECT 
    p.PokemonID,
    p.SpeciesName,

    -- Base Stats
    bs.HP, bs.Attack, bs.Defense, bs.SpAttack, bs.SpDefense, bs.Speed,
    bs.Type1, bs.Type2, bs.CatchRate, bs.EggCycles, bs.BaseFriendship,
    bs.GenderRatio, bs.GrowthRate, bs.BaseEXPYield, bs.EggGroup1, bs.EggGroup2,
    a1.AbilityName AS Ability1Name,
    a2.AbilityName AS Ability2Name,
    ah.AbilityName AS AbilityHName,
    bs.FleeRate, bs.Weight,

    -- Forms
    pf.FormName AS Form,

    -- Evolution
    e.BabySpeciesName AS PreEvolution,
    e.Method AS EvolutionMethod,
    e.LevelRequired AS EvolutionLevel,

    -- LevelUp Moves
    lum.Level AS MoveLevel,
    m.MoveName AS MoveName,
    m.Type AS MoveType,
    m.Category AS MoveCategory,
    m.MovePower, m.MoveAccuracy,

    -- Egg Moves
    em.MoveID AS EggMoveID

FROM Pokemon p

-- BaseStats
LEFT JOIN BaseStats bs ON bs.PokemonID = p.PokemonID

-- Abilities
LEFT JOIN Ability a1 ON a1.AbilityID = bs.Ability1ID
LEFT JOIN Ability a2 ON a2.AbilityID = bs.Ability2ID
LEFT JOIN Ability ah ON ah.AbilityID = bs.AbilityHID

-- Forms
LEFT JOIN PokemonForm pf ON pf.PokemonID = p.PokemonID

-- Evolution
LEFT JOIN Evolution e ON e.SpeciesName = p.SpeciesName

-- LevelUpMoves
LEFT JOIN LevelUpMove lum ON lum.PokemonID = p.PokemonID
LEFT JOIN Move m ON m.MoveID = lum.MoveID

-- EggMoves
LEFT JOIN EggMove em ON em.PokemonID = p.PokemonID
</sql><sql name="SQL 5">-- ============================================================
-- Pokemon Game Model - SQLite Schema
-- ============================================================
-- Re-runnable: each section drops then recreates its tables.
-- Drop order is child -&gt; parent to respect foreign key constraints.
-- ============================================================

PRAGMA foreign_keys = ON;

-- ============================================================
-- DROP ALL  (children before parents)
-- ============================================================
--
-- Dependency graph:
--   cascade_steps      → attempts
--   attempts           → moves, effects, numbers
--   sequence_steps     → effects
--   multi_stat_changes → effects
--   effects            → numbers, conditions
--   weighted_entries   → numbers
--
-- Therefore full drop order:
--   cascade_steps → attempts → moves
--   sequence_steps, multi_stat_changes → effects → conditions
--                                                → numbers ← weighted_entries
-- ============================================================

DROP TABLE IF EXISTS cascade_steps;
DROP TABLE IF EXISTS attempts;
DROP TABLE IF EXISTS moves;
DROP TABLE IF EXISTS sequence_steps;
DROP TABLE IF EXISTS multi_stat_changes;
DROP TABLE IF EXISTS effects;
DROP TABLE IF EXISTS conditions;
DROP TABLE IF EXISTS weighted_entries;
DROP TABLE IF EXISTS numbers;

-- ============================================================
-- MOVES
-- ============================================================

CREATE TABLE moves (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    name        TEXT    NOT NULL UNIQUE,
    element     TEXT    NOT NULL,                       -- PokemonType enum
    category    TEXT    NOT NULL,                       -- Physical / Special / Status
    target      TEXT    NOT NULL DEFAULT 'Opponent',    -- MoveTarget enum
    pp          INTEGER NOT NULL,
    priority    INTEGER NOT NULL DEFAULT 0,             -- +1 Quick Attack, -1 Vital Throw, etc.
    crit_stage  INTEGER NOT NULL DEFAULT 0,             -- 0 normal, 1 high crit (Slash, Razor Leaf)
    description TEXT
);

-- ============================================================
-- NUMBERS  (INumber expression tree)
-- ============================================================

CREATE TABLE numbers (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    type            TEXT    NOT NULL,   -- Exactly / Between / Weighted
                                        -- Product / Sum / Quotient
                                        -- MaxHP / CurrentHP / Level / LastDamageDealt
    exact_value     REAL,               -- Exactly
    range_min       REAL,               -- Between
    range_max       REAL,               -- Between
    left_number_id  INTEGER REFERENCES numbers(id),     -- Product / Sum / Quotient
    right_number_id INTEGER REFERENCES numbers(id),     -- Product / Sum / Quotient
    target          TEXT                -- MaxHP / CurrentHP / Level / LastDamageDealt
                                        --   values: Attacker / Defender
);

CREATE TABLE weighted_entries (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    number_id   INTEGER NOT NULL REFERENCES numbers(id) ON DELETE CASCADE,
    value       REAL    NOT NULL,
    weight      REAL    NOT NULL
);

-- ============================================================
-- CONDITIONS  (ICondition expression tree)
-- ============================================================

CREATE TABLE conditions (
    id                  INTEGER PRIMARY KEY AUTOINCREMENT,
    type                TEXT    NOT NULL,   -- Probability / IsWeatherActive
                                            -- HasStatus / HasVolatile / IsFainted
                                            -- IsFullHP / HPBelow / HasType
                                            -- UserCondition / OpponentCondition
                                            -- And / Or / Not
    probability         REAL,               -- Probability
    weather             TEXT,               -- IsWeatherActive:  Weather enum
    status              TEXT,               -- HasStatus:        StatusCondition enum
    volatile_status     TEXT,               -- HasVolatile:      VolatileStatus enum
    hp_fraction         REAL,               -- HPBelow
    pokemon_type        TEXT,               -- HasType:          PokemonType enum
    left_condition_id   INTEGER REFERENCES conditions(id),  -- And / Or
    right_condition_id  INTEGER REFERENCES conditions(id),  -- And / Or
    inner_condition_id  INTEGER REFERENCES conditions(id)   -- Not / UserCondition / OpponentCondition
);

-- ============================================================
-- EFFECTS  (IEffect command nodes)
-- ============================================================

CREATE TABLE effects (
    id                  INTEGER PRIMARY KEY AUTOINCREMENT,
    type                TEXT    NOT NULL,   -- FormulaDamage / DirectDamage / CrashDamage / Recoil / Drain / OHKO
                                            -- RestoreHP / Faint
                                            -- Paralyze / Burn / Poison / Sleep / Freeze / Confuse / Flinch
                                            -- StatChange / MultiStatChange / ResetStats
                                            -- SetWeather / SetScreen / SetHazard
                                            -- ForceSwitch / CureStatus / CopyLastMove / StoreAndRelease
                                            -- Sequence / Chance / Conditional / NoEffect

    -- Shared -------------------------------------------------------
    target              TEXT,               -- Attacker / Defender (primary target)

    -- Damage / Healing ---------------------------------------------
    number_id           INTEGER REFERENCES numbers(id),     -- FormulaDamage / DirectDamage / CrashDamage
                                                            -- Recoil / RestoreHP / Drain amount
    heal_target         TEXT,               -- Drain only: target receiving the heal (Attacker / Defender)

    -- Chance -------------------------------------------------------
    chance_probability  REAL,               -- Chance: roll threshold (e.g. 0.10)
    child_effect_id     INTEGER REFERENCES effects(id),     -- Chance: the wrapped effect

    -- Conditional --------------------------------------------------
    condition_id        INTEGER REFERENCES conditions(id),  -- Conditional: the condition to check
    on_pass_effect_id   INTEGER REFERENCES effects(id),     -- Conditional: effect when condition passes
    on_fail_effect_id   INTEGER REFERENCES effects(id),     -- Conditional: effect when condition fails (nullable)

    -- StatChange ---------------------------------------------------
    stat                TEXT,               -- Stat enum: Attack / Defense / Speed / etc.
    stat_stages         INTEGER,            -- e.g. +2 / -1

    -- Sleep --------------------------------------------------------
    sleep_min_turns     INTEGER,
    sleep_max_turns     INTEGER,

    -- Confuse ------------------------------------------------------
    confuse_min_turns   INTEGER,
    confuse_max_turns   INTEGER,

    -- Poison -------------------------------------------------------
    is_toxic            INTEGER DEFAULT 0,  -- 0 = regular Poison, 1 = Toxic

    -- Field effects ------------------------------------------------
    weather             TEXT,               -- SetWeather:  Weather enum
    weather_turns       INTEGER,            -- SetWeather:  duration
    screen              TEXT,               -- SetScreen:   Screen enum
    screen_turns        INTEGER,            -- SetScreen:   duration
    battle_side         TEXT,               -- SetScreen / SetHazard: BattleSide enum
    hazard              TEXT,               -- SetHazard:   Hazard enum

    -- StoreAndRelease (Bide) ---------------------------------------
    charge_turns        INTEGER
);

CREATE TABLE sequence_steps (
    sequence_effect_id  INTEGER NOT NULL REFERENCES effects(id) ON DELETE CASCADE,
    step_order          INTEGER NOT NULL,
    child_effect_id     INTEGER NOT NULL REFERENCES effects(id),
    PRIMARY KEY (sequence_effect_id, step_order)
);

CREATE TABLE multi_stat_changes (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    effect_id   INTEGER NOT NULL REFERENCES effects(id) ON DELETE CASCADE,
    stat        TEXT    NOT NULL,   -- Stat enum
    stages      INTEGER NOT NULL
);

-- ============================================================
-- ATTEMPTS  (IAttempt strategy nodes)
-- ============================================================

CREATE TABLE attempts (
    id                      INTEGER PRIMARY KEY AUTOINCREMENT,
    move_id                 INTEGER NOT NULL REFERENCES moves(id) ON DELETE CASCADE,
    type                    TEXT    NOT NULL,   -- Attempt / Cascade / Combo / Charge / Rampage

    -- Attempt + Combo ----------------------------------------------
    accuracy_value          REAL,               -- hit chance (e.g. 0.95)

    -- Attempt ------------------------------------------------------
    on_hit_effect_id        INTEGER REFERENCES effects(id),
    on_miss_effect_id       INTEGER REFERENCES effects(id),
    after_effect_id         INTEGER REFERENCES effects(id),

    -- Cascade ------------------------------------------------------
    stop_on_miss            INTEGER DEFAULT 1,  -- 1 = stop chain on first miss

    -- Combo --------------------------------------------------------
    hits_number_id          INTEGER REFERENCES numbers(id),     -- how many times to hit

    -- Charge -------------------------------------------------------
    charge_effect_id        INTEGER REFERENCES effects(id),     -- effect during charge turn
    release_attempt_id      INTEGER REFERENCES attempts(id),    -- attempt fired on release turn

    -- Rampage ------------------------------------------------------
    rampage_min_turns       INTEGER,
    rampage_max_turns       INTEGER,
    after_rampage_effect_id INTEGER REFERENCES effects(id)      -- e.g. Confuse after Outrage
);

CREATE TABLE cascade_steps (
    cascade_attempt_id  INTEGER NOT NULL REFERENCES attempts(id) ON DELETE CASCADE,
    step_order          INTEGER NOT NULL,
    child_attempt_id    INTEGER NOT NULL REFERENCES attempts(id),
    PRIMARY KEY (cascade_attempt_id, step_order)
);

-- ============================================================
-- INDEXES
-- ============================================================

CREATE INDEX idx_attempts_move_id          ON attempts(move_id);
CREATE INDEX idx_cascade_steps_parent      ON cascade_steps(cascade_attempt_id);
CREATE INDEX idx_sequence_steps_parent     ON sequence_steps(sequence_effect_id);
CREATE INDEX idx_weighted_entries_number   ON weighted_entries(number_id);
CREATE INDEX idx_multi_stat_changes_effect ON multi_stat_changes(effect_id);</sql><sql name="SQL 6">-- ============================================================
-- Flamethrower
-- ============================================================
-- Move tree:
--   Attempt (accuracy = 1.0, always hits)
--     onHit → Sequence
--               [0] FormulaDamage  (power=90, target=Defender)
--               [1] Chance (10%)  → Burn (target=Defender)
-- ============================================================

PRAGMA foreign_keys = ON;

-- ── Numbers ──────────────────────────────────────────────────

INSERT INTO numbers (id, type, exact_value)
    VALUES (1, 'Exactly', 90.0);                  -- base power

-- ── Effects ──────────────────────────────────────────────────

INSERT INTO effects (id, type, target, number_id)
    VALUES (1, 'FormulaDamage', 'Defender', 1);   -- deal 90 damage

INSERT INTO effects (id, type, target)
    VALUES (2, 'Burn', 'Defender');               -- apply Burn status

INSERT INTO effects (id, type, chance_probability, child_effect_id)
    VALUES (3, 'Chance', 0.10, 2);                -- 10% chance → Burn

INSERT INTO effects (id, type)
    VALUES (4, 'Sequence');                       -- groups [FormulaDamage, Chance]

INSERT INTO sequence_steps (sequence_effect_id, step_order, child_effect_id)
    VALUES (4, 0, 1),                             -- [0] FormulaDamage
           (4, 1, 3);                             -- [1] Chance(Burn)

-- ── Move ─────────────────────────────────────────────────────

INSERT INTO moves (id, name, element, category, target, pp, priority, crit_stage, description)
    VALUES (1, 'Flamethrower', 'Fire', 'Special', 'Opponent', 15, 0, 0,
            'The target is scorched with an intense blast of fire. It may also leave the target with a burn.');

-- ── Attempt ──────────────────────────────────────────────────

INSERT INTO attempts (id, move_id, type, accuracy_value, on_hit_effect_id)
    VALUES (1, 1, 'Attempt', 1.0, 4);            -- always hits, onHit = Sequence

-- ============================================================
-- SELECT — full Flamethrower tree in one query
-- ============================================================

SELECT
    m.name                          AS move,
    m.element                       AS type,
    m.category                      AS category,
    m.pp                            AS pp,
    m.priority                      AS priority,
    m.crit_stage                    AS crit_stage,
    m.description                   AS description,
    a.type                          AS attempt_type,
    a.accuracy_value                AS accuracy,
    root.type                       AS root_effect,
    step.step_order                 AS step,
    child.type                      AS child_effect,
    n.exact_value                   AS power,
    child.chance_probability        AS chance_pct,
    wrapped.type                    AS wrapped_effect
FROM moves          m
JOIN attempts       a       ON a.move_id               = m.id
JOIN effects        root    ON root.id                 = a.on_hit_effect_id
JOIN sequence_steps step    ON step.sequence_effect_id = root.id
JOIN effects        child   ON child.id                = step.child_effect_id
LEFT JOIN numbers   n       ON n.id                    = child.number_id
LEFT JOIN effects   wrapped ON wrapped.id              = child.child_effect_id
WHERE m.name = 'Flamethrower'
ORDER BY step.step_order;</sql><current_tab id="1"/></tab_sql></sqlb_project>
