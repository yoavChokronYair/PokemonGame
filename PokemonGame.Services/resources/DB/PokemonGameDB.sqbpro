value="64"/><column index="9" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="148"/><column index="2" value="31"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="create database">-- ============================================================
-- PokemonGameDB - Full Schema
-- ============================================================
-- Re-runnable: drops everything then recreates clean.
-- Drop order is strictly children before parents.
-- ============================================================

PRAGMA foreign_keys = OFF;

-- ============================================================
-- DROP ALL
-- ============================================================

-- Move system (new)
DROP TABLE IF EXISTS cascade_steps;
DROP TABLE IF EXISTS attempts;
DROP TABLE IF EXISTS sequence_steps;
DROP TABLE IF EXISTS multi_stat_changes;
DROP TABLE IF EXISTS effects;
DROP TABLE IF EXISTS conditions;
DROP TABLE IF EXISTS weighted_entries;
DROP TABLE IF EXISTS numbers;
DROP TABLE IF EXISTS moves;

-- Game world (existing)
DROP TABLE IF EXISTS BattleTeamPokemon;
DROP TABLE IF EXISTS BattleTeam;
DROP TABLE IF EXISTS Battle;
DROP TABLE IF EXISTS BattlePlayer;
DROP TABLE IF EXISTS LevelUpMove;
DROP TABLE IF EXISTS EggMove;
DROP TABLE IF EXISTS Move;
DROP TABLE IF EXISTS Evolution;
DROP TABLE IF EXISTS BaseStats;
DROP TABLE IF EXISTS PokemonForm;
DROP TABLE IF EXISTS FlagsDetailsMap;
DROP TABLE IF EXISTS ScriptTiles;
DROP TABLE IF EXISTS Objs;
DROP TABLE IF EXISTS ObjSprites;
DROP TABLE IF EXISTS Warps;
DROP TABLE IF EXISTS Connection;
DROP TABLE IF EXISTS Details;
DROP TABLE IF EXISTS Encounter;
DROP TABLE IF EXISTS Map;
DROP TABLE IF EXISTS Events;
DROP TABLE IF EXISTS Ability;
DROP TABLE IF EXISTS Pokemon;
DROP TABLE IF EXISTS UserFriend;
DROP TABLE IF EXISTS StoryPlayer;
DROP TABLE IF EXISTS Users;

PRAGMA foreign_keys = ON;

-- ============================================================
-- GAME WORLD TABLES  (unchanged from original)
-- ============================================================

CREATE TABLE Users (
    UserID   INTEGER PRIMARY KEY,
    UserName TEXT,
    Password INT
);

CREATE TABLE UserFriend (
    UserID       INTEGER,
    FriendUserID INTEGER,
    IsOnline     BOOLEAN,
    PRIMARY KEY (UserID, FriendUserID),
    FOREIGN KEY (UserID)       REFERENCES Users(UserID),
    FOREIGN KEY (FriendUserID) REFERENCES Users(UserID)
);

CREATE TABLE StoryPlayer (
    PlayerID INTEGER PRIMARY KEY,
    UserID   INTEGER,
    Name     TEXT,
    FOREIGN KEY (UserID) REFERENCES Users(UserID)
);

CREATE TABLE Map (
    MapID INTEGER PRIMARY KEY,
    Name  TEXT
);

CREATE TABLE Details (
    DetailsID INTEGER PRIMARY KEY,
    Section   TEXT,
    Weather   TEXT,
    Music     TEXT,
    MapID     INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE FlagsDetailsMap (
    FlagID          INTEGER PRIMARY KEY,
    Bike            BOOLEAN,
    DayTint         BOOLEAN,
    Dig_EscapeRope  BOOLEAN,
    Fly             BOOLEAN,
    ShowMapName     BOOLEAN,
    Teleport        BOOLEAN,
    DetailsID       INTEGER,
    FOREIGN KEY (DetailsID) REFERENCES Details(DetailsID)
);

CREATE TABLE Connection (
    ConnectionID INTEGER PRIMARY KEY,
    Direction    TEXT,
    Map          TEXT,
    Offset       INTEGER,
    MapID        INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE Encounter (
    EncounterID INTEGER PRIMARY KEY,
    minLevel    INTEGER,
    MaxLevel    INTEGER,
    SpeciesName TEXT,
    Chance      REAL,
    MapID       INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE Warps (
    WarpsID       INTEGER PRIMARY KEY,
    MapID         INTEGER,
    X             INTEGER,
    Y             INTEGER,
    Elevation     INTEGER,
    DestMap       TEXT,
    DestX         INTEGER,
    DestY         INTEGER,
    DestElevation INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE Events (
    EventID INTEGER PRIMARY KEY
);

CREATE TABLE ObjSprites (
    ObjSpriteID INTEGER PRIMARY KEY,
    Name        TEXT,
    Sprite      BLOB,
    Width       INTEGER,
    Height      INTEGER,
    ShadowX     INTEGER,
    ShadowY     INTEGER,
    ShadowW     INTEGER,
    ShadowH     INTEGER
);

CREATE TABLE Objs (
    ObjID        INTEGER PRIMARY KEY,
    EventID      INTEGER,
    X            INTEGER,
    Y            INTEGER,
    Elevation    INTEGER,
    Sprite       INTEGER,
    MovementType TEXT,
    MovementX    INTEGER,
    MovementY    INTEGER,
    TrainerType  TEXT,
    TrainerSight INTEGER,
    ScriptID     INTEGER,
    Flag         INTEGER,
    FOREIGN KEY (EventID) REFERENCES Events(EventID),
    FOREIGN KEY (Flag)    REFERENCES FlagsDetailsMap(FlagID)
);

CREATE TABLE ScriptTiles (
    ScruptTileID     INTEGER PRIMARY KEY,
    X                INTEGER,
    Y                INTEGER,
    Var              TEXT,
    VarValue         TEXT,
    VarConditional   TEXT,
    ScriptID         INTEGER,
    EventID          INTEGER,
    FOREIGN KEY (EventID) REFERENCES Events(EventID)
);

CREATE TABLE Ability (
    AbilityID          INTEGER PRIMARY KEY,
    AbilityName        TEXT,
    AbilityDescription TEXT,
    Category           INTEGER
);

CREATE TABLE Pokemon (
    PokemonID   INTEGER PRIMARY KEY,
    SpeciesName TEXT UNIQUE
);

CREATE TABLE BaseStats (
    PokemonID      INTEGER,
    HP             INTEGER,
    Attack         INTEGER,
    Defense        INTEGER,
    SpAttack       INTEGER,
    SpDefense      INTEGER,
    Speed          INTEGER,
    Type1          TEXT,
    Type2          TEXT,
    CatchRate      INTEGER,
    EggCycles      INTEGER,
    BaseFriendship INTEGER,
    GenderRatio    TEXT,
    GrowthRate     TEXT,
    BaseEXPYield   INTEGER,
    EggGroup1      TEXT,
    EggGroup2      TEXT,
    Ability1ID     INTEGER,
    Ability2ID     INTEGER,
    AbilityHID     INTEGER,
    FleeRate       REAL,
    Weight         REAL,
    FOREIGN KEY (PokemonID)  REFERENCES Pokemon(PokemonID),
    FOREIGN KEY (Ability1ID) REFERENCES Ability(AbilityID),
    FOREIGN KEY (Ability2ID) REFERENCES Ability(AbilityID),
    FOREIGN KEY (AbilityHID) REFERENCES Ability(AbilityID)
);

CREATE TABLE PokemonForm (
    FormID    INTEGER PRIMARY KEY,
    FormName  TEXT,
    PokemonID INTEGER,
    FOREIGN KEY (PokemonID) REFERENCES Pokemon(PokemonID)
);

CREATE TABLE Evolution (
    PokemonID       INTEGER,
    BabySpeciesName TEXT,
    SpeciesName     TEXT,
    Method          TEXT,
    FormID          INTEGER,
    LevelRequired   INTEGER,
    FOREIGN KEY (PokemonID)       REFERENCES Pokemon(PokemonID),
    FOREIGN KEY (SpeciesName)     REFERENCES Pokemon(SpeciesName),
    FOREIGN KEY (BabySpeciesName) REFERENCES Pokemon(SpeciesName),
    FOREIGN KEY (FormID)          REFERENCES PokemonForm(FormID)
);

-- LevelUpMove and EggMove have no FK to any move table for now
CREATE TABLE LevelUpMove (
    MoveID    INTEGER,
    Level     INTEGER,
    PokemonID INTEGER,
    PRIMARY KEY (MoveID, Level),
    FOREIGN KEY (PokemonID) REFERENCES Pokemon(PokemonID)
);

CREATE TABLE EggMove (
    MoveID    INTEGER,
    PokemonID INTEGER,
    FOREIGN KEY (PokemonID) REFERENCES Pokemon(PokemonID)
);

CREATE TABLE BattlePlayer (
    BattlePlayerID INTEGER PRIMARY KEY,
    BattleID       INTEGER,
    UserID         INTEGER,
    Name           TEXT,
    Level          INTEGER,
    FOREIGN KEY (UserID) REFERENCES Users(UserID)
);

CREATE TABLE Battle (
    BattleID              INTEGER PRIMARY KEY,
    WinnerBattlePlayerID  INTEGER,
    BattleDate            TEXT NOT NULL,
    FOREIGN KEY (WinnerBattlePlayerID) REFERENCES BattlePlayer(BattlePlayerID)
);

CREATE TABLE BattleTeam (
    BattleTeamID   INTEGER PRIMARY KEY,
    BattleID       INTEGER NOT NULL,
    BattlePlayerID INTEGER NOT NULL,
    TeamSlot       INTEGER NOT NULL,
    FOREIGN KEY (BattleID)       REFERENCES Battle(BattleID),
    FOREIGN KEY (BattlePlayerID) REFERENCES BattlePlayer(BattlePlayerID)
);

CREATE TABLE BattleTeamPokemon (
    BattleTeamID INTEGER NOT NULL,
    PokemonID    INTEGER NOT NULL,
    Slot         INTEGER NOT NULL,
    PRIMARY KEY (BattleTeamID, Slot),
    FOREIGN KEY (BattleTeamID) REFERENCES BattleTeam(BattleTeamID),
    FOREIGN KEY (PokemonID)    REFERENCES Pokemon(PokemonID)
);

-- ============================================================
-- NEW MOVE SYSTEM  (standalone, no links to game world tables)
-- ============================================================

CREATE TABLE moves (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    name        TEXT    NOT NULL UNIQUE,
    element     TEXT    NOT NULL,                    -- PokemonType enum
    category    TEXT    NOT NULL,                    -- Physical / Special / Status
    target      TEXT    NOT NULL DEFAULT 'Opponent', -- MoveTarget enum
    pp          INTEGER NOT NULL,
    priority    INTEGER NOT NULL DEFAULT 0,
    crit_stage  INTEGER NOT NULL DEFAULT 0,
    description TEXT
);

CREATE TABLE numbers (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    type            TEXT    NOT NULL,
    exact_value     REAL,
    range_min       REAL,
    range_max       REAL,
    left_number_id  INTEGER REFERENCES numbers(id),
    right_number_id INTEGER REFERENCES numbers(id),
    target          TEXT
);

CREATE TABLE weighted_entries (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    number_id INTEGER NOT NULL REFERENCES numbers(id) ON DELETE CASCADE,
    value     REAL    NOT NULL,
    weight    REAL    NOT NULL
);

CREATE TABLE conditions (
    id                 INTEGER PRIMARY KEY AUTOINCREMENT,
    type               TEXT    NOT NULL,
    probability        REAL,
    weather            TEXT,
    status             TEXT,
    volatile_status    TEXT,
    hp_fraction        REAL,
    pokemon_type       TEXT,
    left_condition_id  INTEGER REFERENCES conditions(id),
    right_condition_id INTEGER REFERENCES conditions(id),
    inner_condition_id INTEGER REFERENCES conditions(id)
);

CREATE TABLE effects (
    id                 INTEGER PRIMARY KEY AUTOINCREMENT,
    type               TEXT    NOT NULL,
    target             TEXT,
    number_id          INTEGER REFERENCES numbers(id),
    heal_target        TEXT,
    chance_probability REAL,
    child_effect_id    INTEGER REFERENCES effects(id),
    condition_id       INTEGER REFERENCES conditions(id),
    on_pass_effect_id  INTEGER REFERENCES effects(id),
    on_fail_effect_id  INTEGER REFERENCES effects(id),
    stat               TEXT,
    stat_stages        INTEGER,
    sleep_min_turns    INTEGER,
    sleep_max_turns    INTEGER,
    confuse_min_turns  INTEGER,
    confuse_max_turns  INTEGER,
    is_toxic           INTEGER DEFAULT 0,
    weather            TEXT,
    weather_turns      INTEGER,
    screen             TEXT,
    screen_turns       INTEGER,
    battle_side        TEXT,
    hazard             TEXT,
    charge_turns       INTEGER
);

CREATE TABLE sequence_steps (
    sequence_effect_id INTEGER NOT NULL REFERENCES effects(id) ON DELETE CASCADE,
    step_order         INTEGER NOT NULL,
    child_effect_id    INTEGER NOT NULL REFERENCES effects(id),
    PRIMARY KEY (sequence_effect_id, step_order)
);

CREATE TABLE multi_stat_changes (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    effect_id INTEGER NOT NULL REFERENCES effects(id) ON DELETE CASCADE,
    stat      TEXT    NOT NULL,
    stages    INTEGER NOT NULL
);

CREATE TABLE attempts (
    id                      INTEGER PRIMARY KEY AUTOINCREMENT,
    move_id                 INTEGER NOT NULL REFERENCES moves(id) ON DELETE CASCADE,
    type                    TEXT    NOT NULL,
    accuracy_value          REAL,
    on_hit_effect_id        INTEGER REFERENCES effects(id),
    on_miss_effect_id       INTEGER REFERENCES effects(id),
    after_effect_id         INTEGER REFERENCES effects(id),
    stop_on_miss            INTEGER DEFAULT 1,
    hits_number_id          INTEGER REFERENCES numbers(id),
    charge_effect_id        INTEGER REFERENCES effects(id),
    release_attempt_id      INTEGER REFERENCES attempts(id),
    rampage_min_turns       INTEGER,
    rampage_max_turns       INTEGER,
    after_rampage_effect_id INTEGER REFERENCES effects(id)
);

CREATE TABLE cascade_steps (
    cascade_attempt_id INTEGER NOT NULL REFERENCES attempts(id) ON DELETE CASCADE,
    step_order         INTEGER NOT NULL,
    child_attempt_id   INTEGER NOT NULL REFERENCES attempts(id),
    PRIMARY KEY (cascade_attempt_id, step_order)
);

-- ============================================================
-- INDEXES
-- ============================================================

CREATE INDEX idx_attempts_move_id          ON attempts(move_id);
CREATE INDEX idx_cascade_steps_parent      ON cascade_steps(cascade_attempt_id);
CREATE INDEX idx_sequence_steps_parent     ON sequence_steps(sequence_effect_id);
CREATE INDEX idx_weighted_entries_number   ON weighted_entries(number_id);
CREATE INDEX idx_multi_stat_changes_effect ON multi_stat_changes(effect_id);</sql><sql name="Add one value to table">PRAGMA foreign_keys = ON;

