<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="PokemonGameDB.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="7057"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="abilities" custom_title="0" dock_id="4" table="4,9:mainabilities"/><table title="effects" custom_title="0" dock_id="4" table="4,7:maineffects"/><table title="BattlePlayerSettings" custom_title="0" dock_id="5" table="4,20:mainBattlePlayerSettings"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Battle" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="55"/><column index="2" value="132"/><column index="3" value="68"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="BattlePlayer" show_row_id="0" encoding="" plot_x_axis="UserID" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="90"/><column index="2" value="55"/><column index="3" value="50"/><column index="4" value="41"/><column index="5" value="38"/><column index="6" value="36"/><column index="7" value="45"/><column index="8" value="156"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes><y_axis name="" line_style="0" point_shape="0" colour="#000000" active="0"/><y_axis name="BattleID" line_style="1" point_shape="5" colour="#ff420e" active="1"/><y_axis name="BattlePlayerID" line_style="1" point_shape="5" colour="#004586" active="1"/><y2_axis name="" line_style="0" point_shape="0" colour="#000000" active="0"/><y2_axis name="Row #" line_style="1" point_shape="5" colour="#ffd320" active="1"/></plot_y_axes><global_filter/></table><table schema="main" name="BattlePlayerFriends" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="59"/><column index="2" value="94"/><column index="3" value="44"/><column index="4" value="36"/><column index="5" value="45"/><column index="6" value="68"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="BattlePlayerSettings" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="92"/><column index="2" value="76"/><column index="3" value="110"/><column index="4" value="123"/><column index="5" value="115"/><column index="6" value="113"/><column index="7" value="134"/><column index="8" value="139"/><column index="9" value="156"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="BattlePlayerStats" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="92"/><column index="2" value="36"/><column index="3" value="45"/><column index="4" value="44"/><column index="5" value="108"/><column index="6" value="91"/><column index="7" value="111"/><column index="8" value="115"/><column index="9" value="101"/><column index="10" value="127"/><column index="11" value="71"/><column index="12" value="69"/><column index="13" value="91"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_