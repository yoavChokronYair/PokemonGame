    &quot;ObtainedAtRoute&quot;,
    &quot;ObtainedAt&quot;,
    &quot;ObtainedAtLevel&quot;,
    &quot;CaughtWithBall&quot;,
    &quot;MetLocationText&quot;,
    &quot;Experience&quot;,
    &quot;GrowthRate&quot;,
    &quot;CurrentHP&quot;,
    &quot;StatusId&quot;,
    &quot;Friendship&quot;,
    &quot;Affection&quot;
)
VALUES
(
