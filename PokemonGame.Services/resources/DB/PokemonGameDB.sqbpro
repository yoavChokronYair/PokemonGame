splay_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="moves" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="31"/><column index="2" value="117"/><column index="3" value="70"/><column index="4" value="70"/><column index="5" value="70"/><column index="6" value="29"/><column index="7" value="49"/><column index="8" value="64"/><column index="9" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="pokedex_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="71"/><column index="2" value="54"/><column index="3" value="57"/><column index="4" value="101"/><column index="5" value="85"/><column index="6" value="108"/><column index="7" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="pokemon_general" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="69"/><column index="2" value="39"/><column index="3" value="82"/><column index="4" value="98"/><column index="5" value="98"/><column index="6" value="40"/><column index="7" value="40"/><column index="8" value="61"/><column index="9" value="76"/><column index="10" value="97"/><column index="11" value="58"/><column index="12" value="74"/><column index="13" value="93"/><column index="14" value="54"/><column index="15" value="77"/><column index="16" value="76"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="pokemon_stats" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="71"/><column index="2" value="59"/><column index="3" value="29"/><column index="4" value="43"/><column index="5" value="52"/><column index="6" value="40"/><column index="7" value="40"/><column index="8" value="41"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="148"/><column index="2" value="31"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="team_members" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="56"/><column index="2" value="76"/><column index="3" value="79"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="teams" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="3" mode="0"/></sort><column_widths><column index="1" value="29"/><column index="2" value="101"/><column index="3" value="52"/><column index="4" value="102"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="create database">-- ============================================================
-- PokemonGameDB - Full Schema
-- ============================================================
-- Re-runnable: drops everything then recreates clean.
-- Drop order is strictly children before parents.
-- ============================================================

PRAGMA foreign_keys = OFF;

-- ============================================================
-- DROP ALL
-- ============================================================

-- Game world (existing)
DROP TABLE IF EXISTS BattleTeamPokemon;
DROP TABLE IF EXISTS BattleTeam;
DROP TABLE IF EXISTS Battle;
DROP TABLE IF EXISTS BattlePlayer;
DROP TABLE IF EXISTS BattlePlayerFriends;
DROP TABLE IF EXISTS StoryPlayer;
DROP TABLE IF EXISTS Users;
-- 1. DROP Bridge Tables (Dependents)
DROP TABLE IF EXISTS levelup_moves;
DROP TABLE IF EXISTS machine_moves;
DROP TABLE IF EXISTS egg_moves;
DROP TABLE IF EXISTS tutor_moves;
DROP TABLE IF EXISTS pokemon_stats;
DROP TABLE IF EXISTS breeding;
DROP TABLE IF EXISTS pokedex_data;
DROP TABLE IF EXISTS battler_pokemon;
DROP TABLE IF EXISTS team_members;
DROP TABLE IF EXISTS BattleParticipants;
DROP TABLE IF EXISTS BattlePlayerStats;
-- 2. DROP Master Tables
DROP TABLE IF EXISTS pokemon_general;
DROP TABLE IF EXISTS abilities;
DROP TABLE IF EXISTS items;
DROP TABLE IF EXISTS teams;


PRAGMA foreign_keys = ON;

-- ============================================================
-- GAME WORLD TABLES  (unchanged from original)
-- ============================================================

CREATE TABLE Users (
    UserID   INTEGER PRIMARY KEY,
    UserName TEXT,
    Password INT
);
CREATE TABLE 

Friends (
    PlayerID         INTEGER,
    FriendPlayerID   INTEGER,
    Status           TEXT DEFAULT 'Pending', -- 'Pending', 'Accepted', 'Blocked'
    Wins             INTEGER DEFAULT 0,
    Losses           INTEGER DEFAULT 0,
    LastPlayed       TEXT,                   -- Useful for sorting friends
    PRIMARY KEY (PlayerID, FriendPlayerID),
    FOREIGN KEY (PlayerID)       REFERENCES BattlePlayer(BattlePlayerID),
    FOREIGN KEY (FriendPlayerID) REFERENCES BattlePlayer(BattlePlayerID)
);
CREATE TABLE StoryPlayer (
    PlayerID INTEGER PRIMARY KEY,
    UserID   INTEGER,
    Name     TEXT,
    FOREIGN KEY (UserID) REFERENCES Users(UserID)
);




-- BattlePlayer remains simple and independent
CREATE TABLE BattlePlayer (
    BattlePlayerID INTEGER PRIMARY KEY AUTOINCREMENT,
    BattleID       INTEGER,
    UserID         INTEGER REFERENCES Users(UserID),
    Name           TEXT,
    Level          INTEGER DEFAULT 5,  -- Start at level 5
    Wins           INTEGER DEFAULT 0,  -- Track session wins
    Losses         INTEGER DEFAULT 0,  -- Track session losses
    CreatedAt      TEXT DEFAULT (datetime('now')) -- Useful for sorting new players
);
CREATE TABLE BattlePlayerStats (
    BattlePlayerID   INTEGER PRIMARY KEY,
    
    -- Battle Record
    Wins             INTEGER DEFAULT 0,
    Losses           INTEGER DEFAULT 0,
    Draws            INTEGER DEFAULT 0,
    
    -- Streak
    CurrentWinStreak INTEGER DEFAULT 0,
    BestWinStreak    INTEGER DEFAULT 0,
    
    -- Detail Stats
    TotalDamageDealt    INTEGER DEFAULT 0,
    TotalDamageTaken    INTEGER DEFAULT 0,
    PokemonFainted      INTEGER DEFAULT 0,  -- how many of yours fainted
    PokemonKnockedOut   INTEGER DEFAULT 0,  -- how many enemies you KO'd
    MovesUsed           INTEGER DEFAULT 0,
    CriticalHits        INTEGER DEFAULT 0,
    
    -- Meta
    LastBattleDate   TEXT,
    
    FOREIGN KEY (BattlePlayerID) REFERENCES BattlePlayer(BattlePlayerID) ON DELETE CASCADE
);

CREATE TABLE Battle (
    BattleID              INTEGER PRIMARY KEY,
    WinnerBattlePlayerID  INTEGER,
    BattleDate            TEXT NOT NULL,
    FOREIGN KEY (WinnerBattlePlayerID) REFERENCES BattlePlayer(BattlePlayerID)
);

CREATE TABLE BattleTeam (
    BattleTeamID   INTEGER PRIMARY KEY,
    BattleID       INTEGER NOT NULL,
    BattlePlayerID INTEGER NOT NULL,
    TeamSlot       INTEGER NOT NULL,
    FOREIGN KEY (BattleID)       REFERENCES Battle(BattleID),
    FOREIGN KEY (BattlePlayerID) REFERENCES BattlePlayer(BattlePlayerID)
);

CREATE TABLE BattleTeamPokemon (
    BattleTeamID INTEGER NOT NULL,
    PokemonID    INTEGER NOT NULL,
    Slot         INTEGER NOT NULL,
    PRIMARY KEY (BattleTeamID, Slot),
    FOREIGN KEY (BattleTeamID) REFERENCES BattleTeam(BattleTeamID),
    FOREIGN KEY (PokemonID)    REFERENCES battler_pokemon(PokemonID)
);

CREATE TABLE abilities (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    name            TEXT NOT NULL UNIQUE,
    description     TEXT,
    effect_id       INTEGER REFERENCES effects(id),
    condition_id    INTEGER REFERENCES conditions(id)
);

CREATE TABLE pokemon_general (
    pokedexID       INTEGER PRIMARY KEY,
    name            TEXT NOT NULL,
    firstAbilityID  INTEGER REFERENCES abilities(id),
    secondAbilityID INTEGER REFERENCES abilities(id),
    hiddenAbilityID INTEGER REFERENCES abilities(id),
    type1           TEXT NOT NULL,
    type2           TEXT,
    catchrate       INTEGER,
    genderRatio     REAL,
    base_friendship INTEGER,
    firstItem       TEXT,
    secondItem      TEXT,
    pokemonEvoID    INTEGER,
    Evolevel        INTEGER,
    evo_method      TEXT DEFAULT 'Level', -- e.g., 'Level', 'Stone', 'Trade', 'Friendship'
	evo_itemID      INTEGER REFERENCES items(id)  -- Link for Stone evolutions
);
CREATE TABLE pokemon_stats (
    pokedexID   INTEGER NOT NULL REFERENCES pokemon_general(pokedexID),
    isEVYield   INTEGER NOT NULL CHECK (isEVYield IN (0, 1)), 
    hp          INTEGER NOT NULL DEFAULT 0,
    attack      INTEGER NOT NULL DEFAULT 0,
    defense     INTEGER NOT NULL DEFAULT 0,
    spAtk       INTEGER NOT NULL DEFAULT 0,
    spDef       INTEGER NOT NULL DEFAULT 0,
    speed       INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (pokedexID, isEVYield)
);

CREATE TABLE breeding (
    pokedexID             INTEGER PRIMARY KEY REFERENCES pokemon_general(pokedexID),
    eggGroup              TEXT,
    hatchTime             INTEGER,
    height                REAL,
    weight                REAL,
    baseExperienceYield   INTEGER,
    levelingRate          TEXT
);

CREATE TABLE pokedex_data (
    pokedexID         INTEGER PRIMARY KEY REFERENCES pokemon_general(pokedexID),
    color             TEXT,
    footprint         TEXT,
    shape             TEXT,
    nextEvolution     TEXT,
    previousEvolution TEXT,
    entries           TEXT
);
CREATE TABLE levelup_moves (
    pokedexID INTEGER NOT NULL REFERENCES pokemon_general(pokedexID),
    moveID    INTEGER NOT NULL REFERENCES moves(id),
    level     INTEGER NOT NULL,
    PRIMARY KEY (pokedexID, moveID, level)
);

CREATE TABLE machine_moves (
    machineID   TEXT NOT NULL, -- e.g., 'TM01'
    moveID      INTEGER NOT NULL REFERENCES moves(id),
    pokedexID   INTEGER NOT NULL REFERENCES pokemon_general(pokedexID),
    PRIMARY KEY (machineID, pokedexID)
);

CREATE TABLE egg_moves (
    pokedexID   INTEGER NOT NULL REFERENCES pokemon_general(pokedexID),
    moveID      INTEGER NOT NULL REFERENCES moves(id),
    PRIMARY KEY (pokedexID, moveID)
);

CREATE TABLE tutor_moves (
    pokedexID   INTEGER NOT NULL REFERENCES pokemon_general(pokedexID),
    moveID      INTEGER NOT NULL REFERENCES moves(id),
    tutor_location TEXT,
    PRIMARY KEY (pokedexID, moveID)
);
CREATE TABLE items (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    name            TEXT NOT NULL UNIQUE,
    category        TEXT, -- e.g., 'Medicine', 'Pokeball', 'Held Item', 'Key Item'
    price           INTEGER DEFAULT 0,
    description     TEXT,
    is_consumable   INTEGER DEFAULT 1, -- 1 for Potion, 0 for Leftovers/Key Items
    -- Logic Links
    effect_id       INTEGER REFERENCES effects(id),
    condition_id    INTEGER REFERENCES conditions(id)
);
CREATE TABLE battler_pokemon (
    pokemonID   INTEGER PRIMARY KEY AUTOINCREMENT, -- Unique ID for this specific instance
    pokedexID   INTEGER NOT NULL REFERENCES pokemon_general(pokedexID),
    abilityID   INTEGER NOT NULL REFERENCES abilities(id),
    itemID      INTEGER REFERENCES items(id),
    
    -- Aesthetic/Status
    shiny       INTEGER DEFAULT 0, -- 0 for normal, 1 for shiny
    gender      TEXT CHECK(gender IN ('Male', 'Female', 'Genderless')),
    level       INTEGER DEFAULT 50, -- Standard PvP level
    
    -- Moves (Linking to your existing moves table)
    move1ID     INTEGER NOT NULL REFERENCES moves(id),
    move2ID     INTEGER REFERENCES moves(id),
    move3ID     INTEGER REFERENCES moves(id),
    move4ID     INTEGER REFERENCES moves(id),

    -- Stats (Stored as individual integers for easy calculation)
    iv_hp       INTEGER DEFAULT 31, iv_atk  INTEGER DEFAULT 31,
    iv_def       INTEGER DEFAULT 31, iv_spAtk INTEGER DEFAULT 31,
    iv_spDef     INTEGER DEFAULT 31, iv_speed INTEGER DEFAULT 31,
    
    ev_hp       INTEGER DEFAULT 0,  ev_atk  INTEGER DEFAULT 0,
    ev_def       INTEGER DEFAULT 0,  ev_spAtk INTEGER DEFAULT 0,
    ev_spDef     INTEGER DEFAULT 0,  ev_speed INTEGER DEFAULT 0,
    
    nature      TEXT DEFAULT 'Hardy' -- Affects final stat calculation
);
CREATE TABLE teams (
    id             INTEGER PRIMARY KEY AUTOINCREMENT,
    team_name      TEXT NOT NULL,
    user_id        INTEGER NOT NULL REFERENCES Users(UserID),
    battle_player_id INTEGER REFERENCES BattlePlayer(BattlePlayerID) -- The link
);

CREATE TABLE team_members (
    team_id      INTEGER NOT NULL REFERENCES teams(id) ON DELETE CASCADE,
    pokemonID    INTEGER NOT NULL REFERENCES battler_pokemon(pokemonID) ON DELETE CASCADE,
    slot_number  INTEGER NOT NULL CHECK (slot_number BETWEEN 1 AND 6),
    PRIMARY KEY (team_id, slot_number)
);
CREATE TABLE BattleParticipants (
    BattleID          INTEGER NOT NULL REFERENCES Battle(BattleID),
    BattlePlayerID    INTEGER NOT NULL REFERENCES BattlePlayer(BattlePlayerID),
    IsWinner          INTEGER DEFAULT 0 CHECK (IsWinner IN (0, 1)),
    Score             INTEGER DEFAULT 0, -- e.g., how many pokemon they had left
    PRIMARY KEY (BattleID, BattlePlayerID)
);
CREATE TABLE moves (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    name        TEXT    NOT NULL UNIQUE,
    element     TEXT    NOT NULL,                    -- PokemonType enum
    category    TEXT    NOT NULL,                    -- Physical / Special / Status
    target      TEXT    NOT NULL DEFAULT 'Opponent', -- MoveTarget enum
    pp          INTEGER NOT NULL,
    priority    INTEGER NOT NULL DEFAULT 0,
    crit_stage  INTEGER NOT NULL DEFAULT 0,
    description TEXT
);

CREATE TABLE numbers (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    type            TEXT    NOT NULL,
    exact_value     REAL,
    range_min       REAL,
    range_max       REAL,
    left_number_id  INTEGER REFERENCES numbers(id),
    right_number_id INTEGER REFERENCES numbers(id),
    target          TEXT
);

CREATE TABLE weighted_entries (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    number_id INTEGER NOT NULL REFERENCES numbers(id) ON DELETE CASCADE,
    value     REAL    NOT NULL,
    weight    REAL    NOT NULL
);

CREATE TABLE conditions (
    id                 INTEGER PRIMARY KEY AUTOINCREMENT,
    type               TEXT    NOT NULL,
    probability        REAL,
    weather            TEXT,
    status             TEXT,
    volatile_status    TEXT,
    hp_fraction        REAL,
    pokemon_type       TEXT,
    left_condition_id  INTEGER REFERENCES conditions(id),
    right_condition_id INTEGER REFERENCES conditions(id),
    inner_condition_id INTEGER REFERENCES conditions(id)
);

CREATE TABLE effects (
    id                 INTEGER PRIMARY KEY AUTOINCREMENT,
    type               TEXT    NOT NULL,
    target             TEXT,
    number_id          INTEGER REFERENCES numbers(id),
    heal_target        TEXT,
    chance_probability REAL,
    child_effect_id    INTEGER REFERENCES effects(id),
    condition_id       INTEGER REFERENCES conditions(id),
    on_pass_effect_id  INTEGER REFERENCES effects(id),
    on_fail_effect_id  INTEGER REFERENCES effects(id),
    stat               TEXT,
    stat_stages        INTEGER,
    sleep_min_turns    INTEGER,
    sleep_max_turns    INTEGER,
    confuse_min_turns  INTEGER,
    confuse_max_turns  INTEGER,
    is_toxic           INTEGER DEFAULT 0,
    weather            TEXT,
    weather_turns      INTEGER,
    screen             TEXT,
    screen_turns       INTEGER,
    battle_side        TEXT,
    hazard             TEXT,
    charge_turns       INTEGER
);

CREATE TABLE sequence_steps (
    sequence_effect_id INTEGER NOT NULL REFERENCES effects(id) ON DELETE CASCADE,
    step_order         INTEGER NOT NULL,
    child_effect_id    INTEGER NOT NULL REFERENCES effects(id),
    PRIMARY KEY (sequence_effect_id, step_order)
);

CREATE TABLE multi_stat_changes (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    effect_id INTEGER NOT NULL REFERENCES effects(id) ON DELETE CASCADE,
    stat      TEXT    NOT NULL,
    stages    INTEGER NOT NULL
);

CREATE TABLE attempts (
    id                      INTEGER PRIMARY KEY AUTOINCREMENT,
    move_id                 INTEGER NOT NULL REFERENCES moves(id) ON DELETE CASCADE,
    type                    TEXT    NOT NULL,
    accuracy_value          REAL,
    on_hit_effect_id        INTEGER REFERENCES effects(id),
    on_miss_effect_id       INTEGER REFERENCES effects(id),
    after_effect_id         INTEGER REFERENCES effects(id),
    stop_on_miss            INTEGER DEFAULT 1,
    hits_number_id          INTEGER REFERENCES numbers(id),
    charge_effect_id        INTEGER REFERENCES effects(id),
    release_attempt_id      INTEGER REFERENCES attempts(id),
    rampage_min_turns       INTEGER,
    rampage_max_turns       INTEGER,
    after_rampage_effect_id INTEGER REFERENCES effects(id)
);

CREATE TABLE cascade_steps (
    cascade_attempt_id INTEGER NOT NULL REFERENCES attempts(id) ON DELETE CASCADE,
    step_order         INTEGER NOT NULL,
    child_attempt_id   INTEGER NOT NULL REFERENCES attempts(id),
    PRIMARY KEY (cascade_attempt_id, step_order)
);</sql><sql name="Add one value to table">PRAGMA foreign_keys = ON;

