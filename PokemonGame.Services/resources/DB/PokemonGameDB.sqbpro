    &quot;BattleID&quot;        INTEGER NOT NULL,
    &quot;BattlePlayerID&quot;  INTEGER NOT NULL,
    &quot;Slot&quot;            INTEGER NOT NULL CHECK(&quot;Slot&quot; BETWEEN 1 AND 6),
    &quot;PokemonID&quot;       INTEGER NOT NULL,
    PRIMARY KEY (&quot;BattleID&quot;, &quot;BattlePlayerID&quot;, &quot;Slot&quot;),
    FOREIGN KEY (&quot;BattleID&quot;) REFERENCES &quot;Battle&quot;(&quot;BattleID&quot;),
    FOREIGN KEY (&quot;BattlePlayerID&quot;) REFERENCES &quot;BattlePlayer&quot;(&quot;BattlePlayerID&quot;),
    FOREIGN KEY (&quot;PokemonID&quot;) REFERENCES &quot;battler_pokemon&quot;(&quot;pokemonID&quot;)
);
</sql><current_tab id="1"/></tab_sql></sqlb_project>
