    m.name AS table_name, 
    p. &quot;from&quot; AS column_name
FROM 
    sqlite_master m
JOIN 
    pragma_foreign_key_list(m.name) p ON p.&quot;table&quot; = 'conditions'
WHERE 
    m.type = 'table';</sql><sql name="SQL 6">SELECT DISTINCT id, type 
FROM conditions 
WHERE type NOT IN (
    -- Parameterless
    'IsNewPokemon', 'WasHitByContact', 'TookDamageThisTurn', 
    'DidKnockoutOpponent', 'HasAnyStatus', 'HasBaseStatChanged', 
    'IsHoldingItem', 'IsGrounded', 'IsAnyTerrainActive', 
    'IsBattleOver', 'IsFainted', 'IsFullHP',
    
    -- Parameterized
    'IsWeatherActive', 'IsTerrainActive', 'MoveHasTag', 
    'MoveIsCategory', 'HasStatus', 'HasVolatile', 
    'HasType', 'HPBelow', 'Probability',
    
    -- Combinators
    'And', 'Or', 'Not',
    
    -- Adapters
    'UserCondition', 'OpponentCondition'
);</sql><sql name="SQL 7">INSERT INTO effects (
    id, 
    type, 
    target, 
    multiplier
) 
VALUES (
    851, 
    'PowersUp', 
    'Attacker', 
    1.5
);</sql><sql name="SQL 8">DELETE FROM effects 
WHERE id BETWEEN 466 AND 472 </sql><sql name="SQL 9">PRAGMA table_info(effects);</sql><sql name="SQL 10">UPDATE effects SET target = 'Attacker' WHERE id IN (
    496, 497, 498, 499, 500, 501, 502, 503, 504, 505,
    506, 507, 508, 509, 510, 511, 518, 519, 532, 533,
    534, 535, 536, 537, 542, 543, 544, 550, 551, 552,
    553, 554, 570, 572, 574, 575, 576, 577, 578, 580,
    581, 586, 589, 590, 591, 594, 595
);</sql><current_tab id="7"/></tab_sql></sqlb_project>
