<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="PokemonGameDB.db" readonly="0" foreign_keys="0" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3968"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Users" custom_title="0" dock_id="4" table="4,5:mainUsers"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Ability" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="57"/><column index="2" value="76"/><column index="3" value="107"/><column index="4" value="58"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Users" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="47"/><column index="2" value="70"/><column index="3" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="create database*">PRAGMA foreign_keys = OFF;

-- DROP TABLES
DROP TABLE IF EXISTS BattlePlayer;
DROP TABLE IF EXISTS Connection;
DROP TABLE IF EXISTS Details;
DROP TABLE IF EXISTS EggMove;
DROP TABLE IF EXISTS Encounter;
DROP TABLE IF EXISTS Events;
DROP TABLE IF EXISTS Ability;
DROP TABLE IF EXISTS Evolution;
DROP TABLE IF EXISTS PokemonForm;
DROP TABLE IF EXISTS FlagsDetailsMap;
DROP TABLE IF EXISTS LevelUpMove;
DROP TABLE IF EXISTS Map;
DROP TABLE IF EXISTS ObjSprites;
DROP TABLE IF EXISTS Objs;
DROP TABLE IF EXISTS Pokemon;
DROP TABLE IF EXISTS BaseStats;
DROP TABLE IF EXISTS ScriptTiles;
DROP TABLE IF EXISTS StoryPlayer;
DROP TABLE IF EXISTS Users;
DROP TABLE IF EXISTS Warps;
Drop Table IF EXISTS Move;
PRAGMA foreign_keys = ON;

-- CREATE TABLES WITH FOREIGN KEYS

CREATE TABLE BattlePlayer (
    ID INTEGER PRIMARY KEY,
    UserID INTEGER,
	Name TEXT,
    Level INTEGER,
	FOREIGN KEY (UserID) REFERENCES Users(UserID)
);

CREATE TABLE Connection (
    ConnectionID INTEGER PRIMARY KEY,
    Direction TEXT,
    Map TEXT,
    Offset INTEGER,
	MapID INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE Details (
    DetailsID INTEGER PRIMARY KEY,
    Section TEXT,
    Weather TEXT,
    Music TEXT,
	MapID INTEGER,
	FOREIGN KEY (MapID) REFERENCES Map(MapID)

);

CREATE TABLE EggMove (
    MoveID INTEGER,
	PokemonID INTEGER,
    FOREIGN KEY (PokemonID) REFERENCES Pokemon(PokemonID),
    FOREIGN KEY (MoveID) REFERENCES Move(MoveID)

	
);

CREATE TABLE Encounter (
    EncounterID INTEGER PRIMARY KEY,
    minLevel INTEGER,
    MaxLevel INTEGER,
    SpeciesName TEXT,
    Chance REAL,
	MapID INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE Events (
    EventID INTEGER PRIMARY KEY
);

CREATE TABLE Evolution (
	PokemonID INTEGER,
	BabySpeciesName TEXT,
    SpeciesName TEXT,
	Method TEXT,
	FormID INTEGER,
	LevelRequired INTEGER,
    FOREIGN KEY (PokemonID) REFERENCES Pokemon(PokemonID),
    FOREIGN KEY (SpeciesName) REFERENCES Pokemon(SpeciesName),
    FOREIGN KEY (BabySpeciesName) REFERENCES Pokemon(SpeciesName),
    FOREIGN KEY (FormID) REFERENCES PokemonForm(FormID)
);
CREATE Table Ability(
	AbilityID INTEGER PRIMARY KEY,
	AbilityName TEXT,
	AbilityDescription TEXT,
	Category INTEGER
);
CREATE TABLE PokemonForm(
	FormID INTEGER PRIMARY KEY,
	FormName TEXT,
	PokemonID INTEGER,	
	FOREIGN KEY (PokemonID) REFERENCES Pokemon(PokemonID)
);
CREATE TABLE FlagsDetailsMap (
    FlagID INTEGER PRIMARY KEY,
    Bike BOOLEAN,
    DayTint BOOLEAN,
    Dig_EscapeRope BOOLEAN,
    Fly BOOLEAN,
    ShowMapName BOOLEAN,
    Teleport BOOLEAN,
	DetailsID INTEGER,
	FOREIGN KEY (DetailsID) REFERENCES Details(DetailsID)

);

CREATE TABLE LevelUpMove (
    MoveID INTEGER,
    Level INTEGER,
	PokemonID INTEGER,
    PRIMARY KEY (MoveID, Level),
    FOREIGN KEY (PokemonID) REFERENCES Pokemon(PokemonID),
    FOREIGN KEY (MoveID) REFERENCES Move(MoveID)
	
);

CREATE TABLE Map (
    MapID INTEGER PRIMARY KEY,
    Name TEXT
);

CREATE TABLE ObjSprites (
    ObjSpriteID INTEGER PRIMARY KEY,
    Name TEXT,
    Sprite BLOB,
    Width INTEGER,
    Height INTEGER,
    ShadowX INTEGER,
    ShadowY INTEGER,
    ShadowW INTEGER,
    ShadowH INTEGER
);

CREATE TABLE Objs (
    ObjID INTEGER PRIMARY KEY,
	EventID INTEGER,
    X INTEGER,
    Y INTEGER,
    Elevation INTEGER,
    Sprite INTEGER,
    MovementType TEXT,
    MovementX INTEGER,
    MovementY INTEGER,
    TrainerType TEXT,
    TrainerSight INTEGER,
    ScriptID INTEGER,
    Flag INTEGER,
    FOREIGN KEY (EventID) REFERENCES Events(EventID),
    FOREIGN KEY (Flag) REFERENCES FlagsDetailsMap(FlagID)
);

CREATE TABLE Pokemon (
    PokemonID INTEGER PRIMARY KEY,
	SpeciesName UNIQUE	
);
CREATE Table BaseStats(
	PokemonID INTEGER,
    HP INTEGER,
    Attack INTEGER,
    Defense INTEGER,
    SpAttack INTEGER,
    SpDefense INTEGER,
    Speed INTEGER,
    Type1 TEXT,
    Type2 TEXT,
    CatchRate INTEGER,
    EggCycles INTEGER,
    BaseFriendship INTEGER,
    GenderRatio TEXT,
    GrowthRate TEXT,
    BaseEXPYield INTEGER,
    EggGroup1 TEXT,
    EggGroup2 TEXT,
    Ability1ID INTEGER,
    Ability2ID INTEGER,
    AbilityHID INTEGER,
    FleeRate REAL,
    Weight REAL,
	FOREIGN KEY (PokemonID) REFERENCES Pokemon(PokemonID),
	FOREIGN KEY (Ability1ID) REFERENCES Ability(AbilityID),
    FOREIGN KEY (Ability2ID) REFERENCES Ability(AbilityID),
    FOREIGN KEY (AbilityHID) REFERENCES Ability(AbilityID)


);
CREATE TABLE ScriptTiles (
    ScruptTileID INTEGER PRIMARY KEY,
    X INTEGER,
    Y INTEGER,
    Var TEXT,
    VarValue TEXT,
    VarConditional TEXT,
    ScriptID INTEGER,
    EventID INTEGER,
    FOREIGN KEY (EventID) REFERENCES Events(EventID)
);

CREATE TABLE StoryPlayer (
    PlayerID INTEGER PRIMARY KEY,
    UserID INTEGER,
	Name TEXT,
	FOREIGN KEY (UserID) REFERENCES Users(UserID)
);

CREATE TABLE Users (
    UserID INTEGER PRIMARY KEY,
    UserName TEXT,
    Password INT
);

CREATE TABLE Warps (
    WarpsID INTEGER PRIMARY KEY,
	MapID INTEGER,
    X INTEGER,
    Y INTEGER,
    Elevation INTEGER,
    DestMap TEXT,
    DestX INTEGER,
    DestY INTEGER,
    DestElevation INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);
CREATE TABLE Move(
	MoveID INTEGER PRIMARY Key,
	MoveName TEXT,
	Type TEXT,
	Category TEXT,
	Priority INTEGER,
	PPTier INTEGER,
	MovePower INTEGER,
	MoveAccuracy INTEGER,
	Effect TEXT,
	EffectParam INTEGER,
	Targets TEXT,
	Flags TEXT
);
</sql><sql name="Add one value to table*">-- Insert into User first (no dependencies)
