y_formats/><hidden_columns/><plot_y_axes/><global_filter><filter value="192"/></global_filter></table><table schema="main" name="team_members" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="57"/><column index="2" value="75"/><column index="3" value="80"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="teams" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="127"/><column index="3" value="104"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="PokemonGameDB.db.sql" filename="C:/Users/yoav/Downloads/PokemonGameDB.db.sql">-- Reference to file &quot;C:/Users/yoav/Downloads/PokemonGameDB.db.sql&quot; (not supported by this version) --</sql><sql name="SQL 2">-- =========================================================
-- TILESETS
-- =========================================================

CREATE TABLE Tilesets
(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,

    Name TEXT NOT NULL UNIQUE,

    ImagePath TEXT NOT NULL,

    TileWidth INTEGER NOT NULL,
    TileHeight INTEGER NOT NULL,

    Margin INTEGER NOT NULL DEFAULT 0,
    Spacing INTEGER NOT NULL DEFAULT 0
);

-- =========================================================
-- TILE METADATA
-- =========================================================

CREATE TABLE TileMetadata
(
    TilesetId INTEGER NOT NULL,
    TileId INTEGER NOT NULL,

    CollisionType INTEGER NOT NULL DEFAULT 0,
    TileType INTEGER NOT NULL DEFAULT 0,

    IsAnimated INTEGER NOT NULL DEFAULT 0,
    AnimationFrames INTEGER DEFAULT 0,

    TilesetX INTEGER NOT NULL,
    TilesetY INTEGER NOT NULL,

    PRIMARY KEY(TilesetId, TileId),

    FOREIGN KEY(TilesetId)
        REFERENCES Tilesets(Id)
);

-- =========================================================
-- MAPS
-- =========================================================

CREATE TABLE Maps
(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,

    Name TEXT NOT NULL UNIQUE,

    Width INTEGER NOT NULL,
    Height INTEGER NOT NULL,

    Song TEXT,

    FlyWrapX INTEGER,
    FlyWrapY INTEGER,

    TownMapX INTEGER,
    TownMapY INTEGER
);

-- =========================================================
-- MAP VISUAL TILES
-- =========================================================

CREATE TABLE MapTiles
(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,

    MapId INTEGER NOT NULL,

    LayerType INTEGER NOT NULL,
    -- 0 = Ground
    -- 1 = Water
    -- 2 = Objects
    -- 3 = Above

    X INTEGER NOT NULL,
    Y INTEGER NOT NULL,

    TilesetId INTEGER NOT NULL,
    TileId INTEGER NOT NULL,

    FOREIGN KEY(MapId)
        REFERENCES Maps(Id),

    FOREIGN KEY(TilesetId)
        REFERENCES Tilesets(Id)
);

-- =========================================================
-- COLLISION / GAMEPLAY OBJECTS
-- =========================================================

CREATE TABLE MapCollisionObjects
(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,

    MapId INTEGER NOT NULL,

    X INTEGER NOT NULL,
    Y INTEGER NOT NULL,

    Width INTEGER NOT NULL DEFAULT 1,
    Height INTEGER NOT NULL DEFAULT 1,

    CollisionType INTEGER NOT NULL,
    -- HM
    -- WildGrass
    -- Blocked
    -- JumpLeft
    -- JumpRight
    -- JumpUp
    -- JumpDown

    FOREIGN KEY(MapId)
        REFERENCES Maps(Id)
);

-- =========================================================
-- MAP CONNECTIONS
-- =========================================================

CREATE TABLE ConnectedMaps
(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,

    MapId INTEGER NOT NULL,
    ConnectedMapId INTEGER NOT NULL,

    Direction INTEGER NOT NULL,
    Margin INTEGER NOT NULL,

    FOREIGN KEY(MapId)
        REFERENCES Maps(Id),

    FOREIGN KEY(ConnectedMapId)
        REFERENCES Maps(Id)
);

-- =========================================================
-- WRAPS / WARPS
-- =========================================================

CREATE TABLE Wraps
(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,

    MapId INTEGER NOT NULL,
    TargetMapId INTEGER NOT NULL,

    WrapX INTEGER NOT NULL,
    WrapY INTEGER NOT NULL,

    SpawnRow INTEGER NOT NULL,
    SpawnCol INTEGER NOT NULL,

    FOREIGN KEY(MapId)
        REFERENCES Maps(Id),

    FOREIGN KEY(TargetMapId)
        REFERENCES Maps(Id)
);

-- =========================================================
-- ENCOUNTERS
-- =========================================================

CREATE TABLE Encounters
(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,

    MapId INTEGER NOT NULL,

    PokemonId INTEGER NOT NULL,

    MinLevel INTEGER NOT NULL,
    MaxLevel INTEGER NOT NULL,

    CatchChance INTEGER NOT NULL,
    Rate INTEGER NOT NULL,

    EvYieldStat INTEGER,
    EvYieldAmount INTEGER,

    BaseExpYield INTEGER,
    BaseFriendshipYield INTEGER,

    CatchRate INTEGER,
    FemaleRatio INTEGER,

    FOREIGN KEY(MapId)
        REFERENCES Maps(Id)
);

-- =========================================================
-- NPC SPAWNS
-- =========================================================

CREATE TABLE NpcSpawns
(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,

    MapId INTEGER NOT NULL,

    NpcId INTEGER NOT NULL,

    X INTEGER NOT NULL,
    Y INTEGER NOT NULL,

    CollisionType INTEGER NOT NULL,

    MovementType INTEGER NOT NULL,

    FacingDirection INTEGER NOT NULL,

    DirectionA INTEGER,
    DirectionB INTEGER,

    StepsPerLeg INTEGER,

    DefaultState INTEGER NOT NULL DEFAULT 1,

    IsDisappearing INTEGER NOT NULL DEFAULT 0,

    VisionRange INTEGER NOT NULL DEFAULT 0,

    VisionType INTEGER NOT NULL DEFAULT 0,

    FOREIGN KEY(MapId)
        REFERENCES Maps(Id)
);

-- =========================================================
-- INDEXES
-- =========================================================

CREATE INDEX idx_maptiles_map
ON MapTiles(MapId);

CREATE INDEX idx_maptiles_position
ON MapTiles(MapId, X, Y);

CREATE INDEX idx_collision_map
ON MapCollisionObjects(MapId);

CREATE INDEX idx_collision_position
ON MapCollisionObjects(MapId, X, Y);

CREATE INDEX idx_npc_map
ON NpcSpawns(MapId);

CREATE INDEX idx_wrap_map
ON Wraps(MapId);

CREATE INDEX idx_encounter_map
ON Encounters(MapId);</sql><sql name="SQL 3">-- =========================================================
-- DROP TABLES (Ordered to respect Foreign Key constraints)
-- =========================================================

DROP TABLE IF EXISTS NpcSpawns;
DROP TABLE IF EXISTS Encounters;
DROP TABLE IF EXISTS Wraps;
DROP TABLE IF EXISTS ConnectedMaps;
DROP TABLE IF EXISTS MapCollisionObjects;
DROP TABLE IF EXISTS MapTiles;
DROP TABLE IF EXISTS Maps;
DROP TABLE IF EXISTS TileMetadata;
DROP TABLE IF EXISTS Tilesets;</sql><current_tab id="1"/></tab_sql></sqlb_project>
