    fk.&quot;table&quot; AS parent_table,
    m.name AS child_table,
    fk.&quot;from&quot; AS child_column,
    fk.&quot;to&quot; AS parent_column
FROM sqlite_master m
JOIN pragma_foreign_key_list(m.name) fk
WHERE m.type = 'table'
ORDER BY parent_table, child_table;
</sql><sql name="check row data with foregin key">SELECT 
    p.PokemonID,
    p.SpeciesName,

    -- Base Stats
    bs.HP, bs.Attack, bs.Defense, bs.SpAttack, bs.SpDefense, bs.Speed,
    bs.Type1, bs.Type2, bs.CatchRate, bs.EggCycles, bs.BaseFriendship,
    bs.GenderRatio, bs.GrowthRate, bs.BaseEXPYield, bs.EggGroup1, bs.EggGroup2,
    a1.AbilityName AS Ability1Name,
    a2.AbilityName AS Ability2Name,
    ah.AbilityName AS AbilityHName,
    bs.FleeRate, bs.Weight,

    -- Forms
    pf.FormName AS Form,

    -- Evolution
    e.BabySpeciesName AS PreEvolution,
    e.Method AS EvolutionMethod,
    e.LevelRequired AS EvolutionLevel,

    -- LevelUp Moves
    lum.Level AS MoveLevel,
    m.MoveName AS MoveName,
    m.Type AS MoveType,
    m.Category AS MoveCategory,
    m.MovePower, m.MoveAccuracy,

    -- Egg Moves
    em.MoveID AS EggMoveID

FROM Pokemon p

-- BaseStats
LEFT JOIN BaseStats bs ON bs.PokemonID = p.PokemonID

-- Abilities
LEFT JOIN Ability a1 ON a1.AbilityID = bs.Ability1ID
LEFT JOIN Ability a2 ON a2.AbilityID = bs.Ability2ID
LEFT JOIN Ability ah ON ah.AbilityID = bs.AbilityHID

-- Forms
LEFT JOIN PokemonForm pf ON pf.PokemonID = p.PokemonID

-- Evolution
LEFT JOIN Evolution e ON e.SpeciesName = p.SpeciesName

-- LevelUpMoves
LEFT JOIN LevelUpMove lum ON lum.PokemonID = p.PokemonID
LEFT JOIN Move m ON m.MoveID = lum.MoveID

-- EggMoves
LEFT JOIN EggMove em ON em.PokemonID = p.PokemonID
</sql><sql name="SQL 5">
CREATE TABLE moves (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    name        TEXT    NOT NULL UNIQUE,
    element     TEXT    NOT NULL,                    -- PokemonType enum
    category    TEXT    NOT NULL,                    -- Physical / Special / Status
    target      TEXT    NOT NULL DEFAULT 'Opponent', -- MoveTarget enum
    pp          INTEGER NOT NULL,
    priority    INTEGER NOT NULL DEFAULT 0,
    crit_stage  INTEGER NOT NULL DEFAULT 0,
    description TEXT
);

CREATE TABLE numbers (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    type            TEXT    NOT NULL,
    exact_value     REAL,
    range_min       REAL,
    range_max       REAL,
    left_number_id  INTEGER REFERENCES numbers(id),
    right_number_id INTEGER REFERENCES numbers(id),
    target          TEXT
);

CREATE TABLE weighted_entries (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    number_id INTEGER NOT NULL REFERENCES numbers(id) ON DELETE CASCADE,
    value     REAL    NOT NULL,
    weight    REAL    NOT NULL
);

CREATE TABLE conditions (
    id                 INTEGER PRIMARY KEY AUTOINCREMENT,
    type               TEXT    NOT NULL,
    probability        REAL,
    weather            TEXT,
    status             TEXT,
    volatile_status    TEXT,
    hp_fraction        REAL,
    pokemon_type       TEXT,
    left_condition_id  INTEGER REFERENCES conditions(id),
    right_condition_id INTEGER REFERENCES conditions(id),
    inner_condition_id INTEGER REFERENCES conditions(id)
);

CREATE TABLE effects (
    id                 INTEGER PRIMARY KEY AUTOINCREMENT,
    type               TEXT    NOT NULL,
    target             TEXT,
    number_id          INTEGER REFERENCES numbers(id),
    heal_target        TEXT,
    chance_probability REAL,
    child_effect_id    INTEGER REFERENCES effects(id),
    condition_id       INTEGER REFERENCES conditions(id),
    on_pass_effect_id  INTEGER REFERENCES effects(id),
    on_fail_effect_id  INTEGER REFERENCES effects(id),
    stat               TEXT,
    stat_stages        INTEGER,
    sleep_min_turns    INTEGER,
    sleep_max_turns    INTEGER,
    confuse_min_turns  INTEGER,
    confuse_max_turns  INTEGER,
    is_toxic           INTEGER DEFAULT 0,
    weather            TEXT,
    weather_turns      INTEGER,
    screen             TEXT,
    screen_turns       INTEGER,
    battle_side        TEXT,
    hazard             TEXT,
    charge_turns       INTEGER
);

CREATE TABLE sequence_steps (
    sequence_effect_id INTEGER NOT NULL REFERENCES effects(id) ON DELETE CASCADE,
    step_order         INTEGER NOT NULL,
    child_effect_id    INTEGER NOT NULL REFERENCES effects(id),
    PRIMARY KEY (sequence_effect_id, step_order)
);

CREATE TABLE multi_stat_changes (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    effect_id INTEGER NOT NULL REFERENCES effects(id) ON DELETE CASCADE,
    stat      TEXT    NOT NULL,
    stages    INTEGER NOT NULL
);

CREATE TABLE attempts (
    id                      INTEGER PRIMARY KEY AUTOINCREMENT,
    move_id                 INTEGER NOT NULL REFERENCES moves(id) ON DELETE CASCADE,
    type                    TEXT    NOT NULL,
    accuracy_value          REAL,
    on_hit_effect_id        INTEGER REFERENCES effects(id),
    on_miss_effect_id       INTEGER REFERENCES effects(id),
    after_effect_id         INTEGER REFERENCES effects(id),
    stop_on_miss            INTEGER DEFAULT 1,
    hits_number_id          INTEGER REFERENCES numbers(id),
    charge_effect_id        INTEGER REFERENCES effects(id),
    release_attempt_id      INTEGER REFERENCES attempts(id),
    rampage_min_turns       INTEGER,
    rampage_max_turns       INTEGER,
    after_rampage_effect_id INTEGER REFERENCES effects(id)
);

CREATE TABLE cascade_steps (
    cascade_attempt_id INTEGER NOT NULL REFERENCES attempts(id) ON DELETE CASCADE,
    step_order         INTEGER NOT NULL,
    child_attempt_id   INTEGER NOT NULL REFERENCES attempts(id),
    PRIMARY KEY (cascade_attempt_id, step_order)
);</sql><sql name="SQL 6">-- ============================================================
-- Flamethrower
-- ============================================================
-- Move tree:
--   Attempt (accuracy = 1.0, always hits)
--     onHit → Sequence
--               [0] FormulaDamage  (power=90, target=Defender)
--               [1] Chance (10%)  → Burn (target=Defender)
-- ============================================================

PRAGMA foreign_keys = ON;

-- ── Numbers ──────────────────────────────────────────────────

INSERT INTO numbers (id, type, exact_value)
    VALUES (1, 'Exactly', 90.0);                  -- base power

-- ── Effects ──────────────────────────────────────────────────

INSERT INTO effects (id, type, target, number_id)
    VALUES (1, 'FormulaDamage', 'Defender', 1);   -- deal 90 damage

INSERT INTO effects (id, type, target)
    VALUES (2, 'Burn', 'Defender');               -- apply Burn status

INSERT INTO effects (id, type, chance_probability, child_effect_id)
    VALUES (3, 'Chance', 0.10, 2);                -- 10% chance → Burn

INSERT INTO effects (id, type)
    VALUES (4, 'Sequence');                       -- groups [FormulaDamage, Chance]

INSERT INTO sequence_steps (sequence_effect_id, step_order, child_effect_id)
    VALUES (4, 0, 1),                             -- [0] FormulaDamage
           (4, 1, 3);                             -- [1] Chance(Burn)

-- ── Move ─────────────────────────────────────────────────────

INSERT INTO moves (id, name, element, category, target, pp, priority, crit_stage, description)
    VALUES (1, 'Flamethrower', 'Fire', 'Special', 'Opponent', 15, 0, 0,
            'The target is scorched with an intense blast of fire. It may also leave the target with a burn.');

-- ── Attempt ──────────────────────────────────────────────────

INSERT INTO attempts (id, move_id, type, accuracy_value, on_hit_effect_id)
    VALUES (1, 1, 'Attempt', 1.0, 4);            -- always hits, onHit = Sequence

-- ============================================================
-- SELECT — full Flamethrower tree in one query
-- ============================================================

SELECT
    m.name                          AS move,
    m.element                       AS type,
    m.category                      AS category,
    m.pp                            AS pp,
    m.priority                      AS priority,
    m.crit_stage                    AS crit_stage,
    m.description                   AS description,
    a.type                          AS attempt_type,
    a.accuracy_value                AS accuracy,
    root.type                       AS root_effect,
    step.step_order                 AS step,
    child.type                      AS child_effect,
    n.exact_value                   AS power,
    child.chance_probability        AS chance_pct,
    wrapped.type                    AS wrapped_effect
FROM moves          m
JOIN attempts       a       ON a.move_id               = m.id
JOIN effects        root    ON root.id                 = a.on_hit_effect_id
JOIN sequence_steps step    ON step.sequence_effect_id = root.id
JOIN effects        child   ON child.id                = step.child_effect_id
LEFT JOIN numbers   n       ON n.id                    = child.number_id
LEFT JOIN effects   wrapped ON wrapped.id              = child.child_effect_id
WHERE m.name = 'Flamethrower'
ORDER BY step.step_order;</sql><sql name="SQL 7">CREATE TABLE Map (
    MapID INTEGER PRIMARY KEY,
    Name  TEXT
);

CREATE TABLE Details (
    DetailsID INTEGER PRIMARY KEY,
    Section   TEXT,
    Weather   TEXT,
    Music     TEXT,
    MapID     INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE FlagsDetailsMap (
    FlagID          INTEGER PRIMARY KEY,
    Bike            BOOLEAN,
    DayTint         BOOLEAN,
    Dig_EscapeRope  BOOLEAN,
    Fly             BOOLEAN,
    ShowMapName     BOOLEAN,
    Teleport        BOOLEAN,
    DetailsID       INTEGER,
    FOREIGN KEY (DetailsID) REFERENCES Details(DetailsID)
);

CREATE TABLE Connection (
    ConnectionID INTEGER PRIMARY KEY,
    Direction    TEXT,
    Map          TEXT,
    Offset       INTEGER,
    MapID        INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE Encounter (
    EncounterID INTEGER PRIMARY KEY,
    minLevel    INTEGER,
    MaxLevel    INTEGER,
    SpeciesName TEXT,
    Chance      REAL,
    MapID       INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE Warps (
    WarpsID       INTEGER PRIMARY KEY,
    MapID         INTEGER,
    X             INTEGER,
    Y             INTEGER,
    Elevation     INTEGER,
    DestMap       TEXT,
    DestX         INTEGER,
    DestY         INTEGER,
    DestElevation INTEGER,
    FOREIGN KEY (MapID) REFERENCES Map(MapID)
);

CREATE TABLE Events (
    EventID INTEGER PRIMARY KEY
);

CREATE TABLE ObjSprites (
    ObjSpriteID INTEGER PRIMARY KEY,
    Name        TEXT,
    Sprite      BLOB,
    Width       INTEGER,
    Height      INTEGER,
    ShadowX     INTEGER,
    ShadowY     INTEGER,
    ShadowW     INTEGER,
    ShadowH     INTEGER
);

CREATE TABLE Objs (
    ObjID        INTEGER PRIMARY KEY,
    EventID      INTEGER,
    X            INTEGER,
    Y            INTEGER,
    Elevation    INTEGER,
    Sprite       INTEGER,
    MovementType TEXT,
    MovementX    INTEGER,
    MovementY    INTEGER,
    TrainerType  TEXT,
    TrainerSight INTEGER,
    ScriptID     INTEGER,
    Flag         INTEGER,
    FOREIGN KEY (EventID) REFERENCES Events(EventID),
    FOREIGN KEY (Flag)    REFERENCES FlagsDetailsMap(FlagID)
);

CREATE TABLE ScriptTiles (
    ScruptTileID     INTEGER PRIMARY KEY,
    X                INTEGER,
    Y                INTEGER,
    Var              TEXT,
    VarValue         TEXT,
    VarConditional   TEXT,
    ScriptID         INTEGER,
    EventID          INTEGER,
    FOREIGN KEY (EventID) REFERENCES Events(EventID)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
