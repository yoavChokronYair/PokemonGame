="1" value="40"/><column index="2" value="35"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">ATTACH DATABASE 'C:\Users\yoav\source\repos\PokemonGame\PokemonGame.Services\resources\DB\PokemonGameDB.db' AS source;

PRAGMA foreign_keys = OFF;

CREATE TABLE Battle AS SELECT * FROM source.Battle;
CREATE TABLE BattleParticipants AS SELECT * FROM source.BattleParticipants;
CREATE TABLE BattlePlayer AS SELECT * FROM source.BattlePlayer;
CREATE TABLE BattlePlayerSettings AS SELECT * FROM source.BattlePlayerSettings;
CREATE TABLE BattlePlayerStats AS SELECT * FROM source.BattlePlayerStats;
CREATE TABLE EggMove AS SELECT * FROM source.EggMove;
CREATE TABLE LevelUpMove AS SELECT * FROM source.LevelUpMove;
CREATE TABLE StoryPlayer AS SELECT * FROM source.StoryPlayer;
CREATE TABLE Users AS SELECT * FROM source.Users;
CREATE TABLE abilities AS SELECT * FROM source.abilities;
CREATE TABLE attempts AS SELECT * FROM source.attempts;
CREATE TABLE battler_pokemon AS SELECT * FROM source.battler_pokemon;
CREATE TABLE blocksets AS SELECT * FROM source.blocksets;
CREATE TABLE breeding AS SELECT * FROM source.breeding;
CREATE TABLE cascade_steps AS SELECT * FROM source.cascade_steps;
CREATE TABLE conditions AS SELECT * FROM source.conditions;
CREATE TABLE effects AS SELECT * FROM source.effects;
CREATE TABLE egg_moves AS SELECT * FROM source.egg_moves;
CREATE TABLE items AS SELECT * FROM source.items;
CREATE TABLE levelup_moves AS SELECT * FROM source.levelup_moves;
CREATE TABLE machine_moves AS SELECT * FROM source.machine_moves;
CREATE TABLE mapConnectors AS SELECT * FROM source.mapConnectors;
CREATE TABLE maps AS SELECT * FROM source.maps;
CREATE TABLE moves AS SELECT * FROM source.moves;
CREATE TABLE multi_stat_changes AS SELECT * FROM source.multi_stat_changes;
CREATE TABLE numbers AS SELECT * FROM source.numbers;
CREATE TABLE pokedex_data AS SELECT * FROM source.pokedex_data;
CREATE TABLE pokemon_general AS SELECT * FROM source.pokemon_general;
CREATE TABLE pokemon_stats AS SELECT * FROM source.pokemon_stats;
CREATE TABLE sequence_steps AS SELECT * FROM source.sequence_steps;
CREATE TABLE team_members AS SELECT * FROM source.team_members;
CREATE TABLE teams AS SELECT * FROM source.teams;
CREATE TABLE tiles AS SELECT * FROM source.tiles;
CREATE TABLE tutor_moves AS SELECT * FROM source.tutor_moves;
CREATE TABLE weighted_entries AS SELECT * FROM source.weighted_entries;
CREATE TABLE SyncQueue (
    Id         INTEGER PRIMARY KEY AUTOINCREMENT,
    Endpoint   TEXT NOT NULL,
    JsonBody   TEXT,
    RetryCount INTEGER DEFAULT 0,
    CreatedAt  TEXT DEFAULT (datetime('now'))
);

PRAGMA foreign_keys = ON;
DETACH DATABASE source;</sql><current_tab id="0"/></tab_sql></sqlb_project>
