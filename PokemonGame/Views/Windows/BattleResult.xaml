<Window
    x:Class="PokemonGame.Views.Windows.BattleResult"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:converters="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="350"
    Height="350"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:IsNegativeConverter x:Key="IsNegativeConverter" />
    </Window.Resources>
    <Grid>
        <controls:BoardBackground>
            <Viewbox>
                <Grid Width="300" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  Header  -->
                        <RowDefinition Height="Auto" />
                        <!--  Subtitle  -->
                        <RowDefinition Height="Auto" />
                        <!--  Rank  -->
                        <RowDefinition Height="Auto" />
                        <!--  Progress  -->
                        <RowDefinition Height="Auto" />
                        <!--  Time  -->
                        <RowDefinition Height="*" />
                        <!--  Spacer  -->
                        <RowDefinition Height="Auto" />
                        <!--  Buttons  -->
                    </Grid.RowDefinitions>

                    <!--  Header: winner text  -->
                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="{Binding WinnerText}" />

                    <!--  Subtitle: result method  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,5,0,10"
                        HorizontalAlignment="Center"
                        Foreground="#B0B0B0"
                        Text="{Binding ResultMethod}" />

                    <!--  Rank section  -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock
                            FontSize="14"
                            Foreground="Black"
                            Text="{Binding RankLabel}" />

                        <TextBlock
                            FontSize="26"
                            FontWeight="Bold"
                            Text="{Binding RankName}" />

                        <TextBlock
                            Margin="0,5,0,10"
                            FontSize="30"
                            FontWeight="Bold"
                            Text="{Binding RankDeltaText}">
                            <TextBlock.Foreground>
                                <Binding Path="RankDeltaColor" />
                            </TextBlock.Foreground>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RankDelta, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                            <Setter Property="Foreground" Value="#E53935" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RankDelta, Converter={StaticResource IsNegativeConverter}}" Value="False">
                                            <Setter Property="Foreground" Value="#4CAF50" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!--  Progress section  -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <Border
                            Height="12"
                            Background="#3A3D4F"
                            CornerRadius="10">
                            <Border
                                Width="{Binding ProgressBarWidth}"
                                HorizontalAlignment="Left"
                                Background="#4A90E2"
                                CornerRadius="10" />
                        </Border>

                        <DockPanel Margin="0,5,0,0">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Foreground="#CCCCCC"
                                Text="RANKED RATING" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Foreground="#CCCCCC"
                                Text="{Binding RatingText}" />
                        </DockPanel>
                    </StackPanel>

                    <!--  Time section (extend as needed)  -->
                    <StackPanel
                        Grid.Row="4"
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal" />

                    <!--  Buttons  -->
                    <StackPanel Grid.Row="6">
                        <Button
                            Height="45"
                            Margin="0,5"
                            BorderThickness="0"
                            Command="{Binding NewGameCommand}"
                            Content="new game"
                            FontSize="16"
                            Foreground="White">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#7ED957" />
                                    <GradientStop Offset="1" Color="#4CAF50" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Height="40"
                                Margin="5"
                                Background="#3A3D4F"
                                BorderThickness="0"
                                Command="{Binding BackCommand}"
                                Content="back"
                                Foreground="White" />

                            <Button
                                Grid.Column="1"
                                Height="40"
                                Margin="5"
                                Background="#3A3D4F"
                                BorderThickness="0"
                                Command="{Binding RematchCommand}"
                                Content="Rematch"
                                Foreground="White" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </controls:BoardBackground>
    </Grid>
</Window>
