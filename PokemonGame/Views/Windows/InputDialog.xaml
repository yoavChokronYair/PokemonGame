<Window
    x:Class="PokemonGame.Views.Windows.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding TitleText}"
    Width="400"
    Height="180"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Message  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="14"
            Text="{Binding Message}"
            TextWrapping="Wrap" />

        <!--  Input box  -->
        <TextBox
            Grid.Row="1"
            Height="30"
            FontSize="14"
            Text="{Binding ResponseText}" />

        <!--  Buttons  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="75"
                Margin="5"
                Click="Ok_Click"
                Content="OK"
                IsDefault="True" />
            <Button
                Width="75"
                Margin="5"
                Content="Cancel"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
