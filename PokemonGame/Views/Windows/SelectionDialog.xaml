<Window
    x:Class="PokemonGame.Views.Windows.SelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Select Option"
    Width="400"
    Height="300"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Message  -->
        <TextBlock
            x:Name="MessageTextBlock"
            Margin="0,0,0,10"
            FontSize="16"
            Text="Message"
            TextWrapping="Wrap" />

        <!--  Options list  -->
        <ListBox
            x:Name="OptionsListBox"
            Grid.Row="1"
            Margin="0,0,0,10"
            SelectionMode="Single" />

        <!--  Buttons  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="75"
                Margin="5,0,0,0"
                Click="Cancel_Click"
                Content="Cancel" />
            <Button
                Width="75"
                Margin="5,0,0,0"
                Click="Ok_Click"
                Content="OK" />
        </StackPanel>
    </Grid>
</Window>
