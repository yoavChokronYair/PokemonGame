<UserControl
    x:Class="PokemonGame.Views.UserControls.PokemonTeamUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:TypeToImageConverter x:Key="TypeToImage" />
        <conv:PokemonIdToImageConverter x:Key="PokemonToImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:ThirdOfHeightConverter x:Key="ThirdOfHeightConverter" />

    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!--  2 columns, 3 rows — scales with the control's size  -->
                <UniformGrid Columns="3" Rows="2" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border
                    Margin="4"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">

                    <!--  EMPTY SLOT  -->
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#CCCCCC"
                            Text="—"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                        <!--  FILLED SLOT  -->
                        <StackPanel
                            Margin="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!--  Sprite — sizes to whatever the control is  -->
                            <Image
                                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource ThirdOfHeightConverter}}"
                                HorizontalAlignment="Center"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding PokedexId, Converter={StaticResource PokemonToImage}, Mode=OneWay}"
                                Stretch="Uniform" />

                            <!--  Name  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  Types  -->
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image
                                    Width="36"
                                    Height="12"
                                    Margin="0,2,2,0"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding Type1, Converter={StaticResource TypeToImage}}" />
                                <Image
                                    Width="36"
                                    Height="12"
                                    Margin="0,2,0,0"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding Type2, Converter={StaticResource TypeToImage}}"
                                    Visibility="{Binding Type2, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>