<UserControl
    x:Class="PokemonGame.Views.UserControls.PokemonPickerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <Border
        Width="700"
        MaxHeight="300"
        HorizontalAlignment="Left"
        Background="White"
        BorderBrush="#4A90D9"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Padding="10,6"
                Background="#F0F4FF"
                BorderBrush="#CCD8F0"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#333"
                    Text="Choose Pokémon" />
            </Border>

            <!--  Column headers  -->
            <Border
                Grid.Row="1"
                Padding="10,4"
                Background="#F9F9F9"
                BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="#" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Name" />
                    <TextBlock
                        Grid.Column="3"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Type" />
                    <TextBlock
                        Grid.Column="4"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Abilities" />
                    <TextBlock
                        Grid.Column="5"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="HP   Atk   Def   SpA   SpD   Spe   BST" />
                </Grid>
            </Border>

            <!--
                SelectedItem binds to PickerPokemon on the VM.
                The setter auto-calls ConfirmPokemonCommand → clones + adds to team + closes.
            -->
            <ListBox
                Grid.Row="2"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding AllPokemon}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding PickerPokemon, Mode=TwoWay}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="BorderBrush" Value="#EEEEEE" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F0FE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D0E4FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="#AAA"
                                Text="{Binding PokedexId}" />
                            <Image
                                Grid.Column="1"
                                Width="28"
                                Height="28"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding SpriteImage}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#222"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <ItemsControl
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Types}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="1,0"
                                            Padding="4,1"
                                            Background="{Binding Color}"
                                            CornerRadius="3">
                                            <TextBlock
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#444"
                                    Text="{Binding AbilityPrimary}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="10"
                                    FontStyle="Italic"
                                    Foreground="#888"
                                    Text="{Binding AbilityHidden}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <UniformGrid
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                Columns="7">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="{Binding HP}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="{Binding Atk}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="{Binding Def}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="{Binding SpA}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="{Binding SpD}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="{Binding Spe}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#333"
                                    Text="{Binding BST}" />
                            </UniformGrid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
