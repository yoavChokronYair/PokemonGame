<UserControl
    x:Class="PokemonGame.Views.UserControls.PokemonPickerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="700"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:TypeToImageConverter x:Key="TypeToImage" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

    </UserControl.Resources>

    <Border
        Width="700"
        MaxHeight="300"
        HorizontalAlignment="Left"
        Background="White"
        BorderBrush="#4A90D9"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Padding="10,6"
                Background="#F0F4FF"
                BorderBrush="#CCD8F0"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#333"
                    Text="Choose Pokémon" />
            </Border>
            <Border
                Grid.Row="1"
                Padding="8,5"
                Background="White"
                BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1">
                <TextBox
                    Height="24"
                    Padding="6,3"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    FontSize="11"
                    Text="{Binding PokemonSearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush
                                    x:Key="HintBrush"
                                    AlignmentX="Left"
                                    AlignmentY="Center"
                                    Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="11"
                                            Foreground="#AAAAAA"
                                            Text="🔍 Search items..." />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>
            <!--  Column headers  -->
            <Border
                Grid.Row="2"
                Padding="10,4"
                Background="#F9F9F9"
                BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="#" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Name" />
                    <TextBlock
                        Grid.Column="3"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Type" />
                    <TextBlock
                        Grid.Column="4"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Abilities" />
                    <TextBlock
                        Grid.Column="5"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="HP   Atk   Def   SpA   SpD   Spe   BST" />
                </Grid>
            </Border>

            <!--
                SelectedItem binds to PickerPokemon on the VM.
                The setter auto-calls ConfirmPokemonCommand → clones + adds to team + closes.
            -->
            <ListBox
                Grid.Row="3"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding FilteredPokemons}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="BorderBrush" Value="#EEEEEE" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="White" />

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F0FE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D0E4FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding DataContext.ConfirmPokemonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="#AAA"
                                    Text="{Binding PokedexId}" />
                                <Image
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Source="{Binding SpriteImage}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#222"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Image
                                        Width="40"
                                        Height="14"
                                        Margin="0,0,2,0"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding Type1, Converter={StaticResource TypeToImage}}" />
                                    <Image
                                        Width="40"
                                        Height="14"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding Type2, Converter={StaticResource TypeToImage}}"
                                        Visibility="{Binding Type2, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#444"
                                        Text="{Binding AbilityPrimary}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10"
                                        FontStyle="Italic"
                                        Foreground="#888"
                                        Text="{Binding AbilityHidden}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <UniformGrid
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    Columns="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="#555"
                                        Text="{Binding HP}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="#555"
                                        Text="{Binding Atk}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="#555"
                                        Text="{Binding Def}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="#555"
                                        Text="{Binding SpA}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="#555"
                                        Text="{Binding SpD}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="#555"
                                        Text="{Binding Spe}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#333"
                                        Text="{Binding BST}" />
                                </UniformGrid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
