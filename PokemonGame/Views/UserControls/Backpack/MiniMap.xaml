<UserControl
    x:Class="PokemonGame.Views.UserControls.Backpack.MiniMap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.ViewModels.Converters;assembly=PokemonGame.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PokemonGame.ViewModels.Backpack;assembly=PokemonGame.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <vm:MiniMapViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <!--  Increase tile size  -->
        <conv:TileTypeToBrushConverter x:Key="TileTypeToBrushConverter" />
        <conv:TileToPixelConverter x:Key="TileToPixelConverter" TileSize="50" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource TileToPixelConverter}}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource TileToPixelConverter}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--  Increase Width/Height  -->
                    <Rectangle
                        Width="50"
                        Height="50"
                        Fill="{Binding Type, Converter={StaticResource TileTypeToBrushConverter}}"
                        Stroke="Gray"
                        StrokeThickness="0.5" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
