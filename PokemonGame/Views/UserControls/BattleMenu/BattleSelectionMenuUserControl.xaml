<UserControl
    x:Class="PokemonGame.Views.UserControls.BattleMenu.BattleSelectionMenuUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:PokemonGame.View.Behaviors"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:converter="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.UserControls.BattleMenu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="150"
    d:DesignWidth="800"
    Background="White"
    Focusable="False"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converter:MultiBoolToVisibilityConverter x:Key="MultiBoolToVis" />

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <local:LoggerUserControl
            Grid.Column="0"
            Grid.ColumnSpan="2"
            DataContext="{Binding DataContext.Logger, RelativeSource={RelativeSource AncestorType=Page}}" />

        <!--  Main menu: FIGHT / BAG / POKEMON / RUN  -->
        <controls:BoardBackground Grid.Column="1">
            <controls:BoardBackground.Visibility>
                <MultiBinding Converter="{StaticResource MultiBoolToVis}">
                    <Binding Path="IsMainMenuVisible" />
                    <Binding Path="Logger.AreActionsUnlocked" />
                </MultiBinding>
            </controls:BoardBackground.Visibility>

            <UniformGrid Columns="2" Rows="2">
                <Button
                    Command="{Binding OpenMenuCommand}"
                    Content="FIGHT"
                    Focusable="False" />
                <Button Content="BAG" Focusable="False" />
                <Button
                    Command="{Binding OpenSwitchCommand}"
                    Content="POKEMON"
                    Focusable="False" />
                <Button
                    Command="{Binding ForfeitCommand}"
                    Content="RUN"
                    Focusable="False" />
            </UniformGrid>
        </controls:BoardBackground>

        <!--  Move info panel (PP / TYPE + BACK button)  -->
        <controls:BoardBackground Grid.Column="1" Visibility="{Binding IsMovesetVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="10" VerticalAlignment="Center">
                <TextBlock FontSize="14" Text="{Binding SelectedMovePP}" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="14"
                    Text="{Binding SelectedMoveType}" />
                <Button
                    Margin="0,10,0,0"
                    Command="{Binding CloseMovesetCommand}"
                    Content="BACK" />
            </StackPanel>
        </controls:BoardBackground>

        <!--  Moveset chooser — DataContext passed down to MovesetChooser child VM  -->
        <local:BattlePokemonMovesetChooserUserControl
            Grid.Column="0"
            DataContext="{Binding MovesetChooser}"
            Visibility="{Binding DataContext.IsMovesetVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
