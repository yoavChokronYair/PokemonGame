<UserControl
    x:Class="PokemonGame.Views.UserControls.BattleMenu.EnemyBattleStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.UserControls.BattleMenu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="280"
    Height="80"
    mc:Ignorable="d">
    <Grid>
        <Image
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="pack://application:,,,/PokemonGame;component/Assets/Images/RivalPokemon.png"
            Stretch="Fill" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="101.2" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="13.8" />
                <RowDefinition Height="33.1" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Rectangle
                Grid.Row="2"
                Grid.Column="2"
                Width="134.4"
                Height="8.275"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{Binding HPColor}"
                RadiusX="4"
                RadiusY="4"
                RenderTransformOrigin="0,0.5">

                <Rectangle.RenderTransform>
                    <ScaleTransform ScaleX="{Binding AnimatedHpPercentage}" ScaleY="1" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Grid
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Text="{Binding PokemonName}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        Foreground="{Binding GenderColor}"
                        Text="{Binding GenderSymbol}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,2,0"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        Text="Lv" />
                    <TextBlock
                        Width="40"
                        Text="{Binding Level}"
                        TextAlignment="Left" />
                </StackPanel>
            </Grid>
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{Binding StatusCondition}" />
        </Grid>
    </Grid>
</UserControl>
