<UserControl
    x:Class="PokemonGame.Views.UserControls.DialogueBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:BoolToCloseNextConverter x:Key="BoolToCloseNextConverter" />
    </UserControl.Resources>
    <Border
        Padding="16,12"
        Background="#0D0D0D"
        BorderBrush="#4A7C4E"
        BorderThickness="2"
        CornerRadius="4"
        Visibility="{Binding Dialogue.IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">

        <StackPanel>

            <!--  Speaker name  -->
            <TextBlock
                Margin="0,0,0,6"
                FontFamily="Consolas"
                FontSize="11"
                FontWeight="Bold"
                Foreground="#4A7C4E"
                Text="{Binding Dialogue.SpeakerName}" />

            <!--  Dialogue text  -->
            <TextBlock
                Margin="0,0,0,10"
                FontFamily="Consolas"
                FontSize="11"
                Foreground="#CCCCCC"
                Text="{Binding Dialogue.Text}"
                TextWrapping="Wrap" />

            <!--  Choice buttons — visible only when HasChoices  -->
            <ItemsControl ItemsSource="{Binding Dialogue.Choices}" Visibility="{Binding Dialogue.HasChoices, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,3,0,0"
                            Padding="10,4"
                            HorizontalAlignment="Left"
                            Background="#1A1A1A"
                            BorderBrush="#333"
                            BorderThickness="1"
                            Content="{Binding Label}"
                            Cursor="Hand"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#AAAAAA">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#4A7C4E" />
                                            <Setter Property="Foreground" Value="#EEE" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Next / Close prompt — visible when no choices  -->
            <TextBlock
                HorizontalAlignment="Right"
                FontFamily="Consolas"
                FontSize="9"
                Foreground="#444"
                Visibility="{Binding Dialogue.HasChoices, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Run Text="{Binding Dialogue.IsLastLine, Converter={StaticResource BoolToCloseNextConverter}, Mode=OneWay}" />
                <Run Text=" [Z / Enter]" />
            </TextBlock>

        </StackPanel>
    </Border>
</UserControl>
