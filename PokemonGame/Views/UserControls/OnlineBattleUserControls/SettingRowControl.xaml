<UserControl
    x:Class="PokemonGame.Views.UserControls.OnlineBattleUserControls.SettingRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.UserControls.OnlineBattleUserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="Root"
    mc:Ignorable="d">
    <Grid Margin="0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Foreground="#D3812F"
            Text="{Binding Header, ElementName=Root}" />

        <Grid Grid.Column="1">
            <!--  STYLE A: The Horizontal List (Default)  -->
            <ListBox
                x:Name="StandardList"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Options, ElementName=Root}"
                SelectedItem="{Binding SelectedOption, ElementName=Root}">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseSelectorMode, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            x:Name="Txt"
                            Margin="10,0"
                            FontWeight="Bold"
                            Foreground="#777"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="#E53935" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  STYLE B: The Selector (Arrows + Single Text)  -->
            <StackPanel x:Name="SelectorMode" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseSelectorMode, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button
                    Width="30"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    Click="OnPrevClick"
                    Content="&lt;"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Viewbox
                    Width="90"
                    Height="25"
                    Stretch="Uniform">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="#E53935"
                        Text="{Binding SelectedOption.Name, ElementName=Root}"
                        TextAlignment="Center" />
                </Viewbox>

                <Button
                    Width="30"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    Click="OnNextClick"
                    Content="&gt;"
                    Cursor="Hand"
                    Foreground="Black">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
