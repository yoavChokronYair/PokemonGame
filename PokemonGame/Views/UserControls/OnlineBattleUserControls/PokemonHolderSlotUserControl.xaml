<UserControl
    x:Class="PokemonGame.Views.UserControls.OnlineBattleUserControls.PokemonHolderSlotUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.UserControls.OnlineBattleUserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="52"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:HpToWidthConverter x:Key="HpToWidthConverter" />
        <converters:PokemonIdToImageConverter x:Key="PokedexIdToSpriteConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="/PokemonGame;component/Assets/Images/TeamSelection/PokemonHolderNotSelected.png" Stretch="Fill" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <ImageBrush ImageSource="/PokemonGame;component/Assets/Images/TeamSelection/PokemonHolderSelected.png" Stretch="Fill" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!--  Content  -->
        <Grid Margin="48,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Pokemon sprite  -->
            <Image
                Grid.Column="0"
                Width="40"
                Height="40"
                Margin="-44,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Image.Source>
                    <Binding Converter="{StaticResource PokedexIdToSpriteConverter}" Path="PokedexId" />
                </Image.Source>
            </Image>

            <!--  Name + Level  -->
            <StackPanel
                Grid.Column="0"
                Margin="4,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                    FontFamily="/PokemonGame;component/Assets/Fonts/#Pokemon GB"
                    FontSize="10"
                    Foreground="Black"
                    Text="{Binding PokemonName}" />
                <TextBlock
                    FontFamily="/PokemonGame;component/Assets/Fonts/#Pokemon GB"
                    FontSize="8"
                    Foreground="Black"
                    Text="{Binding LevelText}" />
            </StackPanel>

            <!--  HP section  -->
            <Grid
                Grid.Column="1"
                Width="140"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  HP bar track  -->
                <Grid
                    Grid.Row="1"
                    Width="120"
                    Height="7"
                    Margin="16,1,0,1"
                    HorizontalAlignment="Left">
                    <Rectangle
                        Fill="#383030"
                        RadiusX="2"
                        RadiusY="2" />
                    <Rectangle
                        HorizontalAlignment="Left"
                        Fill="{Binding HPColor}"
                        RadiusX="2"
                        RadiusY="2"
                        RenderTransformOrigin="0,0.5">
                        <Rectangle.Width>
                            <MultiBinding Converter="{StaticResource HpToWidthConverter}" ConverterParameter="120">
                                <Binding Path="CurrentHp" />
                                <Binding Path="MaxHp" />
                            </MultiBinding>
                        </Rectangle.Width>
                    </Rectangle>
                </Grid>

                <!--  HP numbers  -->
                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    FontFamily="/PokemonGame;component/Assets/Fonts/#Pokemon GB"
                    FontSize="8"
                    Foreground="Black"
                    Text="{Binding HpText}" />
            </Grid>
        </Grid>

        <!--  Full-area click overlay — last child = on top  -->
        <Button
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Panel.ZIndex="99"
            Command="{Binding SelectCommand}"
            Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>