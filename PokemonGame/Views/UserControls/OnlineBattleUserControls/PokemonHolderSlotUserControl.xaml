<UserControl
    x:Class="PokemonGame.Views.UserControls.OnlineBattleUserControls.PokemonHolderSlotUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="396"
    Height="74"
    d:DesignHeight="74"
    d:DesignWidth="396"
    Focusable="False"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:PokemonIdToImageConverter x:Key="PokedexIdToSpriteConverter" />

        <Style x:Key="PokemonContentStyle" TargetType="Canvas">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MaxHp}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <DataTrigger Binding="{Binding PokedexId}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid
        Width="396"
        Height="74"
        ClipToBounds="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor">

        <!--  Background only  -->
        <Image
            Width="396"
            Height="74"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Stretch="Fill">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Source" Value="/PokemonGame;component/Assets/Images/TeamSelection/PokemonHolderNotSelected.png" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Source" Value="/PokemonGame;component/Assets/Images/TeamSelection/PokemonHolderSelected.png" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <!--  Fixed drawing layer  -->
        <Canvas
            Width="396"
            Height="74"
            Style="{StaticResource PokemonContentStyle}">

            <!--  Sprite  -->
            <Image
                Canvas.Left="35"
                Canvas.Top="13"
                Width="40"
                Height="40"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Stretch="Uniform">
                <Image.Source>
                    <Binding Converter="{StaticResource PokedexIdToSpriteConverter}" Path="PokedexId" />
                </Image.Source>
            </Image>

            <!--  NAME + LEVEL TOGETHER  -->
            <StackPanel
                Canvas.Left="92"
                Canvas.Top="10"
                Height="14"
                Orientation="Horizontal">

                <TextBlock
                    MaxWidth="110"
                    FontFamily="/PokemonGame;component/Assets/Fonts/#Pokemon GB"
                    FontSize="7"
                    Foreground="Black"
                    Text="{Binding PokemonName}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Padding="6,0,0,0"
                    FontFamily="/PokemonGame;component/Assets/Fonts/#Pokemon GB"
                    FontSize="7"
                    Foreground="Black"
                    Text="{Binding LevelText}" />

            </StackPanel>

            <!--  HP fill only  -->
            <Rectangle
                Canvas.Left="282"
                Canvas.Top="25"
                Height="6"
                MinWidth="1"
                Fill="{Binding HPColor}"
                RadiusX="1"
                RadiusY="1">
                <Rectangle.Width>
                    <Binding Path="HolderHpFillWidth" />
                </Rectangle.Width>
            </Rectangle>

            <!--  HP numbers  -->
            <TextBlock
                Canvas.Left="310"
                Canvas.Top="55"
                Width="60"
                Height="10"
                FontFamily="/PokemonGame;component/Assets/Fonts/#Pokemon GB"
                FontSize="6"
                Foreground="Black"
                Text="{Binding HpText}"
                TextAlignment="Right" />

        </Canvas>

        <!--  Invisible click layer  -->
        <Button
            Width="396"
            Height="74"
            Panel.ZIndex="99"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding SelectCommand}"
            Cursor="Hand"
            Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</UserControl>