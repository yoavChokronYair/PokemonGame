<UserControl
    x:Class="PokemonGame.Views.UserControls.OnlineBattleUserControls.PokemonTeamUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:TypeToImageConverter x:Key="TypeToImage" />
        <conv:PokemonIdToImageConverter x:Key="PokemonToImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:ThirdOfHeightConverter x:Key="ThirdOfHeightConverter" />
        <conv:NameToImageConverter x:Key="NameToImage" />

    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!--  2 columns, 3 rows — scales with the control's size  -->
                <UniformGrid Columns="2" Rows="3" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border
                    Margin="4"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <!--  EMPTY SLOT PLACEHOLDER  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#CCCCCC"
                            Text="—"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                        <!--  FILLED SLOT CONTENT  -->
                        <Grid Margin="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!--  1. Main Pokemon Image: Scales to fit the entire border  -->
                            <Image
                                Margin="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding PokedexId, Converter={StaticResource PokemonToImage}}"
                                Stretch="Uniform" />

                            <!--  2. Held Item Image: Fixed small size in the bottom-right  -->
                            <Image
                                Width="24"
                                Height="24"
                                Margin="0,0,4,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding HeldItemName, Converter={StaticResource NameToImage}}"
                                Stretch="Uniform">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <!--  Hide the icon if no item name is provided  -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeldItemName}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HeldItemName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>