<UserControl
    x:Class="PokemonGame.Views.UserControls.OnlineBattleUserControls.MainPokemonSlotUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="302"
    Height="244"
    d:DesignHeight="244"
    d:DesignWidth="302"
    Focusable="False"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:HpToWidthConverter x:Key="HpToWidthConverter" />
        <converters:PokemonIdToImageConverter x:Key="PokedexIdToSpriteConverter" />

        <!--
            Hide only the content when the slot is empty.
            The card background stays visible.
        -->
        <Style x:Key="PokemonContentStyle" TargetType="Canvas">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MaxHp}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <DataTrigger Binding="{Binding PokedexId}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid
        Width="302"
        Height="244"
        ClipToBounds="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor">

        <!--  Card background only  -->
        <Image
            Width="302"
            Height="244"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Stretch="Fill">

            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Source" Value="/PokemonGame;component/Assets/Images/TeamSelection/MainPokemonNotSelected.png" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Source" Value="/PokemonGame;component/Assets/Images/TeamSelection/MainPokemonSelected.png" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <!--  Fixed drawing layer  -->
        <Canvas
            Width="302"
            Height="244"
            Style="{StaticResource PokemonContentStyle}">

            <!--  Pokémon sprite  -->
            <Image
                Canvas.Left="42"
                Canvas.Top="56"
                Width="58"
                Height="58"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Stretch="Uniform">

                <Image.Source>
                    <Binding Converter="{StaticResource PokedexIdToSpriteConverter}" Path="PokedexId" />
                </Image.Source>
            </Image>

            <!--
                Name + level together.
                Level will always stay directly after the name.
            -->
            <StackPanel
                Canvas.Left="50"
                Canvas.Top="140"
                Height="16"
                Orientation="Horizontal">

                <TextBlock
                    MaxWidth="92"
                    FontFamily="/PokemonGame;component/Assets/Fonts/#Pokemon GB"
                    FontSize="16"
                    Foreground="Black"
                    Text="{Binding PokemonName}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Margin="60,0,0,0"
                    Padding="6,0,0,0"
                    FontFamily="/PokemonGame;component/Assets/Fonts/#Pokemon GB"
                    FontSize="16"
                    Foreground="Black"
                    Text="{Binding LevelText}" />
            </StackPanel>

            <!--
                HP fill only.
                The background image already has the HP frame.
            -->
            <Rectangle
                Canvas.Left="110"
                Canvas.Top="175"
                Height="7"
                MinWidth="1"
                Fill="{Binding HPColor}"
                RadiusX="1"
                RadiusY="1">

                <Rectangle.Width>
                    <Binding Path="MainHpFillWidth" />
                </Rectangle.Width>
            </Rectangle>

            <!--  HP numbers bottom-right  -->
            <TextBlock
                Canvas.Left="150"
                Canvas.Top="195"
                Width="68"
                Height="14"
                FontFamily="/PokemonGame;component/Assets/Fonts/#Pokemon GB"
                FontSize="16"
                Foreground="Black"
                Text="{Binding HpText}"
                TextAlignment="Right" />

        </Canvas>

        <!--  Invisible click layer  -->
        <Button
            Width="302"
            Height="244"
            Panel.ZIndex="99"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding SelectCommand}"
            Cursor="Hand"
            Focusable="False">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</UserControl>