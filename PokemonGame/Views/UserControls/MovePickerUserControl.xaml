<UserControl
    x:Class="PokemonGame.Views.UserControls.MovePickerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="160"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <Border
        Width="700"
        Padding="10,8"
        HorizontalAlignment="Left"
        Background="White"
        BorderBrush="#4A90D9"
        BorderThickness="1"
        CornerRadius="4">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,6"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#333">
                <Run Text="Pick Move " />
                <Run Foreground="#4A90D9" Text="{Binding ActiveMoveSlot}" />
                <Run Text=" — " />
                <Run Foreground="#4A90D9" Text="{Binding SelectedPokemon.Name}" />
            </TextBlock>

            <!--
                SelectedItem binds two-way to SelectedMove.
                The SelectedMove setter in the VM auto-calls ConfirmMoveCommand,
                which assigns the move to the right slot and closes the picker.
                No CommandParameter needed anywhere.
            -->
            <ListBox
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding SelectedPokemon.AvailableMoves}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedMove, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="3" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="#F0F4FF" />
                        <Setter Property="BorderBrush" Value="#A0B8E0" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#4A90D9" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderBrush" Value="#4A90D9" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#4A90D9" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="11" Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
