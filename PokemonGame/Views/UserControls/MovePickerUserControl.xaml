<UserControl
    x:Class="PokemonGame.Views.UserControls.MovePickerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="320"
    d:DesignWidth="860"
    mc:Ignorable="d">

    <Border
        Width="860"
        MaxHeight="320"
        HorizontalAlignment="Left"
        Background="White"
        BorderBrush="#4A90D9"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Padding="10,6"
                Background="#F0F4FF"
                BorderBrush="#CCD8F0"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#333">
                    <Run Text="Pick Move " />
                    <Run Foreground="#4A90D9" Text="{Binding ActiveMoveSlot}" />
                    <Run Text=" — " />
                    <Run Foreground="#4A90D9" Text="{Binding SelectedPokemon.Name, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <!--  Search box  -->
            <Border
                Grid.Row="1"
                Padding="8,5"
                Background="White"
                BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1">
                <TextBox
                    Height="24"
                    Padding="6,3"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    FontSize="11"
                    Text="{Binding MoveSearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush
                                    x:Key="HintBrush"
                                    AlignmentX="Left"
                                    AlignmentY="Center"
                                    Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="11"
                                            Foreground="#AAAAAA"
                                            Text="🔍 Search moves..." />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>

            <!--  Column headers  -->
            <Border
                Grid.Row="2"
                Padding="10,4"
                Background="#F9F9F9"
                BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Name" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Type" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Category" />
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Pow" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Acc" />
                    <TextBlock
                        Grid.Column="5"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="PP" />
                    <TextBlock
                        Grid.Column="6"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Effect" />
                </Grid>
            </Border>

            <!--  List  -->
            <ListBox
                Grid.Row="3"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding FilteredMoves}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedMove, Mode=TwoWay}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="BorderBrush" Value="#EEEEEE" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F0FE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D0E4FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#222"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />

                            <Border
                                Grid.Column="1"
                                Margin="2,0"
                                Padding="6,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{Binding TypeColor}"
                                CornerRadius="3">
                                <TextBlock
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding TypeName}" />
                            </Border>

                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="#555"
                                Text="{Binding Category}" />

                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="#333"
                                Text="{Binding PowerDisplay}" />

                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="#333"
                                Text="{Binding AccuracyDisplay}" />

                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="#333"
                                Text="{Binding PP}" />

                            <TextBlock
                                Grid.Column="6"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="#555"
                                Text="{Binding Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
