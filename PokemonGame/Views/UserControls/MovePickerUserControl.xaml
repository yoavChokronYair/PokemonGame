<UserControl
    x:Class="PokemonGame.Views.UserControls.MovePickerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border
        Width="800"
        MaxHeight="300"
        HorizontalAlignment="Left"
        Background="White"
        BorderBrush="#4A90D9"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Padding="10,6"
                Background="#F0F4FF"
                BorderBrush="#CCD8F0"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#333">
                    <Run Text="Pick Move " />
                    <Run Foreground="#4A90D9" Text="{Binding ActiveMoveSlot}" />
                    <Run Text=" — " />
                    <Run Foreground="#4A90D9" Text="{Binding SelectedPokemon.Name, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <!--  Column headers  -->
            <Border
                Grid.Row="1"
                Padding="10,4"
                Background="#F9F9F9"
                BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Name" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Type" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Cat" />
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Pow" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Acc" />
                    <TextBlock
                        Grid.Column="5"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="PP" />
                    <TextBlock
                        Grid.Column="6"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#555"
                        Text="Effect" />
                </Grid>
            </Border>

            <!--
                SelectedItem binds two-way to SelectedMove.
                The SelectedMove setter in the VM auto-calls ConfirmMoveCommand,
                which assigns the move to the right slot and closes the picker.
            -->
            <ListBox
                Grid.Row="2"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding SelectedPokemon.AvailableMoves}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedMove, Mode=TwoWay}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="BorderBrush" Value="#EEEEEE" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F0FE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D0E4FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <!--  Move Name  -->
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#222"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  Type badge  -->
                            <Border
                                Grid.Column="1"
                                Margin="2,0"
                                Padding="5,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{Binding TypeColor}"
                                CornerRadius="3">
                                <TextBlock
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding TypeName}" />
                            </Border>

                            <!--  Category icon  -->
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="#555"
                                Text="{Binding Category}" />

                            <!--  Power  -->
                            <StackPanel
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="8"
                                    Foreground="#888"
                                    Text="Power" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="{Binding Power}" />
                            </StackPanel>

                            <!--  Accuracy  -->
                            <StackPanel
                                Grid.Column="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="8"
                                    Foreground="#888"
                                    Text="Accuracy" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="{Binding Accuracy}" />
                            </StackPanel>

                            <!--  PP  -->
                            <StackPanel
                                Grid.Column="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="8"
                                    Foreground="#888"
                                    Text="PP" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="{Binding PP}" />
                            </StackPanel>

                            <!--  Effect description  -->
                            <TextBlock
                                Grid.Column="6"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="#555"
                                Text="{Binding Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>