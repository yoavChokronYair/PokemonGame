<UserControl
    x:Class="PokemonGame.Views.UserControls.PokemonBattle.PokemonBattleMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:PokemonBattle="clr-namespace:PokemonGame.Views.UserControls.PokemonBattle"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:PokemonGame.Views.UserControls.PokemonBattle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PokemonGame.ViewModel"
    d:DesignHeight="150"
    d:DesignWidth="900"
    Background="Black"
    Focusable="True"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding
            Key="Up"
            Command="{Binding DirectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="Up" />
        <KeyBinding
            Key="Down"
            Command="{Binding DirectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="Down" />
        <KeyBinding
            Key="Left"
            Command="{Binding DirectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="Left" />
        <KeyBinding
            Key="Right"
            Command="{Binding DirectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="Right" />
        <KeyBinding Key="Enter" Command="{Binding ConfirmMoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500*" />
            <ColumnDefinition Width="400*" />
        </Grid.ColumnDefinitions>
        <Viewbox Grid.Column="0" Stretch="Uniform">
            <controls:BoardBackground
                Width="500"
                Height="150"
                BackgroundType="{Binding BackgroundType, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Viewbox>
        <Viewbox Grid.Column="1" Stretch="Uniform">
            <controls:BoardBackground
                Width="400"
                Height="150"
                BackgroundType="{Binding BackgroundType, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel>
                    <UniformGrid>
                        <Button
                            Name="Fight"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="{Binding FightText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Cursor="Hand"
                            FontSize="20">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Width="200"
                                        Height="40"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button
                            x:Name="Bag"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="{Binding BagText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Cursor="Hand"
                            FontSize="20">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Width="200"
                                        Height="40"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>
                        <Button
                            x:Name="Pokemon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="{Binding PokemonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Cursor="Hand"
                            FontSize="20">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Width="200"
                                        Height="40"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button
                            Name="Run"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="{Binding RunText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Cursor="Hand"
                            FontSize="20">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Width="150"
                                        Height="40"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </controls:BoardBackground>

        </Viewbox>
    </Grid>
</UserControl>
