<UserControl
    x:Class="PokemonGame.Views.UserControls.PokemonBattle.BattleMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.UserControls.PokemonBattle"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="150"
    d:DesignWidth="900"
    Background="Black"
    mc:Ignorable="d">
    <Grid>
        <Viewbox Stretch="Uniform">
            <StackPanel Orientation="Horizontal">
                <Viewbox Stretch="Uniform">
                    <controls:BoardBackground
                        Width="600"
                        Height="150"
                        BackgroundType="White">
                        <UniformGrid>
                            <TextBlock
                                Name="FirstMove"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Text="{Binding Move1, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Text="{Binding Move2, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Text="{Binding Move3, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                
                                Text="{Binding Move4, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </UniformGrid>
                    </controls:BoardBackground>
                </Viewbox>
                <Viewbox Stretch="Uniform">
                    <controls:BoardBackground
                        Width="300"
                        Height="150"
                        BackgroundType="White" />

                </Viewbox>
            </StackPanel>
        </Viewbox>
        <Viewbox
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="3"
            Stretch="Uniform">
            <Canvas Width="280" Height="120">
                <TextBlock
                    Name="currentPP"
                    Canvas.Left="146"
                    Canvas.Top="19"
                    Width="42"
                    Height="31"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                    Text="{Binding CurrentPP, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock
                    Name="maxPP"
                    Canvas.Left="211"
                    Canvas.Top="20"
                    Width="42"
                    Height="31"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                    Text="{Binding MaxPP, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock
                    Name="type"
                    Canvas.Left="118"
                    Canvas.Top="78"
                    Width="100"
                    Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                    Text="{Binding Type, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            </Canvas>
        </Viewbox>

    </Grid>
</UserControl>
