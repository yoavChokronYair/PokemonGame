<UserControl
    x:Class="PokemonGame.Views.UserControls.PokemonBattle.BattleMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.PokemonBattle"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="150"
    d:DesignWidth="800"
    Focusable="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17" />
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="282" />
            <ColumnDefinition Width="0*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="12*" />
            <RowDefinition Height="60*" />
            <RowDefinition Height="60*" />
            <RowDefinition Height="14*" />
        </Grid.RowDefinitions>
        <Image
            Grid.RowSpan="4"
            Grid.ColumnSpan="4"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="D:\PokemonGame\PokemonGame\Images\PokemonMoveSet.png"
            Stretch="Fill" />
        <TextBlock
            Name="FirstMove"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Cursor="Hand"
            Focusable="True"
            FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
            Text="{Binding Move1, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Cursor="Hand"
            FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
            Text="{Binding Move2, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Cursor="Hand"
            FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
            Text="{Binding Move3, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Cursor="Hand"
            FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
            Text="{Binding Move4, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Viewbox
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="3"
            Stretch="Uniform">
            <Canvas Width="280" Height="120">
                <TextBlock
                    Name="currentPP"
                    Canvas.Left="146"
                    Canvas.Top="19"
                    Width="42"
                    Height="31"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                    Text="{Binding CurrentPP, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock
                    Name="maxPP"
                    Canvas.Left="211"
                    Canvas.Top="20"
                    Width="42"
                    Height="31"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                    Text="{Binding MaxPP, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock
                    Name="type"
                    Canvas.Left="118"
                    Canvas.Top="78"
                    Width="100"
                    Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                    Text="{Binding Type, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
