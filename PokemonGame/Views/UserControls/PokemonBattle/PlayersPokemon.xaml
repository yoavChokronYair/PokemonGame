<UserControl
    x:Class="PokemonGame.Views.UserControls.PokemonBattle.PlayersPokemon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.UserControls.PokemonBattle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="128"
    d:DesignWidth="360"
    mc:Ignorable="d">
    <Grid>
        <Viewbox Stretch="Uniform">
            <Image
                Width="360"
                Height="128"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Source="/Images/TeamPokemon.png"
                Stretch="Fill" />
        </Viewbox>
        <Viewbox Stretch="Uniform">
            <Canvas Width="360" Height="128">
                <Viewbox
                    Canvas.Left="64"
                    Canvas.Top="12"
                    Stretch="Uniform">

                    <StackPanel Height="32" Orientation="Horizontal">
                        <Viewbox Stretch="Uniform">

                            <TextBlock
                                Height="32"
                                FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                                FontSize="22"
                                Text="{Binding NameText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                TextOptions.TextRenderingMode="Aliased" />
                        </Viewbox>

                        <Viewbox Stretch="Uniform">
                            <TextBlock
                                Height="32"
                                FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                                FontSize="22"
                                Text="{Binding GenderSymbol, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                TextOptions.TextRenderingMode="Aliased" />
                        </Viewbox>
                    </StackPanel>

                </Viewbox>
                <Viewbox
                    Canvas.Left="310"
                    Canvas.Top="10"
                    Width="30"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                        FontSize="16"
                        Text="{Binding LevelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        TextOptions.TextRenderingMode="Aliased" />
                </Viewbox>
                <Viewbox
                    Canvas.Left="166"
                    Canvas.Top="59"
                    Width="167"
                    Height="10"
                    Stretch="Uniform">
                    <local:HPBar
                        x:Name="MyHPBar"
                        Width="167"
                        Height="10"
                        AnimationDuration="0:0:1"
                        BarHeight="10"
                        BarWidth="167" />


                </Viewbox>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
