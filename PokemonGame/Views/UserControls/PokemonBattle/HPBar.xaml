<UserControl
    x:Class="PokemonGame.Views.UserControls.PokemonBattle.HPBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.UserControls.PokemonBattle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="{Binding BarHeight}"
    d:DesignWidth="{Binding BarWidth}"
    mc:Ignorable="d">

    <Grid>
        <Border
            x:Name="BackgroundBar"
            Width="{Binding BarWidth}"
            Height="{Binding BarHeight}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#4a415a" />
                    <GradientStop Offset="0.125" Color="#4a445a" />
                    <GradientStop Offset="0.1875" Color="#4e5a5a" />
                    <GradientStop Offset="0.9375" Color="#52695a" />
                    <GradientStop Offset="1" Color="#546a5c" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border
            x:Name="FillBar"
            Width="{Binding BarWidth}"
            Height="{Binding BarHeight}"
            HorizontalAlignment="Left">
            <Border.Background>
                <LinearGradientBrush x:Name="FillGradient" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#5ad384" />
                    <GradientStop Offset="0.125" Color="#5cd687" />
                    <GradientStop Offset="0.1875" Color="#69ec9d" />
                    <GradientStop Offset="0.9375" Color="#73fbad" />
                    <GradientStop Offset="1" Color="#9efbc6" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
