<UserControl
    x:Class="PokemonGame.Views.PokemonBattle.OpponentPokemon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.PokemonBattle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="325"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" />
            <ColumnDefinition Width="106*" />
            <ColumnDefinition Width="110*" />
            <ColumnDefinition Width="30*" />
            <ColumnDefinition Width="18*" />
            <ColumnDefinition Width="41*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="12" />
            <RowDefinition Height="12" />
            <RowDefinition />

        </Grid.RowDefinitions>
        <Image
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Grid.ColumnSpan="6"
            Source="/Images/RivalPokemon.png"
            Stretch="Fill" />
        <ProgressBar
            Grid.Row="2"
            Grid.Column="2"
            Grid.ColumnSpan="3"
            Height="10"
            BorderBrush="#4a4858"
            Foreground="Green"
            Maximum="{Binding MaxHP}"
            Minimum="0"
            Value="{Binding CurrentHP}" />

        <StackPanel
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Orientation="Horizontal">
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding NameText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{Binding GenderSymbol, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
        <TextBlock
            Grid.Column="4"
            VerticalAlignment="Bottom"
            FontSize="18"
            Text="{Binding LevelText, RelativeSource={RelativeSource AncestorType=UserControl}}" />

    </Grid>
</UserControl>
