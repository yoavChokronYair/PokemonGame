<UserControl
    x:Class="PokemonGame.Views.PokemonBattle.OpponentPokemon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.PokemonBattle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:PokemonGame.ViewModel"
    d:DesignHeight="128"
    d:DesignWidth="360"
    mc:Ignorable="d">
    <Grid>
        <Viewbox Stretch="Uniform">
            <Image
                Width="360"
                Height="128"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Source="/Images/RivalPokemon.png"
                Stretch="Fill" />
        </Viewbox>
        <Viewbox Stretch="Uniform">
            <Canvas Width="360" Height="128">
                <Viewbox
                    Canvas.Left="32"
                    Canvas.Top="24"
                    Stretch="Uniform">

                    <StackPanel Height="32" Orientation="Horizontal">
                        <Viewbox Stretch="Uniform">

                            <TextBlock
                                Height="32"
                                FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                                FontSize="22"
                                Text="{Binding NameText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                TextOptions.TextRenderingMode="Aliased" />
                        </Viewbox>

                        <Viewbox Stretch="Uniform">
                            <TextBlock
                                Height="32"
                                FontSize="22"
                                Text="{Binding GenderSymbol, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                TextOptions.TextRenderingMode="Aliased" />
                        </Viewbox>
                    </StackPanel>

                </Viewbox>
                <Viewbox
                    Canvas.Left="290"
                    Canvas.Top="10"
                    Width="32"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Stretch="Uniform">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontFamily="pack://application:,,,/Fonts/#Pokemon Classic"
                        FontSize="16"
                        Text="{Binding LevelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        TextOptions.TextRenderingMode="Aliased" />
                </Viewbox>
                <Viewbox
                    Canvas.Left="140"
                    Canvas.Top="75"
                    Width="173"
                    Height="15"
                    Stretch="Uniform">
                    <local:HPBar
                        x:Name="MyHPBarOp"
                        Width="173"
                        Height="15"
                        AnimationDuration="0:0:0.2"
                        BarHeight="15"
                        BarWidth="173"
                        HealthPercent="{Binding HealthPercent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Loaded="MyHPBar_Loaded" />

                </Viewbox>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
