<UserControl
    x:Class="PokemonGameModel.Views.ItemsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGameModel.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="29*" />
            <ColumnDefinition Width="87*" />
            <ColumnDefinition Width="179*" />
            <ColumnDefinition Width="29*" />
            <ColumnDefinition Width="450*" />
            <ColumnDefinition Width="26*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="21*" />
            <RowDefinition Height="273*" />
            <RowDefinition Height="134*" />
            <RowDefinition Height="22*" />
        </Grid.RowDefinitions>
        <Image
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Grid.ColumnSpan="6"
            Focusable="False"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="/Images/PokeBallsBackground.png"
            Stretch="Fill" />
        <Viewbox Grid.Row="1" Grid.Column="4">
            <ScrollViewer Width="450" Height="270">
                <ItemsControl ItemsSource="{Binding ItemViews}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  Customize this layout  -->
                            <StackPanel Margin="5" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Viewbox>
        <Viewbox
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Stretch="Uniform">
            <Image Width="45" Height="45" />
        </Viewbox>
    </Grid>
</UserControl>
