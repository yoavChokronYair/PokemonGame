<Page
    x:Class="PokemonGame.Views.MapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:PokemonGame.View.Behaviors"
    xmlns:converters="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:PokemonGame.Views.UserControls"
    Title="MapView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">



    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!--  ── Layer button style ──  -->
        <Style x:Key="LayerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#777" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#555" />
                                <Setter Property="Foreground" Value="#BBB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#DDD" />
                    <Setter Property="BorderBrush" Value="#4A7C4E" />
                    <Setter Property="Background" Value="#1A2E1C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  ── D-pad button style ──  -->
        <Style x:Key="DpadButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="#AAA" />
            <Setter Property="Background" Value="#1C1C1C" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A" />
                                <Setter Property="BorderBrush" Value="#4A7C4E" />
                                <Setter Property="Foreground" Value="#EEE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A2E1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#111">
        <!--  Loading overlay — visible until IsReady=true  -->
        <Grid
            Panel.ZIndex="99"
            Background="#111"
            Visibility="{Binding IsReady, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="13"
                Foreground="#555"
                Text="Loading map..." />
        </Grid>

        <!--  Main content — hidden until IsReady=true  -->
        <Grid Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ── Header ──  -->
            <Border
                Grid.Row="0"
                Padding="16,10"
                Background="#111"
                BorderBrush="#1E1E1E"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#E0E0E0"
                            Text="{Binding MapName}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="14"
                            Foreground="#333"
                            Text="  ·  " />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#555">
                            <Run Text="sq " />
                            <Run Foreground="#4A7C4E" Text="{Binding PlayerSquareRow, Mode=OneWay}" />
                            <Run Text="," />
                            <Run Foreground="#4A7C4E" Text="{Binding PlayerSquareCol, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="14"
                            Foreground="#333"
                            Text="  ·  " />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#555">
                            <Run Text="facing " />
                            <Run Foreground="#7A9A7A" Text="{Binding FacingText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,6,0"
                            Command="{Binding ShowBackgroundCommand}"
                            Content="BG"
                            IsEnabled="{Binding IsShowingBackground}"
                            Style="{StaticResource LayerButtonStyle}" />
                        <Button
                            Command="{Binding ShowForegroundCommand}"
                            Content="FG"
                            IsEnabled="{Binding IsShowingForeground}"
                            Style="{StaticResource LayerButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ── Body ──  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Map viewport  -->
                <ScrollViewer
                    Grid.Column="0"
                    Padding="20"
                    behaviors:FocusBehavior.FocusOnLoad="True"
                    behaviors:FocusBehavior.RegisterFocusTarget="True"
                    Background="#0A0A0A"
                    Focusable="True"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled">

                    <ScrollViewer.InputBindings>
                        <KeyBinding Key="W" Command="{Binding MoveUpCommand}" />
                        <KeyBinding Key="S" Command="{Binding MoveDownCommand}" />
                        <KeyBinding Key="A" Command="{Binding MoveLeftCommand}" />
                        <KeyBinding Key="D" Command="{Binding MoveRightCommand}" />
                        <KeyBinding Key="Up" Command="{Binding MoveUpCommand}" />
                        <KeyBinding Key="Down" Command="{Binding MoveDownCommand}" />
                        <KeyBinding Key="Left" Command="{Binding MoveLeftCommand}" />
                        <KeyBinding Key="Right" Command="{Binding MoveRightCommand}" />
                        <KeyBinding Key="Z" Command="{Binding InspectCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding InspectCommand}" />
                        <KeyBinding Key="F3" Command="{Binding ToggleDebugCommand}" />
                        <KeyBinding Key="D1" Command="{Binding PickChoice1Command}" />
                        <KeyBinding Key="D2" Command="{Binding PickChoice2Command}" />
                        <KeyBinding Key="D3" Command="{Binding PickChoice3Command}" />
                        <KeyBinding Key="NumPad1" Command="{Binding PickChoice1Command}" />
                        <KeyBinding Key="NumPad2" Command="{Binding PickChoice2Command}" />
                        <KeyBinding Key="NumPad3" Command="{Binding PickChoice3Command}" />
                    </ScrollViewer.InputBindings>

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas
                            Width="{Binding ViewportWidthPx}"
                            Height="{Binding ViewportHeightPx}"
                            Background="#0A0A0A">

                            <!--  Layer 1: cropped map image  -->
                            <Image
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Width="{Binding ImageDisplayWidth}"
                                Height="{Binding ImageDisplayHeight}"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding MapImageSource}"
                                Stretch="Fill" />

                            <!--  Layer 2: overlays  -->
                            <uc:MapOverlayVisual
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Width="{Binding ViewportWidthPx}"
                                Height="{Binding ViewportHeightPx}"
                                Items="{Binding OverlaySnapshot}" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>

                <!--  Dialogue overlay  -->
                <uc:DialogueBoxControl
                    Grid.Column="0"
                    Margin="20,0,20,12"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="10" />

                <!--  D-Pad + legend  -->
                <Border
                    Grid.Column="1"
                    Width="160"
                    Padding="20"
                    Background="#0E0E0E"
                    BorderBrush="#1E1E1E"
                    BorderThickness="1,0,0,0">
                    <StackPanel VerticalAlignment="Top">

                        <TextBlock
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="#444"
                            Text="MOVE" />

                        <Grid Margin="0,0,0,12" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Command="{Binding MoveUpCommand}"
                                Content="▲"
                                Style="{StaticResource DpadButtonStyle}" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Command="{Binding MoveLeftCommand}"
                                Content="◀"
                                Style="{StaticResource DpadButtonStyle}" />
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Background="#141414"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="4" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="2"
                                Command="{Binding MoveRightCommand}"
                                Content="▶"
                                Style="{StaticResource DpadButtonStyle}" />
                            <Button
                                Grid.Row="2"
                                Grid.Column="1"
                                Command="{Binding MoveDownCommand}"
                                Content="▼"
                                Style="{StaticResource DpadButtonStyle}" />
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,24"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="9"
                            Foreground="#333"
                            Text="WASD or Arrow keys"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="#444"
                            Text="LEGEND" />

                        <StackPanel>
                            <StackPanel Margin="0,3" Orientation="Horizontal">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="2,0,10,0"
                                    Fill="#FF3333"
                                    Stroke="#FF8888"
                                    StrokeThickness="1" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="player" />
                            </StackPanel>
                            <StackPanel Margin="0,3" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF9900"
                                    Text="T" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="trainer NPC" />
                            </StackPanel>
                            <StackPanel Margin="0,3" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF9900"
                                    Text="N" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="NPC" />
                            </StackPanel>
                            <StackPanel Margin="0,3" Orientation="Horizontal">
                                <Rectangle
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,8,0"
                                    Fill="#330D0D3A" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#555"
                                    Text="NPC vision" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>

            <!--  ── Status bar ──  -->
            <Border
                Grid.Row="2"
                Padding="16,6"
                Background="#111"
                BorderBrush="#1E1E1E"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="#444">
                        <Run Text="{Binding MapWidth, Mode=OneWay}" />
                        <Run Text="×" />
                        <Run Text="{Binding MapHeight, Mode=OneWay}" />
                        <Run Text=" tiles  ·  " />
                        <Run Text="{Binding SquareCols, Mode=OneWay}" />
                        <Run Text="×" />
                        <Run Text="{Binding SquareRows, Mode=OneWay}" />
                        <Run Text=" squares" />
                    </TextBlock>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="#555"
                        Text="{Binding LastMoveResult}" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="#4A7C4E">
                        <Run Text="tile: " />
                        <Run Text="{Binding CollisionAtCursor, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
