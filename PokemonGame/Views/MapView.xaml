<Page
    x:Class="PokemonGame.Views.MapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:PokemonGame.View.Behaviors"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:converters="clr-namespace:PokemonGame.Converters"
    xmlns:uc="clr-namespace:PokemonGame.Views.UserControls"
    Title="MapView">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:MenuHighlightConverter x:Key="MenuHighlightConverter" />
    </Page.Resources>

    <Grid Background="#111">

        <!--  Loading overlay  -->
        <Grid
            Panel.ZIndex="99"
            Background="#111"
            Visibility="{Binding IsReady, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="13"
                Foreground="#555"
                Text="Loading map..." />
        </Grid>

        <!--  Main content  -->
        <ScrollViewer
            behaviors:FocusBehavior.FocusOnLoad="True"
            behaviors:FocusBehavior.RegisterFocusTarget="True"
            Background="#0A0A0A"
            Focusable="True"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Disabled"
            Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibilityConverter}}">

            <ScrollViewer.InputBindings>
                <KeyBinding Key="W" Command="{Binding MoveUpCommand}" />
                <KeyBinding Key="S" Command="{Binding MoveDownCommand}" />
                <KeyBinding Key="A" Command="{Binding MoveLeftCommand}" />
                <KeyBinding Key="D" Command="{Binding MoveRightCommand}" />
                <KeyBinding Key="Up" Command="{Binding MoveUpCommand}" />
                <KeyBinding Key="Down" Command="{Binding MoveDownCommand}" />
                <KeyBinding Key="Left" Command="{Binding MoveLeftCommand}" />
                <KeyBinding Key="Right" Command="{Binding MoveRightCommand}" />
                <KeyBinding Key="Z" Command="{Binding InspectCommand}" />
                <KeyBinding Key="Enter" Command="{Binding MenuConfirmCommand}" />
                <KeyBinding Key="Enter" Command="{Binding InspectCommand}" />
                <KeyBinding Key="F3" Command="{Binding ToggleDebugCommand}" />
                <KeyBinding Key="D1" Command="{Binding PickChoice1Command}" />
                <KeyBinding Key="D2" Command="{Binding PickChoice2Command}" />
                <KeyBinding Key="D3" Command="{Binding PickChoice3Command}" />
                <KeyBinding Key="NumPad1" Command="{Binding PickChoice1Command}" />
                <KeyBinding Key="NumPad2" Command="{Binding PickChoice2Command}" />
                <KeyBinding Key="NumPad3" Command="{Binding PickChoice3Command}" />
                <KeyBinding Key="Escape" Command="{Binding ToggleMenuCommand}" />
            </ScrollViewer.InputBindings>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas
                    Width="{Binding ViewportWidthPx}"
                    Height="{Binding ViewportHeightPx}"
                    Background="#0A0A0A">

                    <!--  Map image  -->
                    <Image
                        Canvas.Left="{Binding ImageOffsetX}"
                        Canvas.Top="{Binding ImageOffsetY}"
                        Width="{Binding ImageDisplayWidth}"
                        Height="{Binding ImageDisplayHeight}"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Source="{Binding MapImageSource}"
                        Stretch="Fill" />

                    <!--  Overlays  -->
                    <uc:MapOverlayVisual
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="{Binding ViewportWidthPx}"
                        Height="{Binding ViewportHeightPx}"
                        Items="{Binding OverlaySnapshot}" />

                    <!--  Player sprite  -->
                    <Image
                        Canvas.Left="{Binding PlayerPixelX}"
                        Canvas.Top="{Binding PlayerPixelY}"
                        Width="48"
                        Height="72"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Source="{Binding PlayerImage}" />

                    <!--  Menu  -->
                    <controls:BoardBackground
                        Canvas.Left="8"
                        Canvas.Top="8"
                        Width="160"
                        Padding="8"
                        BackgroundType="White"
                        Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style x:Key="MenuItemStyle" TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="CornerRadius" Value="3" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </Style>
                            </StackPanel.Resources>

                            <Border
                                BorderBrush="{Binding MenuIndex, Converter={StaticResource MenuHighlightConverter}, ConverterParameter=0}"
                                BorderThickness="2"
                                Style="{StaticResource MenuItemStyle}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="Pokedex" />
                            </Border>
                            <Border
                                BorderBrush="{Binding MenuIndex, Converter={StaticResource MenuHighlightConverter}, ConverterParameter=1}"
                                BorderThickness="2"
                                Style="{StaticResource MenuItemStyle}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="Bag" />
                            </Border>
                            <Border
                                BorderBrush="{Binding MenuIndex, Converter={StaticResource MenuHighlightConverter}, ConverterParameter=2}"
                                BorderThickness="2"
                                Style="{StaticResource MenuItemStyle}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="Pokemon" />
                            </Border>
                            <Border
                                BorderBrush="{Binding MenuIndex, Converter={StaticResource MenuHighlightConverter}, ConverterParameter=3}"
                                BorderThickness="2"
                                Style="{StaticResource MenuItemStyle}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="Player" />
                            </Border>
                            <Border
                                BorderBrush="{Binding MenuIndex, Converter={StaticResource MenuHighlightConverter}, ConverterParameter=4}"
                                BorderThickness="2"
                                Style="{StaticResource MenuItemStyle}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="Save" />
                            </Border>
                            <Border
                                BorderBrush="{Binding MenuIndex, Converter={StaticResource MenuHighlightConverter}, ConverterParameter=5}"
                                BorderThickness="2"
                                Style="{StaticResource MenuItemStyle}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="Options" />
                            </Border>
                            <Border
                                BorderBrush="{Binding MenuIndex, Converter={StaticResource MenuHighlightConverter}, ConverterParameter=6}"
                                BorderThickness="2"
                                Style="{StaticResource MenuItemStyle}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#333"
                                    Text="Exit" />
                            </Border>
                        </StackPanel>
                    </controls:BoardBackground>

                    <!--  Dialogue  -->
                    <uc:DialogueBoxControl
                        Canvas.Left="20"
                        Canvas.Bottom="12"
                        Width="{Binding ViewportWidthPx}"
                        Panel.ZIndex="10" />

                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>