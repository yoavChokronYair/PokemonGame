<Page
    x:Class="PokemonGame.Views.Pages.PokemonBattlePages.PokemonBag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:PokemonGame.View.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.PokemonBattlePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PokemonBag"
    behaviors:FocusBehavior.FocusOnLoad="True"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/PokemonBag.png" Stretch="Fill" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="143*" />
            <RowDefinition Height="73*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14*" />
            <ColumnDefinition Width="276*" />
            <ColumnDefinition Width="485*" />
            <ColumnDefinition Width="25*" />
        </Grid.ColumnDefinitions>

        <!--  Category header — shows current tab name instead of "Bag"  -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Margin="10,0,0,0"
            FontSize="24"
            Text="{Binding CurrentCategoryName}" />

        <ScrollViewer
            x:Name="BagScrollViewer"
            Grid.Row="1"
            Grid.Column="2"
            behaviors:FocusBehavior.FocusOnLoad="True"
            behaviors:FocusBehavior.RegisterFocusTarget="True"
            behaviors:ScrollViewerOffsetBehavior.VerticalOffset="{Binding ScrollOffset}"
            Focusable="True"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <ScrollViewer.InputBindings>
                <KeyBinding Key="W" Command="{Binding ScrollUpCommand}" />
                <KeyBinding Key="S" Command="{Binding ScrollDownCommand}" />
                <KeyBinding Key="A" Command="{Binding CategoryLeftCommand}" />
                <KeyBinding Key="D" Command="{Binding CategoryRightCommand}" />
                <KeyBinding Key="Esc" Command="{Binding ExitCommand}" />
            </ScrollViewer.InputBindings>
            <ItemsControl
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                ItemsSource="{Binding PokemonEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Height="60"
                            Margin="4,2"
                            BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Background" Value="Wheat" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Margin="6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="{Binding Amount, StringFormat='x{0}'}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Description of selected item  -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="2"
            VerticalAlignment="Center"
            FontSize="14"
            Text="{Binding SelectedDescription}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
