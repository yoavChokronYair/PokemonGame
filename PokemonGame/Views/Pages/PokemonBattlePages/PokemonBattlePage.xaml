<Page
    x:Class="PokemonGame.Views.Pages.PokemonBattlePages.PokemonBattlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.PokemonBattlePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:PokemonGame.Views.UserControls.BattleMenu"
    Title="PokemonBattlePage"
    d:DesignHeight="533"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="199" />
            <RowDefinition />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43" />
            <ColumnDefinition Width="744*" />
            <ColumnDefinition Width="13*" />
        </Grid.ColumnDefinitions>

        <!--  Background  -->
        <Image
            Grid.RowSpan="3"
            Grid.ColumnSpan="3"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="/Assets/Images/BattleBackground.png"
            Stretch="Fill" />

        <!--  Bottom battle menu — DataContext = BattleMenuViewModel  -->
        <uc:BattleSelectionMenuUserControl
            Grid.Row="3"
            Grid.ColumnSpan="3"
            DataContext="{Binding BattleMenu}" />

        <!--  Enemy status bar — DataContext = EnemyBattleStatusViewModel  -->
        <uc:EnemyBattleStatusControl
            Grid.Row="1"
            Grid.Column="1"
            Width="280"
            Height="80"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            DataContext="{Binding EnemyStatus}" />

        <!--  Enemy sprite  -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Width="200"
            Height="200"
            Margin="0,0,90,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <Ellipse
                Width="80"
                Height="20"
                Margin="0,0,0,5"
                VerticalAlignment="Bottom"
                Fill="Black"
                Opacity="0.2">
                <Ellipse.Effect>
                    <BlurEffect Radius="10" />
                </Ellipse.Effect>
            </Ellipse>
            <Image
                x:Name="PokemonSprite"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                RenderTransformOrigin="0.5,1"
                Source="/Assets/Images/PokemonSprites/6.png"
                Stretch="Uniform">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SpriteScale" />
                        <TranslateTransform x:Name="SpriteBounce" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>

        <!--  Player status bar — DataContext = PokemonBattleStatusViewModel  -->
        <uc:PokemonBattleStatusControl
            Grid.Row="2"
            Grid.Column="1"
            Width="300"
            Height="100"
            Margin="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            DataContext="{Binding PlayerStatus}" />

        <!--  Player sprite  -->
        <Image
            Grid.Row="2"
            Grid.Column="1"
            Margin="100,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="/Assets/Images/PokemonSprites/back/1.png"
            Stretch="Uniform" />
    </Grid>
</Page>
