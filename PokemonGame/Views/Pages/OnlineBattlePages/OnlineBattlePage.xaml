<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.OnlineBattlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:PokemonGame.Views.UserControls.BattleMenu"
    Title="OnlineBattlePage"
    d:DesignHeight="533"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:PokemonIdToImageConverter x:Key="IdToSprite" />
        <converters:PokemonIdToBackImageConverter x:Key="IdToBackSprite" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="199" />
            <RowDefinition />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43" />
            <ColumnDefinition Width="744*" />
            <ColumnDefinition Width="13*" />
        </Grid.ColumnDefinitions>

        <Image
            Grid.RowSpan="3"
            Grid.ColumnSpan="3"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="/Assets/Images/BattleBackground.png"
            Stretch="Fill" />

        <!--  Winner banner — only visible when WinnerName is set  -->
        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="24"
            FontWeight="Bold"
            Foreground="Gold"
            Text="{Binding WinnerName}" />

        <uc:BattleSelectionMenuUserControl
            Grid.Row="3"
            Grid.ColumnSpan="3"
            DataContext="{Binding BattleMenu}" />

        <uc:EnemyBattleStatusControl
            Grid.Row="1"
            Grid.Column="1"
            Width="280"
            Height="80"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            DataContext="{Binding EnemyStatus}" />

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Width="200"
            Height="200"
            Margin="0,0,90,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <Ellipse
                Width="80"
                Height="20"
                Margin="0,0,0,5"
                VerticalAlignment="Bottom"
                Fill="Black"
                Opacity="0.2">
                <Ellipse.Effect>
                    <BlurEffect Radius="10" />
                </Ellipse.Effect>
            </Ellipse>
            <Image
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Source="{Binding EnemyStatus.PokedexId, Converter={StaticResource IdToSprite}}"
                Stretch="Uniform" />
        </Grid>

        <uc:PokemonBattleStatusControl
            Grid.Row="2"
            Grid.Column="1"
            Width="300"
            Height="100"
            Margin="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            DataContext="{Binding PlayerStatus}" />

        <Image
            Grid.Row="2"
            Grid.Column="1"
            Margin="100,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="{Binding PlayerStatus.PokedexId, Converter={StaticResource IdToBackSprite}}"
            Stretch="Uniform" />
    </Grid>
</Page>