<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:PokemonGame.Views.UserControls.OnlineBattleUserControls"
    Background="White"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="360"
            Margin="0,30"
            HorizontalAlignment="Center">

            <!--  TITLE  -->
            <TextBlock
                Margin="0,0,0,24"
                HorizontalAlignment="Center"
                FontSize="26"
                FontWeight="Bold"
                Text="Profile" />

            <!--  ── USER DATA CARD ──  -->
            <controls:BoardBackground
                Margin="0,0,0,16"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="16">
                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="Bold"
                        Text="USER DATA" />

                    <TextBlock
                        FontSize="11"
                        Foreground="#888"
                        Text="Display Name" />
                    <TextBlock
                        Margin="0,2,0,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding DisplayName}" />

                    <TextBlock
                        FontSize="11"
                        Foreground="#888"
                        Text="Username" />
                    <TextBlock
                        Margin="0,2,0,10"
                        FontSize="13"
                        Text="{Binding UserName}" />
                </StackPanel>
            </controls:BoardBackground>

            <!--  ── STATS CARD ──  -->
            <controls:BoardBackground
                Margin="0,0,0,16"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="16">
                    <TextBlock
                        Margin="0,0,0,16"
                        FontWeight="Bold"
                        Text="BATTLE RANKINGS" />

                    <!--  ROW 1: CURRENT ELO SUMMARY  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text=" ELO 1v1" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#2196F3"
                                Text="{Binding CurrentElo1v1}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="ELO 2v2" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#9C27B0"
                                Text="{Binding CurrentElo2v2}" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,8,0,12" Background="#EEEEEE" />

                    <!--  ROW 2 & 3: 1v1 DETAILS  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#444"
                        Text="SINGLES (1v1)" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="9"
                                Foreground="#888"
                                Text="WINS" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding Wins1v1}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="9"
                                Foreground="#888"
                                Text="PEAK ELO" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding PeakElo1v1}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                FontSize="9"
                                Foreground="#888"
                                Text="STREAK" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#4CAF50"
                                Text="{Binding CurrentStreak1v1}" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,8,0,12" Background="#EEEEEE" />

                    <!--  ROW 4 & 5: 2v2 DETAILS  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#444"
                        Text="DOUBLES (2v2)" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="9"
                                Foreground="#888"
                                Text="WINS" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding Wins2v2}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="9"
                                Foreground="#888"
                                Text="PEAK ELO" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding PeakElo2v2}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                FontSize="9"
                                Foreground="#888"
                                Text="STREAK" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#4CAF50"
                                Text="{Binding CurrentStreak2v2}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:BoardBackground>

            <!--  ── FAVOURITE TEAM CARD ──  -->
            <controls:BoardBackground
                Margin="0,0,0,16"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="16">
                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="Bold"
                        Text="FAVOURITE TEAM" />

                    <uc:PokemonTeamUserControl Height="180" DataContext="{Binding FavouriteTeam}" />
                </StackPanel>
            </controls:BoardBackground>

            <!--  ── SETTINGS CARD ──  -->
            <controls:BoardBackground
                Margin="0,0,0,16"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="10">

                    <!--  ANIMATION: Simple On/Off List  -->
                    <uc:SettingRowControl
                        Header="ANIMATION"
                        Options="{Binding BattleSceneOptions}"
                        SelectedOption="{Binding SelectedBattleScene}" />

                    <!-- TEXT SPEED: Selector Style with < > arrows -->
                    <uc:SettingRowControl
                        Header="TEXT SPEED"
                        Options="{Binding TextSpeedOptions}"
                        SelectedOption="{Binding SelectedTextSpeed}"
                        UseSelectorMode="True" />

                    <!--  BACKGROUND: Selector Style (useful if you have many themes)  -->
                    <uc:SettingRowControl
                        Header="BACKGROUND"
                        Options="{Binding BackgroundOptions}"
                        SelectedOption="{Binding SelectedBackground}"
                        UseSelectorMode="True" />

                    <!--  SHOW EFFECTIVE: Simple On/Off List  -->
                    <uc:SettingRowControl
                        Header="SHOW EFFECTIVE"
                        Options="{Binding BattleSceneOptions}"
                        SelectedOption="{Binding ShowTypeEffectiveness}" />

                </StackPanel>
            </controls:BoardBackground>

        </StackPanel>
    </ScrollViewer>
</Page>