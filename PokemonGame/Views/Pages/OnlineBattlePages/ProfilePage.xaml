<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="White"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  TITLE  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,30,0,20"
            HorizontalAlignment="Center"
            FontSize="26"
            FontWeight="Bold"
            Text="Profile" />

        <!--  VERTICAL CONTENT  -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">

            <!--  USER DATA CARD  -->
            <controls:BoardBackground
                Width="320"
                Height="220"
                Margin="0,0,0,25"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">

                <StackPanel Margin="16">

                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="Bold"
                        Text="USER DATA" />

                    <TextBlock FontWeight="SemiBold" Text="Display name" />

                    <TextBox Margin="0,4,0,12" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock FontWeight="SemiBold" Text="User name" />

                    <TextBlock Opacity="0.7" Text="{Binding UserName}" />
                </StackPanel>
            </controls:BoardBackground>

            <!--  SETTINGS CARD  -->
            <controls:BoardBackground
                Width="320"
                Height="160"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">

                <StackPanel Margin="16">

                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="Bold"
                        Text="SETTINGS" />

                    <CheckBox Content="Dark mode" IsChecked="{Binding IsDarkMode}" />
                </StackPanel>
            </controls:BoardBackground>

        </StackPanel>
    </Grid>
</Page>
