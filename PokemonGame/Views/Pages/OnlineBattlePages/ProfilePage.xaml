<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:PokemonGame.Views.UserControls.OnlineBattleUserControls"
    Background="White"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="360"
            Margin="0,30"
            HorizontalAlignment="Center">

            <!--  TITLE  -->
            <TextBlock
                Margin="0,0,0,24"
                HorizontalAlignment="Center"
                FontSize="26"
                FontWeight="Bold"
                Text="Profile" />

            <!--  ── USER DATA CARD ──  -->
            <controls:BoardBackground
                Margin="0,0,0,16"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="16">
                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="Bold"
                        Text="USER DATA" />

                    <TextBlock
                        FontSize="11"
                        Foreground="#888"
                        Text="Display Name" />
                    <TextBlock
                        Margin="0,2,0,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding DisplayName}" />

                    <TextBlock
                        FontSize="11"
                        Foreground="#888"
                        Text="Username" />
                    <TextBlock
                        Margin="0,2,0,10"
                        FontSize="13"
                        Text="{Binding UserName}" />

                    <TextBlock
                        FontSize="11"
                        Foreground="#888"
                        Text="Player ID" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Opacity="0.6"
                        Text="{Binding PlayerId}" />
                </StackPanel>
            </controls:BoardBackground>

            <!--  ── STATS CARD ──  -->
            <controls:BoardBackground
                Margin="0,0,0,16"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="16">
                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="Bold"
                        Text="STATS" />

                    <!--  Row 1: Wins / Losses  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="WINS" />
                            <TextBlock
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#4CAF50"
                                Text="{Binding Wins}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="LOSSES" />
                            <TextBlock
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#E53935"
                                Text="{Binding Losses}" />
                        </StackPanel>
                    </Grid>

                    <!--  Divider  -->
                    <Separator Margin="0,0,0,12" Background="#EEEEEE" />

                    <!--  Row 2: Win Rate / Total Battles / Draws  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="WIN RATE" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding WinRate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="BATTLES" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding TotalBattles}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="DRAWS" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding Draws}" />
                        </StackPanel>
                    </Grid>

                    <!--  Divider  -->
                    <Separator Margin="0,0,0,12" Background="#EEEEEE" />

                    <!--  Row 3: Streaks  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="CURRENT STREAK" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding CurrentWinStreak}" />
                                <TextBlock
                                    Margin="4,4,0,0"
                                    FontSize="10"
                                    Foreground="#888"
                                    Text="🔥" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="BEST STREAK" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding BestWinStreak}" />
                                <TextBlock
                                    Margin="4,4,0,0"
                                    FontSize="10"
                                    Foreground="#888"
                                    Text="🏆" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  Divider  -->
                    <Separator Margin="0,0,0,12" Background="#EEEEEE" />

                    <!--  Row 4: Battle Detail  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="KOs" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding PokemonKnockedOut}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="FAINTED" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding PokemonFainted}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                FontSize="10"
                                Foreground="#888"
                                Text="CRITS" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding CriticalHits}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:BoardBackground>

            <!--  ── FAVOURITE TEAM CARD ──  -->
            <controls:BoardBackground
                Margin="0,0,0,16"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="16">
                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="Bold"
                        Text="FAVOURITE TEAM" />

                    <uc:PokemonTeamUserControl Height="180" DataContext="{Binding FavouriteTeam}" />
                </StackPanel>
            </controls:BoardBackground>

            <!--  ── SETTINGS CARD ──  -->
            <controls:BoardBackground
                Margin="0,0,0,16"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="18">
                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="Bold"
                        Text="SETTINGS" />

                    <!--  Display  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="10"
                        Foreground="#888"
                        Text="DISPLAY" />
                    <CheckBox
                        Margin="0,0,0,6"
                        Content="Dark mode"
                        IsChecked="{Binding IsDarkMode}" />
                    <CheckBox
                        Margin="0,0,0,6"
                        Content="Show online status"
                        IsChecked="{Binding ShowOnlineStatus}" />

                    <Separator Margin="0,8,0,8" Background="#EEEEEE" />

                    <!--  Battle  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="10"
                        Foreground="#888"
                        Text="BATTLE" />
                    <CheckBox
                        Margin="0,0,0,6"
                        Content="Allow battle requests"
                        IsChecked="{Binding AllowBattleRequests}" />
                    <CheckBox
                        Margin="0,0,0,6"
                        Content="Animations"
                        IsChecked="{Binding AnimationsEnabled}" />
                    <CheckBox
                        Margin="0,0,0,6"
                        Content="Auto confirm moves"
                        IsChecked="{Binding AutoConfirmMoves}" />
                    <CheckBox
                        Margin="0,0,0,6"
                        Content="Show damage numbers"
                        IsChecked="{Binding ShowDamageNumbers}" />
                    <CheckBox
                        Margin="0,0,0,0"
                        Content="Show type effectiveness"
                        IsChecked="{Binding ShowTypeEffectiveness}" />
                </StackPanel>
            </controls:BoardBackground>

        </StackPanel>
    </ScrollViewer>
</Page>