<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.TeamBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.UserControls"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="740"
    Background="#F0F4F8"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:InverseNullToVisibilityConverter x:Key="InvNullToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="716"
            Margin="12"
            HorizontalAlignment="Left">

            <!--  ══ Team slot bar ══  -->
            <Border
                Margin="0,0,0,8"
                Padding="10,8"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Orientation="Horizontal">

                    <!--
                        Team slots — clicking sets SelectedPokemon directly via ListBox binding.
                        No CommandParameter needed.
                    -->
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding TeamSlots}"
                        SelectedItem="{Binding SelectedPokemon, Mode=OneWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="3,0" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="#CCCCCC" />
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                Padding="4"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4A90D9" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#7AB8E8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="72" HorizontalAlignment="Center">
                                    <Image
                                        Width="48"
                                        Height="48"
                                        HorizontalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Source="{Binding SpriteImage}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Foreground="#333"
                                        Text="{Binding Nickname}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  Add slot (opens pokemon picker)  -->
                    <Button
                        Width="80"
                        Height="80"
                        Margin="3,0"
                        Background="#F5F5F5"
                        BorderBrush="#DDDDDD"
                        BorderThickness="2"
                        Command="{Binding AddTeamSlotCommand}"
                        Cursor="Hand"
                        Visibility="{Binding CanAddTeamSlot, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#4A90D9" />
                                        <Setter Property="Background" Value="#EEF4FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="26"
                            Foreground="#AAAAAA"
                            Text="+" />
                    </Button>

                    <!--  Remove selected  -->
                    <Button
                        Margin="12,0,0,0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="#FFF0F0"
                        BorderBrush="#FFAAAA"
                        BorderThickness="1"
                        Command="{Binding RemoveFromTeamCommand}"
                        Cursor="Hand"
                        FontSize="11"
                        Visibility="{Binding SelectedPokemon, Converter={StaticResource NullToVis}}">
                        <TextBlock Foreground="#CC4444" Text="🗑 Remove" />
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="#F0FFF0"
                        BorderBrush="#88CC88"
                        BorderThickness="1"
                        Command="{Binding AddToTeamCommand}"
                        Cursor="Hand"
                        FontSize="11"
                        Visibility="{Binding SelectedPokemon, Converter={StaticResource NullToVis}}">
                        <TextBlock Foreground="#336633" Text="✚ Add to Team" />
                    </Button>
                    <!--  Always-visible picker toggle  -->
                    <Button
                        Margin="6,0,0,0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="#F0F4FF"
                        BorderBrush="#4A90D9"
                        BorderThickness="1"
                        Command="{Binding OpenPokemonPickerCommand}"
                        Cursor="Hand"
                        FontSize="11">
                        <TextBlock Foreground="#4A90D9" Text="🔍 Browse Pokémon" />
                    </Button>
                </StackPanel>
            </Border>

            <!--  ══ Editor card ══  -->
            <controls:PokemonEditorUserControl Margin="0,0,0,6" DataContext="{Binding}" />

            <!--  ══ EV/IV panel (toggle by clicking Stats) ══  -->
            <controls:EvIvEditorUserControl
                Margin="0,0,0,6"
                DataContext="{Binding}"
                Visibility="{Binding IsEvIvPanelOpen, Converter={StaticResource BoolToVis}}" />

            <!--  ══ Move picker ══  -->
            <controls:MovePickerUserControl
                Margin="0,0,0,6"
                DataContext="{Binding}"
                Visibility="{Binding IsMovePickerOpen, Converter={StaticResource BoolToVis}}" />

            <!--  ══ Item picker ══  -->
            <controls:ItemPickerUserControl
                Margin="0,0,0,6"
                DataContext="{Binding}"
                Visibility="{Binding IsItemPickerOpen, Converter={StaticResource BoolToVis}}" />

            <!--  ══ Pokemon picker ══  -->
            <controls:PokemonPickerUserControl
                Margin="0,0,0,6"
                DataContext="{Binding}"
                Visibility="{Binding IsPokemonPickerOpen, Converter={StaticResource BoolToVis}}" />


        </StackPanel>
    </ScrollViewer>
</Page>
