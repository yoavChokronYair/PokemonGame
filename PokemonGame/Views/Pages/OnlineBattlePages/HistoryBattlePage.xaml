<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.HistoryBattlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:uc="clr-namespace:PokemonGame.Views.UserControls"
    Background="#F5F5F5">

    <Page.Resources>
        <conv:WinnerTextConverter x:Key="WinnerTextConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <!--  Empty state  -->
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Foreground="#AAAAAA"
            Text="No battles in history"
            Visibility="{Binding HasNoBattles, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer
            Width="650"
            Height="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Battles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="10"
                            Padding="10"
                            Background="#DDDDDD"
                            CornerRadius="12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  PLAYER  -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontWeight="Bold"
                                        Text="{Binding PlayerName}" />

                                    <uc:PokemonTeamUserControl
                                        Width="250"
                                        Height="220"
                                        DataContext="{Binding PlayerTeam}" />
                                </StackPanel>

                                <!--  VS  -->
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="20,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding IsPlayerWinner, Converter={StaticResource WinnerTextConverter}}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Text="VS" />
                                </StackPanel>

                                <!--  OPPONENT  -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontWeight="Bold"
                                        Text="{Binding OpponentName}" />

                                    <uc:PokemonTeamUserControl
                                        Width="250"
                                        Height="220"
                                        DataContext="{Binding OpponentTeam}" />
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>