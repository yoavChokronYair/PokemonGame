<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.HistoryBattlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.OnlineBattlePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="HistoryBattlePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer
            Width="500"
            Height="300"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel>
                <Border
                    Width="450"
                    Height="100"
                    Margin="10"
                    Background="Gray">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="25,0,0,0">
                            <TextBlock Margin="0,0,0,10" Text="you" />
                            <controls:BoardBackground />
                        </StackPanel>
                        <StackPanel Width="75" Margin="25,0,25,0">
                            <TextBlock Margin="0,0,0,10" Text="winner" />
                            <TextBlock FontSize="24" Text="vs" />
                        </StackPanel>
                        <StackPanel Margin="25,0,0,0">
                            <TextBlock Margin="0,0,0,10" Text="opp" />
                            <controls:BoardBackground />
                        </StackPanel>

                    </StackPanel>
                </Border>
                <Border
                    Width="450"
                    Height="100"
                    Margin="10"
                    Background="Gray">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="25,0,0,0">
                            <TextBlock Margin="0,0,0,10" Text="you" />
                            <controls:BoardBackground />
                        </StackPanel>
                        <StackPanel Width="75" Margin="25,0,25,0">
                            <TextBlock Margin="0,0,0,10" Text="winner" />
                            <TextBlock FontSize="24" Text="vs" />
                        </StackPanel>
                        <StackPanel Margin="25,0,0,0">
                            <TextBlock Margin="0,0,0,10" Text="opp" />
                            <controls:BoardBackground />
                        </StackPanel>

                    </StackPanel>
                </Border>
                <Border
                    Width="450"
                    Height="100"
                    Margin="10"
                    Background="Gray">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="25,0,0,0">
                            <TextBlock Margin="0,0,0,10" Text="you" />
                            <controls:BoardBackground />
                        </StackPanel>
                        <StackPanel Width="75" Margin="25,0,25,0">
                            <TextBlock Margin="0,0,0,10" Text="winner" />
                            <TextBlock FontSize="24" Text="vs" />
                        </StackPanel>
                        <StackPanel Margin="25,0,0,0">
                            <TextBlock Margin="0,0,0,10" Text="opp" />
                            <controls:BoardBackground />
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
