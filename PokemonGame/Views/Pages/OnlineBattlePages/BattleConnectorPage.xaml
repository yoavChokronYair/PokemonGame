<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.BattleConnectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BattleConnectorPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ROW 1: Back button  -->
        <StackPanel
            Grid.Row="0"
            Margin="16,12,16,8"
            Orientation="Horizontal">
            <Button
                Height="28"
                Padding="12,0"
                Command="{Binding BackCommand}"
                Content="← Back"
                Cursor="Hand"
                FontSize="12" />


        </StackPanel>

        <!--  ROW 2: Player | VS | Rival  -->
        <Grid
            Grid.Row="1"
            Margin="16,0"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  PLAYER SIDE  -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">

                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Text="YOU" />

                <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding TeamSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="240" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="74"
                                Height="90"
                                Margin="3"
                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="#CCCCCC" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#1A3B82F6" />
                                                <Setter Property="BorderBrush" Value="#3B82F6" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <Image
                                            Width="48"
                                            Height="48"
                                            HorizontalAlignment="Center">
                                            <Image.Source>
                                                <BitmapImage UriSource="{Binding SpriteUrl}" />
                                            </Image.Source>
                                        </Image>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                    </StackPanel>
                                    <Border
                                        Width="18"
                                        Height="18"
                                        Margin="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#3B82F6"
                                        CornerRadius="9"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding PickOrder}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!--  Selection counter  -->
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="#555"
                    Text="{Binding RequiredCountLabel}" />


            </StackPanel>

            <!--  VS DIVIDER  -->
            <TextBlock
                Grid.Column="1"
                Margin="0,40,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="22"
                FontWeight="Bold"
                Foreground="#888"
                Text="VS" />

            <!--  RIVAL SIDE  -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top">

                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Text="RIVAL" />

                <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding RivalSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="240" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="74"
                                Height="90"
                                Margin="3"
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <Image
                                            Width="48"
                                            Height="48"
                                            HorizontalAlignment="Center">
                                            <Image.Source>
                                                <BitmapImage UriSource="{Binding SpriteUrl}" />
                                            </Image.Source>
                                        </Image>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!--  Bot Difficulty (offline only)  -->
                <Border
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="10,8">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="10"
                            FontWeight="Bold"
                            Text="BOT DIFFICULTY" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                Margin="0,0,6,0"
                                Content="😊 Easy"
                                FontSize="11"
                                GroupName="BotDiff"
                                IsChecked="{Binding IsEasy}" />
                            <RadioButton
                                Margin="0,0,6,0"
                                Content="⚔️ Medium"
                                FontSize="11"
                                GroupName="BotDiff"
                                IsChecked="{Binding IsMedium}" />
                            <RadioButton
                                Content="💀 Hard"
                                FontSize="11"
                                GroupName="BotDiff"
                                IsChecked="{Binding IsHard}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!--  Searching indicator  -->
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="#3B82F6"
                    Text="🔍 Searching for opponent..."
                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Ready indicator  -->
                <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="#22C55E"
                    Text="✅ Opponent found!"
                    Visibility="{Binding IsRivalReady, Converter={StaticResource BoolToVisibilityConverter}}" />

            </StackPanel>

        </Grid>

        <!--  ROW 3: Confirm / Find Match button  -->
        <StackPanel
            Grid.Row="2"
            Margin="16,8,16,16"
            HorizontalAlignment="Center">
            <Button
                Width="200"
                Height="38"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmLabel}"
                Cursor="Hand"
                FontSize="14"
                FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Page>