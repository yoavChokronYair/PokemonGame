<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.TeamSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:local="clr-namespace:PokemonGame.ViewModels.OnlineBattle;assembly=PokemonGame.ViewModels"
    Background="#F5F5F5">


    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  LEFT PANEL  -->
        <Border
            Grid.Column="0"
            Padding="12"
            Background="#DDDDDD"
            CornerRadius="12">
            <DockPanel LastChildFill="True">

                <!--  Team Slider  -->
                <StackPanel
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Width="32"
                        Height="32"
                        Margin="2"
                        Background="#CCCCCC"
                        BorderThickness="0"
                        Command="{Binding PreviousTeamCommand}"
                        Content="◀"
                        Cursor="Hand" />
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{Binding SelectedTeam.Name}" />
                    <Button
                        Width="32"
                        Height="32"
                        Margin="2"
                        Background="#CCCCCC"
                        BorderThickness="0"
                        Command="{Binding NextTeamCommand}"
                        Content="▶"
                        Cursor="Hand" />
                </StackPanel>

                <!--  Team Label  -->
                <TextBlock
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Your Team" />

                <!--  Team Slots  -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SelectedTeam.Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Height="90"
                                Margin="4"
                                Padding="6"
                                Background="White"
                                BorderThickness="0"
                                Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="28"
                                        Foreground="#AAAAAA"
                                        Text="+"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <Image
                                            Width="60"
                                            Height="60"
                                            Source="{Binding Pokemon.Sprite}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Pokemon.Name}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!--  RIGHT PANEL  -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">

            <!--  Search Box  -->
            <TextBox
                Width="250"
                Margin="0,0,0,10"
                FontSize="14"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="Black" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Foreground" Value="Gray" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!--  Filter Toggle Button  -->
            <Button
                Width="120"
                Margin="0,0,0,5"
                Command="{Binding ToggleFiltersCommand}"
                Content="Filter Types" />

            <!--  Type Filters  -->
            <ItemsControl ItemsSource="{Binding PokemonTypes}" Visibility="{Binding ShowFilters, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="4"
                            Padding="4,2"
                            Command="{Binding DataContext.FilterPokemonCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}"
                            Content="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Pokémon List  -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowPokemonPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding PokemonView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="120"
                                Margin="6"
                                Padding="8"
                                Background="#DDDDDD"
                                BorderThickness="0"
                                Command="{Binding DataContext.PlacePokemonCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                                <StackPanel>
                                    <Image
                                        Width="72"
                                        Height="72"
                                        Source="{Binding Sprite}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button
                Width="120"
                Margin="6"
                Padding="8"
                Background="#FFAAAA"
                BorderThickness="0"
                Command="{Binding ClearSlotCommand}"
                Content="Clear Slot"
                IsEnabled="{Binding SelectedSlot, Converter={StaticResource NullToBoolConverter }, ConverterParameter=True}" />

        </StackPanel>
    </Grid>
</Page>
