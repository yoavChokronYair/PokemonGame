<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.TeamSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:local="clr-namespace:PokemonGame.ViewModels.ViewModelPage.OnlineBattle;assembly=PokemonGame.ViewModels"
    Background="#F5F5F5">


    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  LEFT PANEL  -->
        <Border
            Grid.Column="0"
            Padding="12"
            Background="#DDDDDD"
            CornerRadius="12">
            <DockPanel LastChildFill="True">

                <!--  Team Slider  -->
                <StackPanel
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Width="32"
                        Height="32"
                        Margin="2"
                        Background="#CCCCCC"
                        BorderThickness="0"
                        Command="{Binding PreviousTeamCommand}"
                        Content="◀"
                        Cursor="Hand" />
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{Binding SelectedTeam.Name}" />
                    <Button
                        Width="32"
                        Height="32"
                        Margin="2"
                        Background="#CCCCCC"
                        BorderThickness="0"
                        Command="{Binding NextTeamCommand}"
                        Content="▶"
                        Cursor="Hand" />
                </StackPanel>

                <!--  Team Label  -->
                <TextBlock
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Your Team" />

                <!--  Team Slots  -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SelectedTeam.Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Height="90"
                                Margin="4"
                                Padding="6"
                                Background="White"
                                BorderThickness="0"
                                Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="28"
                                        Foreground="#AAAAAA"
                                        Text="+"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <Image
                                            Width="60"
                                            Height="60"
                                            Source="{Binding Pokemon.Sprite}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Pokemon.Name}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!--  RIGHT PANEL  -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">

            <ContentControl Grid.Column="1" Content="{Binding SelectedSlot}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <StackPanel Visibility="{Binding Pokemon, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBox Text="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Page}}" />
                                <ItemsControl ItemsSource="{Binding DataContext.PokemonView, RelativeSource={RelativeSource AncestorType=Page}}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Pokemon, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="{Binding Pokemon.Name, StringFormat='Editing: {0}'}" />

                                <TextBlock Text="Ability" />
                                <ComboBox ItemsSource="{Binding AvailableAbilities}" SelectedItem="{Binding Ability}" />

                                <TextBlock Text="Item" />
                                <ComboBox ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding Item}" />

                                <TextBlock Text="Moves" />
                                <ItemsControl ItemsSource="{Binding SelectedMoves}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AllPossibleMoves, RelativeSource={RelativeSource AncestorType=Page}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>
    </Grid>
</Page>
