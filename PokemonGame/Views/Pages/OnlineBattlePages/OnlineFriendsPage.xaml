<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.OnlineFriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    Background="#F5F5F5">

    <Page.Resources>
        <conv:OnlineStatusConverter x:Key="OnlineStatusConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ADD FRIEND BUTTON  -->
        <Button
            Grid.Row="0"
            Margin="20"
            Padding="12,6"
            HorizontalAlignment="Center"
            Command="{Binding AddFriendCommand}"
            Content="Add Friend" />

        <!--  FRIENDS LIST  -->
        <ScrollViewer
            Grid.Row="1"
            Width="360"
            Margin="10"
            HorizontalAlignment="Center"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Friends}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="6"
                            Padding="10"
                            Background="#DDDDDD"
                            CornerRadius="10">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  FRIEND INFO  -->
                                <StackPanel>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding Username}" />
                                    <TextBlock FontSize="12" Text="{Binding IsOnline, Converter={StaticResource OnlineStatusConverter}}" />
                                </StackPanel>

                                <!--  ACTION BUTTON  -->
                                <Button
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="8,4"
                                    Content="Invite" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
