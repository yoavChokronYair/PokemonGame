<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.OnlineFriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    Background="#F5F5F5">

    <Page.Resources>
        <conv:OnlineStatusConverter x:Key="OnlineStatusConverter" />
        <conv:StatusColorConverter x:Key="StatusColorConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0"
            Padding="10,5"
            HorizontalAlignment="Center"
            Command="{Binding AddFriendCommand}"
            Content="Add New Friend" />

        <ScrollViewer Grid.Row="1" Margin="0,20,0,0">
            <ItemsControl ItemsSource="{Binding Friends}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="5"
                            Padding="15"
                            Background="#E0E0E0"
                            CornerRadius="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding Username}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{Binding IsOnline, Converter={StaticResource StatusColorConverter}}"
                                        Text="{Binding IsOnline, Converter={StaticResource OnlineStatusConverter}}" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,10,0"
                                        Padding="10,0"
                                        Command="{Binding InviteCommand}"
                                        Content="Invite" />
                                    <Button
                                        Padding="10,0"
                                        Background="#FFDCDC"
                                        Command="{Binding RemoveCommand}"
                                        Content="Remove" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
