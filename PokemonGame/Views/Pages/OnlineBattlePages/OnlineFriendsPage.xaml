<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.OnlineFriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    Background="#F5F5F5">

    <Page.Resources>
        <conv:OnlineStatusConverter x:Key="OnlineStatusConverter" />
        <conv:StatusColorConverter x:Key="StatusColorConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  TITLE  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            FontSize="26"
            FontWeight="Bold"
            Text="Friends" />

        <!--  ADD BUTTON  -->
        <Button
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="10,5"
            HorizontalAlignment="Center"
            Command="{Binding AddFriendCommand}"
            Content="Add New Friend" />

        <!--  FRIENDS LIST  -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Friends}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!--  Outer Grid holds the row AND the popup together  -->
                        <Grid Margin="5">
                            <Border
                                Background="#E0E0E0"
                                CornerRadius="8"
                                Cursor="Hand">

                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding TogglePopupCommand}" MouseAction="LeftClick" />
                                </Border.InputBindings>

                                <!--  Row content  -->
                                <Grid Margin="15">
                                    <!--  Left: name + status  -->
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Text="{Binding Username}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{Binding IsOnline, Converter={StaticResource StatusColorConverter}}"
                                            Text="{Binding IsOnline, Converter={StaticResource OnlineStatusConverter}}" />
                                    </StackPanel>

                                    <!--  Right: level  -->
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="10"
                                            Foreground="#888"
                                            Text="LEVEL" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="{Binding Level}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Popup sits inside the same Grid as the Border  -->
                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding IsPopupOpen, Mode=TwoWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                StaysOpen="True">
                                <Border
                                    Padding="12"
                                    Background="White"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.15"
                                            ShadowDepth="2" />
                                    </Border.Effect>

                                    <StackPanel Width="160">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding Username}" />

                                        <Button
                                            Margin="0,0,0,6"
                                            Padding="8,5"
                                            Command="{Binding InviteCommand}"
                                            Content="⚔️ Invite to Battle" />

                                        <Button
                                            Padding="8,5"
                                            Background="#FFDCDC"
                                            Command="{Binding RemoveCommand}"
                                            Content="🗑️ Remove Friend" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>