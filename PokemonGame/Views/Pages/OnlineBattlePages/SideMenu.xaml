<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.SideMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SideMenu"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">

    <Border
        Width="{Binding MenuWidth}"
        Padding="5"
        HorizontalAlignment="Left"
        Background="#1E1E1E">

        <StackPanel>

            <!--  Top Header Section: Hamburger + Menu Title  -->
            <StackPanel Margin="0,10,0,10" Orientation="Horizontal">

                <!--  Hamburger  -->
                <Button
                    Width="40"
                    Height="40"
                    Margin="5,0,5,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding ToggleMenuCommand}"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <TextBlock
                                    x:Name="HamburgerIcon"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Foreground="White"
                                    RenderTransformOrigin="0.5,0.5"
                                    Text="☰">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>

                            <!--  Triggers for the Rotation Animation  -->
                            <ControlTemplate.Triggers>
                                <!--  FIXED: Checking against the string "Visible" instead of Enum  -->
                                <DataTrigger Binding="{Binding TextVisibility}" Value="Visible">

                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HamburgerIcon"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    To="90"
                                                    Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HamburgerIcon"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    To="0"
                                                    Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>

                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!--  Dynamic Page Title  -->
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding CurrentPageTitle}"
                    Visibility="{Binding TextVisibility}" />

            </StackPanel>

            <!--  Home  -->
            <Button Command="{Binding HomeCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="🏠" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Home"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

            <!--  History  -->
            <Button Command="{Binding HistoryCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="📋" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="History"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

            <!--  Team  -->
            <Button Command="{Binding TeamCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="⚔️" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Team"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

            <!--  Profile  -->
            <Button Command="{Binding ProfileCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="👤" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Profile"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

            <!--  Exit  -->
            <Button Command="{Binding ExitCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="🚪" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Main Menu"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>
</Page>