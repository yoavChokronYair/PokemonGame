<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.SideMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.OnlineBattlePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SideMenu"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
            <RowDefinition Height="350*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="200" />
            <ColumnDefinition Width="600*" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.RowSpan="2"
            Grid.Column="0"
            Padding="5"
            Background="#1E1E1E">

            <StackPanel>

                <!--  Hamburger Button  -->
                <Button
                    Width="40"
                    Height="40"
                    Margin="10"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Hamburger_Click"
                    Content="☰"
                    Cursor="Hand"
                    FontSize="22"
                    Foreground="White" />

                <!--  Menu Buttons  -->
                <Button
                    x:Name="HistroyBtn"
                    Click="HistroyBtn_Click"
                    Content="History"
                    Style="{StaticResource MenuButtonStyle}" />
                <Button
                    x:Name="FriendsBtn"
                    Click="FriendsBtn_Click"
                    Content="Friends"
                    Style="{StaticResource MenuButtonStyle}" />
                <Button
                    x:Name="TeamBtn"
                    Click="TeamBtn_Click"
                    Content="Team"
                    Style="{StaticResource MenuButtonStyle}" />
                <Button
                    x:Name="ProfileBtn"
                    Click="ProfileBtn_Click"
                    Content="Profile"
                    Style="{StaticResource MenuButtonStyle}" />
                <Button
                    x:Name="exitBtn"
                    Click="exitBtn_Click"
                    Content="to main window"
                    Style="{StaticResource MenuButtonStyle}" />

            </StackPanel>
        </Border>


    </Grid>
</Page>
