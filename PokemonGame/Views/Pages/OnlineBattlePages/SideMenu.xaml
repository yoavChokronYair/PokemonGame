<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.SideMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SideMenu"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">

    <Border
        Width="{Binding MenuWidth}"
        Padding="5"
        HorizontalAlignment="Left"
        Background="#1E1E1E">

        <StackPanel>

            <!--  Hamburger  -->
            <Button
                Width="40"
                Height="40"
                Margin="5,10,5,10"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding ToggleMenuCommand}"
                Content="☰"
                Cursor="Hand"
                FontSize="22"
                Foreground="White" />

            <!--  Home  -->
            <Button Command="{Binding HomeCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="🏠" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Home"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

            <!--  History  -->
            <Button Command="{Binding HistoryCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="📋" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="History"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

            <!--  Friends  -->
            <Button Command="{Binding FriendsCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="👥" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Friends"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

            <!--  Team  -->
            <Button Command="{Binding TeamCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="⚔️" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Team"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

            <!--  Profile  -->
            <Button Command="{Binding ProfileCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="👤" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Profile"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

            <!--  Exit  -->
            <Button Command="{Binding ExitCommand}" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="🚪" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Main Menu"
                        Visibility="{Binding TextVisibility}" />
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>
</Page>