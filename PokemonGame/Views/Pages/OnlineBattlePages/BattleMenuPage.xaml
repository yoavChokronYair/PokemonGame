<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.BattleMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.OnlineBattlePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BattleMenuPage"
    d:DesignHeight="450"
    d:DesignWidth="600"
    Background="White"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
            <RowDefinition Height="350*" />
        </Grid.RowDefinitions>

        <!--  MAIN CONTENT  -->
        <Grid Grid.Column="1">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Text="Battle menu " />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <controls:BoardBackground
                Width="200"
                Height="200"
                Margin="25"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0" />
            <controls:BoardBackground
                Width="200"
                Height="200"
                Margin="25"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0" />
        </StackPanel>
        <Frame
            x:Name="MainFrame"
            Grid.RowSpan="2"
            Grid.Column="1"
            Grid.ColumnSpan="1"
            NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
