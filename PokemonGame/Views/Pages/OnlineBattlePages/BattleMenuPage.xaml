<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePages.BattleMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.OnlineBattlePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BattleMenuPage"
    d:DesignHeight="600"
    d:DesignWidth="600"
    Background="White"
    mc:Ignorable="d">

    <StackPanel Margin="24" VerticalAlignment="Center">

        <!--  TITLE  -->
        <TextBlock
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            FontSize="26"
            FontWeight="Bold"
            Text="Battle Menu" />

        <!--  3 CARDS HORIZONTAL  -->
        <UniformGrid
            Margin="0,0,0,16"
            Columns="3"
            Rows="1">

            <!--  CARD 1: Mode  -->
            <controls:BoardBackground
                Margin="0,0,8,0"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="8" VerticalAlignment="Top">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="11"
                        FontWeight="Bold"
                        Text="BATTLE MODE" />
                    <RadioButton
                        Margin="0,0,0,6"
                        Content="🌐  Online"
                        FontSize="12"
                        GroupName="BattleMode"
                        IsChecked="{Binding IsOnline}"
                        Style="{StaticResource ToggleRadioStyle}" />
                    <RadioButton
                        Content="💻  Offline"
                        FontSize="12"
                        GroupName="BattleMode"
                        Style="{StaticResource ToggleRadioStyle}" />
                </StackPanel>
            </controls:BoardBackground>

            <!--  CARD 2: Format  -->
            <controls:BoardBackground
                Margin="4,0,4,0"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="8" VerticalAlignment="Top">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="11"
                        FontWeight="Bold"
                        Text="BATTLE FORMAT" />
                    <RadioButton
                        Margin="0,0,0,6"
                        Content="⚔️  1 v 1"
                        FontSize="12"
                        GroupName="BattleFormat"
                        IsChecked="{Binding Is1v1}"
                        Style="{StaticResource ToggleRadioStyle}" />
                    <RadioButton
                        Content="⚔️⚔️  2 v 2"
                        FontSize="12"
                        GroupName="BattleFormat"
                        Style="{StaticResource ToggleRadioStyle}" />
                </StackPanel>
            </controls:BoardBackground>

            <!--  CARD 3: Game Mode  -->
            <controls:BoardBackground
                Margin="6,0,0,0"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
                <StackPanel Margin="8" VerticalAlignment="Top">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="11"
                        FontWeight="Bold"
                        Text="GAME MODE" />
                    <RadioButton
                        Margin="0,0,0,6"
                        Content="🎲  Random"
                        FontSize="12"
                        GroupName="GameMode"
                        IsChecked="{Binding IsRandom}"
                        Style="{StaticResource ToggleRadioStyle}" />
                    <RadioButton
                        Margin="0,0,0,6"
                        Content="📋  Set Team"
                        FontSize="12"
                        GroupName="GameMode"
                        IsChecked="{Binding IsSetTeam}"
                        Style="{StaticResource ToggleRadioStyle}" />
                    <RadioButton
                        Margin="0"
                        Content="🚫  No Legends"
                        FontSize="12"
                        GroupName="GameMode"
                        IsChecked="{Binding IsNoLegendaries}"
                        Style="{StaticResource ToggleRadioStyle}" />
                </StackPanel>
            </controls:BoardBackground>

        </UniformGrid>

        <!--  SELECTION SHOWCASE  -->
        <StackPanel
            Margin="0,0,0,16"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <controls:BoardBackground BackgroundType="{x:Static controls:BackgroundType.White}" BorderThickness="0">
                <StackPanel Margin="10,4" Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="#888"
                        Text="Selected: " />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding SelectionSummary}" />
                </StackPanel>
            </controls:BoardBackground>
        </StackPanel>

        <!--  PLAY BUTTON  -->
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <controls:BoardBackground BackgroundType="{x:Static controls:BackgroundType.White}" BorderThickness="0">
                <Button
                    Width="200"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding PlayCommand}"
                    Content="▶  PLAY"
                    Cursor="Hand"
                    FontSize="14"
                    FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </controls:BoardBackground>
        </StackPanel>

    </StackPanel>
</Page>