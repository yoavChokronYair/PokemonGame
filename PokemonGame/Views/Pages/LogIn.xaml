<Page x:Class="PokemonGame.Views.Pages.LogIn"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:PokemonGame.Views.Controls"

      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonGame.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
          Background="#4a5194"

      Title="LogIn">

    <Grid>
        <controls:BoardBackground
                Width="500"
                Height="300"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0">
            <StackPanel
                        Width="220"
                        Margin="0,35,0,0"
                        Orientation="Vertical">

                <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <TextBlock
                                Height="30"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Foreground="Black"
                                Text="LOG IN" />
                    <!--  Adds spacing between icon and text  -->
                </StackPanel>

                <TextBlock
                            Margin="0,35,0,0"
                            FontSize="9"
                            FontWeight="Medium"
                            Foreground="DarkGray"
                            Text="Username" />
                <TextBox
                            x:Name="txtUser"
                            Height="28"
                            Margin="0,5,0,0"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="DarkGray"
                            BorderThickness="0,0,0,2"
                            CaretBrush="LightGray"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="black" />
                <TextBlock
                            Margin="0,15,0,0"
                            FontSize="9"
                            FontWeight="Medium"
                            Foreground="DarkGray"
                            Text="Password" />
                <PasswordBox
                            x:Name="txtPass"
                            Height="28"
                            Margin="0,5,0,0"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="DarkGray"
                            BorderThickness="0,0,0,2"
                            CaretBrush="LightGray"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="black" />
                <Button
                            x:Name="SwitchToLogIn"
                            Margin="0,10,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="Sign Up"
                            Cursor="Hand"
                            FontFamily="Montserrat"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="Black">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </controls:BoardBackground>
    </Grid>
</Page>
