<Page
    x:Class="PokemonGame.Views.Pages.SignIn.LogIn"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:converters="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:PokemonGame.Helpers"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.SignIn"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LogIn"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#4a5194"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:BoolToEyeIconConverter x:Key="BoolToEyeIconConverter" />
    </Page.Resources>

    <Grid>
        <controls:BoardBackground
            Width="500"
            Height="400"
            BackgroundType="{x:Static controls:BackgroundType.White}"
            BorderThickness="0">

            <StackPanel Width="220" Margin="0,35,0,0">

                <TextBlock
                    Height="30"
                    HorizontalAlignment="Center"
                    FontWeight="Medium"
                    Foreground="Black"
                    Text="LOG IN" />

                <!--  Username  -->
                <TextBlock
                    Margin="0,35,0,0"
                    FontSize="9"
                    Foreground="DarkGray"
                    Text="Username" />

                <TextBox
                    Height="28"
                    Margin="0,5,0,0"
                    Background="Transparent"
                    BorderBrush="DarkGray"
                    BorderThickness="0,0,0,2"
                    FontSize="13"
                    Foreground="Black"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Password  -->
                <TextBlock
                    Margin="0,15,0,0"
                    FontSize="9"
                    Foreground="DarkGray"
                    Text="Password" />

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Hidden password input  -->
                    <PasswordBox
                        x:Name="PasswordInput"
                        Grid.Column="0"
                        Height="28"
                        helpers:PasswordBoxHelper.Binding="True"
                        helpers:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                        Background="Transparent"
                        BorderBrush="DarkGray"
                        BorderThickness="0,0,0,2"
                        FontSize="13"
                        Foreground="Black"
                        Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                    <!--  Visible plain-text input  -->
                    <TextBox
                        Grid.Column="0"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="DarkGray"
                        BorderThickness="0,0,0,2"
                        FontSize="13"
                        Foreground="Black"
                        Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!--  Eye toggle button  -->
                    <Button
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding TogglePasswordVisibilityCommand}"
                        Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Content>
                            <TextBlock FontSize="14" Text="{Binding IsPasswordVisible, Converter={StaticResource BoolToEyeIconConverter}}" />
                        </Button.Content>
                    </Button>

                </Grid>
                <!--  Status message  -->
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="10"
                    Foreground="Red"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
                <!--  Log In  -->
                <Button
                    Margin="0,20,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding LoginCommand}"
                    Content="Log In"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <!--  Switch  -->
                <Button
                    Margin="0,10,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding SwitchToSignUpCommand}"
                    Content="Sign Up"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

        </controls:BoardBackground>
    </Grid>
</Page>
