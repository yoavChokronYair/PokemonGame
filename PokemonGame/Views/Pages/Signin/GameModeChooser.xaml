<Page
    x:Class="PokemonGame.Views.Pages.SignIn.GameModeChooser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.SignIn"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GameModeChooser"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#4a5194"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>
        <Image
            Grid.RowSpan="3"
            Grid.ColumnSpan="3"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="/Assets/Images/TitleScreen.png"
            Stretch="Fill" />
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Margin="25"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding StoryModeCommand}"
                Content="Story mode"
                Cursor="Hand"
                Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button
                Margin="25"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding OnlineModeCommand}"
                Content="Online mode"
                Cursor="Hand"
                Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Page>
