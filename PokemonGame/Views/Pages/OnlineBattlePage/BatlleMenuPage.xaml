<Page
    x:Class="PokemonGame.Views.Pages.OnlineBattlePage.BatlleMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.OnlineBattlePage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BatlleMenuPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
            <RowDefinition Height="350*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200*" />
            <ColumnDefinition Width="600*" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.RowSpan="2"
            Grid.Column="0"
            Width="200"
            Background="#FF2D2D30">

            <!--  Hamburger Button  -->
            <Button Margin="10" HorizontalAlignment="Left" />

            <!--  Menu Items  -->
            <Button HorizontalContentAlignment="Left" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Home" />
                </StackPanel>
            </Button>

            <Button HorizontalContentAlignment="Left" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Profile" />
                </StackPanel>
            </Button>

            <Button HorizontalContentAlignment="Left" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>

        </StackPanel>

        <!--  MAIN CONTENT  -->
        <Grid Grid.Column="1">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Text="Main Content Area" />
        </Grid>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <controls:BoardBackground
                Width="200"
                Height="200"
                Margin="25"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0" />
            <controls:BoardBackground
                Width="200"
                Height="200"
                Margin="25"
                BackgroundType="{x:Static controls:BackgroundType.White}"
                BorderThickness="0" />
        </StackPanel>
    </Grid>
</Page>
