<Page
    x:Class="PokemonGame.Views.Pages.Summery.MoveSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGame.Views.Controls"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:local1="clr-namespace:PokemonGame.Views.UserControls"
    Title="MoveSummaryPage"
    Width="600"
    Height="400"
    Background="White">

    <Page.Resources>
        <conv:PokemonIdToImageConverter x:Key="PokemonIdToImage" />
        <conv:TypeToImageConverter x:Key="TypeToImage" />
        <conv:CategoryToImageConverter x:Key="CategoryToImageConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*" />
            <RowDefinition Height="200*" />
            <RowDefinition Height="150*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  Page Name  -->
        <TextBlock
            Margin="10"
            VerticalAlignment="Center"
            Text="{Binding PageName}" />

        <controls:BoardBackground Grid.Row="1" BackgroundType="White">
            <StackPanel>

                <!--  Level + Pokemon Name row  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LV" />
                    <TextBlock Margin="0,0,25,0" Text="{Binding Level}" />
                    <TextBlock Text="{Binding PokemonName}" />
                </StackPanel>

                <!--  Condition / Sprite / Pokeball grid  -->
                <Grid Height="125">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!--  Condition (e.g. SLP, PSN)  -->
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Text="{Binding Condition}" />

                    <!--  Pokemon Sprite via converter  -->
                    <Image
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding PokemonId, Converter={StaticResource PokemonIdToImage}}" />

                    <!--  Pokeball icon  -->
                    <Image
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Source="{Binding PokeballImagePath}" />

                </Grid>
            </StackPanel>
        </controls:BoardBackground>

        <StackPanel
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="4">

            <!--  Move 1  -->
            <Border
                Margin="0,2"
                BorderBrush="#CC8800"
                BorderThickness="2"
                CornerRadius="4">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="2"
                        Source="{Binding Moves[0].TypeName, Converter={StaticResource TypeToImage}}"
                        Stretch="Uniform" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="6,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{Binding Moves[0].Name}" />
                        <TextBlock
                            FontSize="10"
                            Foreground="Gray"
                            Text="{Binding Moves[0].PPText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Move 2  -->
            <Border
                Margin="0,2"
                BorderBrush="#CC8800"
                BorderThickness="2"
                CornerRadius="4">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="2"
                        Source="{Binding Moves[1].TypeName, Converter={StaticResource TypeToImage}}"
                        Stretch="Uniform" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="6,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{Binding Moves[1].Name}" />
                        <TextBlock
                            FontSize="10"
                            Foreground="Gray"
                            Text="{Binding Moves[1].PPText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Move 3  -->
            <Border
                Margin="0,2"
                BorderBrush="#CC8800"
                BorderThickness="2"
                CornerRadius="4">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="2"
                        Source="{Binding Moves[2].TypeName, Converter={StaticResource TypeToImage}}"
                        Stretch="Uniform" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="6,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{Binding Moves[2].Name}" />
                        <TextBlock
                            FontSize="10"
                            Foreground="Gray"
                            Text="{Binding Moves[2].PPText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Move 4  -->
            <Border
                Margin="0,2"
                BorderBrush="#CC8800"
                BorderThickness="2"
                CornerRadius="4">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="2"
                        Source="{Binding Moves[3].TypeName, Converter={StaticResource TypeToImage}}"
                        Stretch="Uniform" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="6,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{Binding Moves[3].Name}" />
                        <TextBlock
                            FontSize="10"
                            Foreground="Gray"
                            Text="{Binding Moves[3].PPText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Cancel  -->
            <Button
                Margin="0,6,0,2"
                HorizontalAlignment="Stretch"
                Content="Cancel"
                FontSize="11" />


        </StackPanel>
        <Border
            Grid.Row="2"
            Grid.Column="0"
            Padding="6,4"
            Background="#1a2a1a"
            BorderBrush="#4a6a4a"
            BorderThickness="2">


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  POWER Label  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,2"
                    Padding="4,1"
                    Background="#2a4a2a"
                    BorderBrush="#6aaa6a"
                    BorderThickness="1">
                    <TextBlock
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="#88cc88"
                        Text="POWER" />
                </Border>

                <!--  POWER Value  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="2,0,0,2"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="90" />

                <!--  Move Category Icon (using CategoryToImageConverter)  -->
                <Image
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Width="22"
                    Height="22"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Source="{Binding MoveCategory, Converter={StaticResource CategoryToImageConverter}}" />

                <!--  ACCURACY Label  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,4,2"
                    Padding="4,1"
                    Background="#2a4a2a"
                    BorderBrush="#6aaa6a"
                    BorderThickness="1">
                    <TextBlock
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="#88cc88"
                        Text="ACCURACY" />
                </Border>

                <!--  ACCURACY Value  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="2,0,0,2"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="85" />

                <!--  Divider line  -->
                <Rectangle
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,2"
                    Fill="#4a6a4a" />

                <!--  EFFECT Label + Description  -->
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,2,0,0">

                    <Border
                        Margin="0,0,0,3"
                        Padding="4,1"
                        HorizontalAlignment="Left"
                        Background="#2a4a2a"
                        BorderBrush="#6aaa6a"
                        BorderThickness="1">
                        <TextBlock
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="#88cc88"
                            Text="EFFECT" />
                    </Border>

                    <TextBlock
                        FontSize="9"
                        Foreground="White"
                        LineHeight="14"
                        Text="The foe is slugged at maximum power. Can also be used to move boulders."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</Page>