<Page
    x:Class="PokemonGame.Views.Pages.Summery.MoveSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:local1="clr-namespace:PokemonGame.Views.UserControls"
    Title="MoveSummaryPage">

    <Page.Resources>
        <conv:TypeToColorConverter x:Key="TypeToColorConverter" />

        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,2">
                            <Border
                                x:Name="SelectionFrame"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="4">
                                <ContentPresenter />
                            </Border>
                            <Path
                                x:Name="Arrow"
                                Margin="-15,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Data="M 0,0 L 10,5 L 0,10 Z"
                                Fill="#E05030"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#E05030" />
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#4A90E2" />
                <GradientStop Offset="1.0" Color="#5AC8FA" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="25">
            <Border
                Width="140"
                Height="140"
                Padding="10"
                Background="#A0FFFFFF"
                CornerRadius="15">
                <Image RenderOptions.BitmapScalingMode="NearestNeighbor" Source="/Assets/Sprites/charizard_back.png" />
            </Border>

            <TextBlock
                Margin="0,15,0,0"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"
                Text="MOVE INFO" />
            <Separator Background="White" Opacity="0.5" />

            <Border
                Height="100"
                Margin="0,10"
                Padding="10"
                Background="#40000000"
                CornerRadius="5">
                <TextBlock
                    FontSize="14"
                    FontStyle="Italic"
                    Foreground="White"
                    Text="{Binding SelectedMove.Description}"
                    TextWrapping="Wrap" />
            </Border>

            <UniformGrid Columns="2" Rows="3">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="Yellow"
                    Text="TYPE" />
                <Border
                    Padding="12,2"
                    HorizontalAlignment="Left"
                    Background="{Binding SelectedMove.Type, Converter={StaticResource TypeToColorConverter}}"
                    CornerRadius="4">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding SelectedMove.Type}" />
                </Border>

                <TextBlock
                    Margin="0,10"
                    Foreground="Yellow"
                    Text="POWER" />
                <TextBlock
                    Margin="0,10"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding SelectedMove.Power}" />

                <TextBlock Foreground="Yellow" Text="ACCURACY" />
                <TextBlock
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding SelectedMove.Accuracy}" />
            </UniformGrid>
        </StackPanel>

        <Border
            Grid.Column="1"
            Margin="10,20"
            Background="#60000000"
            CornerRadius="10">
            <ListBox
                Padding="20,10"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding KnownMoves}"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                SelectedItem="{Binding SelectedMove}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local1:MoveSlotControl Width="240" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Page>