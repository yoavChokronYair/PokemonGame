<Page
    x:Class="PokemonGame.Views.Pages.Summery.MoveSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PokemonGame.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame.Views.Pages.Summery"
    xmlns:local1="clr-namespace:PokemonGame.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MoveSummaryPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:TypeToColorConverter x:Key="TypeToColorConverter" />

        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#4A90E2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="20">
            <Border
                Width="120"
                Height="120"
                Margin="10"
                Background="#80FFFFFF"
                CornerRadius="10">
                <Image RenderOptions.BitmapScalingMode="NearestNeighbor" Source="/Assets/Sprites/charizard_back.png" />
            </Border>

            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="White"
                Text="MOVE INFO" />
            <Separator Margin="0,5" Background="White" />

            <TextBlock
                Height="80"
                Margin="0,10"
                Foreground="White"
                Text="{Binding SelectedMove.Description}"
                TextWrapping="Wrap" />

            <UniformGrid Margin="0,20" Columns="2">
                <TextBlock Foreground="Yellow" Text="TYPE/" />
                <Border
                    Padding="10,2"
                    HorizontalAlignment="Left"
                    Background="{Binding SelectedMove.Type, Converter={StaticResource TypeToColorConverter}}"
                    CornerRadius="2">
                    <TextBlock Foreground="White" Text="{Binding SelectedMove.Type}" />
                </Border>

                <TextBlock
                    Margin="0,10,0,0"
                    Foreground="Yellow"
                    Text="POWER/" />
                <TextBlock
                    Margin="0,10,0,0"
                    Foreground="White"
                    Text="{Binding SelectedMove.Power}" />

                <TextBlock Foreground="Yellow" Text="ACCURACY/" />
                <TextBlock Foreground="White" Text="{Binding SelectedMove.Accuracy}" />
            </UniformGrid>
        </StackPanel>

        <ListBox
            Grid.Column="1"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding KnownMoves}"
            SelectedItem="{Binding SelectedMove}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local1:MoveSlotControl Margin="5" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>