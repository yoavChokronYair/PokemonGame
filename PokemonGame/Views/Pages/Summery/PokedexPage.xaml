<Page
    x:Class="PokemonGame.Views.Pages.Trainer.PokedexPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:PokemonGame.View.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PokedexPage"
    behaviors:FocusBehavior.FocusOnLoad="True"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    mc:Ignorable="d">
    <Viewbox Stretch="Uniform">
        <Grid Width="800" Height="450">
            <Image RenderOptions.BitmapScalingMode="NearestNeighbor" Source="/Assets/Images/Backgrounds/PokedexBackgroundImage.png" />
            <ScrollViewer
                x:Name="PokedexScrollViewer"
                Width="400"
                Height="350"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                behaviors:FocusBehavior.FocusOnLoad="True"
                behaviors:FocusBehavior.RegisterFocusTarget="True"
                behaviors:ScrollViewerOffsetBehavior.VerticalOffset="{Binding ScrollOffset}"
                Focusable="True"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Hidden">
                <ScrollViewer.InputBindings>
                    <KeyBinding Key="Up" Command="{Binding ScrollUpCommand}" />
                    <KeyBinding Key="Down" Command="{Binding ScrollDownCommand}" />
                    <KeyBinding Key="Esc" Command="{Binding ExitCommand}" />
                </ScrollViewer.InputBindings>
                <ItemsControl
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ItemsSource="{Binding PokemonEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="60"
                                Margin="4,2"
                                BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Background" Value="Wheat" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="No" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="{Binding Id, StringFormat='#{0:D3}'}" />
                                    <Image
                                        Width="40"
                                        Height="40"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Source="/Assets/Images/PokeballCaught.png" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Viewbox>
</Page>