<Page
    x:Class="PokemonGameModel.Views.Pages.NewGameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PokemonGameModel.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGameModel.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NewGame"
    d:DesignHeight="600"
    d:DesignWidth="900"
    Background="#4a5194"
    mc:Ignorable="d">

    <Grid ShowGridLines="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:BoardBackground
                Width="600"
                Height="300"
                HorizontalAlignment="Center"
                Opacity="0.75" />
            <controls:BoardBackground
                Width="600"
                Height="100"
                BorderThickness="0">
                <Label Content="NEW GAME" Foreground="Blue" />
            </controls:BoardBackground>
        </StackPanel>
    </Grid>
</Page>
