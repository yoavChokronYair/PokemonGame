<Window
    x:Class="PokemonGame.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Map="clr-namespace:PokemonGame.ViewModels.Map;assembly=PokemonGame.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame"
    xmlns:local1="clr-namespace:PokemonGame.Views"
    xmlns:local2="clr-namespace:PokemonGame.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PokemonGame.ViewModels;assembly=PokemonGame.ViewModels"
    xmlns:vm1="clr-namespace:PokemonGame.ViewModels.BattleMenu;assembly=PokemonGame.ViewModels"
    Title="MainWindow"
    Width="900"
    Height="600"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    KeyUp="Window_KeyUp"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <Grid ShowGridLines="False">

        <Grid.Resources>
            <DataTemplate DataType="{x:Type vm:WildPokemonBattleViewModel}">
                <local2:Backpack />
            </DataTemplate>
            <DataTemplate DataType="{x:Type Map:MapViewModel}">
                <local2:MapViewPage />
            </DataTemplate>
        </Grid.Resources>
        <Frame
            x:Name="MainFrame"
            Grid.Row="5"
            Grid.ColumnSpan="2"
            NavigationUIVisibility="Hidden" />
    </Grid>
</Window>