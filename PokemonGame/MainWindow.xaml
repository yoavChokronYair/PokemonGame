<Window
    x:Class="PokemonGame.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PokemonGame"
    xmlns:local1="clr-namespace:PokemonGame.Views"
    xmlns:local2="clr-namespace:PokemonGame.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PokemonGame.ViewModel"
    xmlns:vm1="clr-namespace:PokemonGame.ViewModel.BattleMenu"
    Title="MainWindow"
    Width="900"
    Height="600"
    KeyDown="Window_KeyDown"
    KeyUp="Window_KeyUp"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <Grid ShowGridLines="False">


        <Frame
            x:Name="MainFrame"
            Grid.Row="1"
            Grid.Column="0" />
    </Grid>
</Window>