<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PokemonGame.Views.Controls;assembly=PokemonGame">

    <Style TargetType="{x:Type local:BoardBackground}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BoardBackground}">
                    <Grid
                        Background="Transparent"
                        ShowGridLines="False"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>

                        <!--  Top Left Corner  -->
                        <Image Grid.Row="0" Grid.Column="0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/White/TopLeft.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Blue}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Blue/TopLeft.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Red}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Red/TopLeft.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!--  Top Middle  -->
                        <Image
                            Grid.Row="0"
                            Grid.Column="1"
                            Stretch="Fill">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/White/TopMiddle.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Blue}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Blue/TopMiddle.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Red}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Red/TopMiddle.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!--  Top Right Corner  -->
                        <Image Grid.Row="0" Grid.Column="2">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/White/TopRight.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Blue}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Blue/TopRight.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Red}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Red/TopRight.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!--  Middle Left  -->
                        <Image
                            Grid.Row="1"
                            Grid.Column="0"
                            Stretch="Fill">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/White/MiddleLeft.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Blue}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Blue/MiddleLeft.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Red}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Red/MiddleLeft.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!--  Center  -->
                        <Image
                            Grid.Row="1"
                            Grid.Column="1"
                            Stretch="Fill">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/White/Middle.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Blue}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Blue/Middle.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Red}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Red/Middle.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!--  Middle Right  -->
                        <Image
                            Grid.Row="1"
                            Grid.Column="2"
                            Stretch="Fill">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/White/MiddleRight.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Blue}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Blue/MiddleRight.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Red}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Red/MiddleRight.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!--  Bottom Left Corner  -->
                        <Image Grid.Row="2" Grid.Column="0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/White/BottomLeft.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Blue}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Blue/BottomLeft.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Red}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Red/BottomLeft.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!--  Bottom Middle  -->
                        <Image
                            Grid.Row="2"
                            Grid.Column="1"
                            Stretch="Fill">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/White/BottomMiddle.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Blue}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Blue/BottomMiddle.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Red}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Red/BottomMiddle.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!--  Bottom Right Corner  -->
                        <Image Grid.Row="2" Grid.Column="2">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/White/BottomRight.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Blue}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Blue/BottomRight.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BackgroundType, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Static local:BackgroundType.Red}">
                                            <Setter Property="Source" Value="pack://application:,,,/PokemonGame;component/Assets/Images/Backgrounds/Red/BottomRight.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!--  ContentPresenter for inner content  -->
                        <ContentPresenter Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:BindablePasswordBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BindablePasswordBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Masked Password  -->
                        <PasswordBox
                            x:Name="PART_PasswordBox"
                            Grid.Column="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />

                        <!--  Visible Password  -->
                        <TextBox
                            x:Name="PART_VisiblePasswordTextBox"
                            Grid.Column="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="Collapsed" />

                        <!--  Eye Button  -->
                        <ToggleButton
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsChecked="{Binding IsPasswordVisible, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Content" Value="👁" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="🙈" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPasswordVisible" Value="True">
                            <Setter TargetName="PART_PasswordBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_VisiblePasswordTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>